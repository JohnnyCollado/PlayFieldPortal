    <!-- Error codes -->
    <string name="dom_error_ln_1001_title">Do tej platformy nie przypisano emulatora</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal nie wie, która aplikacja ma uruchamiać gry tej platformy.</string>
    <string name="dom_error_ln_1001_action">Wybierz emulator dla tej platformy w Ustawienia › Przypisanie emulatorów.</string>
    <string name="dom_error_ln_1002_title">Wybrany rdzeń RetroArch nie jest zainstalowany</string>
    <string name="dom_error_ln_1002_why">RetroArch otrzymał polecenie załadowania rdzenia, którego nie ma na tym urządzeniu.</string>
    <string name="dom_error_ln_1002_action">Zainstaluj rdzeń przez Online Updater w RetroArch lub wybierz inny rdzeń w Przypisaniu emulatorów.</string>
    <string name="dom_error_ln_2001_title">Brak pliku gry lub nie można go odczytać</string>
    <string name="dom_error_ln_2001_why">Plik mógł zostać przeniesiony, zmieniony lub usunięty albo wyjęto kartę SD, na której się znajdował.</string>
    <string name="dom_error_ln_2001_action">Sprawdź, czy plik nadal istnieje, a potem przeskanuj ponownie jego kartę pamięci.</string>
    <string name="dom_error_ln_4001_title">Nie znaleziono emulatora</string>
    <string name="dom_error_ln_4001_why">Emulator przypisany do tej gry nie jest zainstalowany lub Android nie znalazł ekranu, który otwiera PlayFieldPortal.</string>
    <string name="dom_error_ln_4001_action">Zainstaluj emulator lub wybierz inny w Ustawienia › Przypisanie emulatorów.</string>
    <string name="dom_error_ln_4002_title">Android nie pozwolił otworzyć emulatora</string>
    <string name="dom_error_ln_4002_why">Android odmówił PlayFieldPortal uprawnień do uruchomienia tego emulatora.</string>
    <string name="dom_error_ln_4002_action">Otwórz emulator raz samodzielnie, a potem spróbuj ponownie. Jeśli to się powtarza, zaktualizuj emulator.</string>
    <string name="dom_error_ln_4003_title">Emulator nie pojawił się na pierwszym planie</string>
    <string name="dom_error_ln_4003_why">Emulator najprawdopodobniej zamknął się podczas uruchamiania lub Android zatrzymał go przed załadowaniem gry.</string>
    <string name="dom_error_ln_4003_action">Otwórz emulator raz samodzielnie, aby sprawdzić, czy się uruchamia, i zaktualizuj go, jeśli jest nowsza wersja. Jeśli to się powtarza, wybierz inny emulator w Ustawienia › Przypisanie emulatorów.</string>
    <string name="dom_error_ln_9001_title">Nie można otworzyć emulatora</string>
    <string name="dom_error_ln_9001_why">Podczas uruchamiania emulatora wystąpił nieoczekiwany błąd.</string>
    <string name="dom_error_ln_9001_action">Spróbuj ponownie. Jeśli to się powtarza, skopiuj szczegóły i zgłoś problem.</string>
    <string name="dom_error_sc_1001_title">Nie ustawiono folderu dla tej karty pamięci</string>
    <string name="dom_error_sc_1001_why">Ta karta pamięci nie ma jeszcze miejsca do skanowania.</string>
    <string name="dom_error_sc_1001_action">Wybierz folder w Opcjach karty pamięci, a potem go przeskanuj.</string>
    <string name="dom_error_sc_1002_title">Skanowanie już trwa</string>
    <string name="dom_error_sc_1002_why">Ta karta pamięci była już skanowana, więc drugie skanowanie pominięto.</string>
    <string name="dom_error_sc_1002_action">Poczekaj na zakończenie trwającego skanowania. Wynik pojawi się tutaj po jego zakończeniu.</string>
    <string name="dom_error_sc_2001_title">Utracono dostęp do folderu</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal utracił uprawnienia do odczytu tego folderu.</string>
    <string name="dom_error_sc_2001_action">Wybierz folder ponownie w Opcjach karty pamięci, aby przyznać dostęp, a potem go przeskanuj.</string>
    <string name="dom_error_sc_2002_title">Folder już nie istnieje</string>
    <string name="dom_error_sc_2002_why">Folder został przeniesiony lub usunięty. Jeśli był na karcie SD, karta mogła zostać wyjęta.</string>
    <string name="dom_error_sc_2002_action">Włóż kartę SD i przeskanuj ponownie lub wybierz nowy folder w Opcjach karty pamięci.</string>
    <string name="dom_error_sc_2003_title">Nieznany folder systemu</string>
    <string name="dom_error_sc_2003_why">Ten folder w głównym folderze ROM-ów nie odpowiada żadnemu systemowi znanemu PlayFieldPortal.</string>
    <string name="dom_error_sc_2003_action">Zmień nazwę folderu na nazwę obsługiwanego systemu lub przenieś do niego gry.</string>
    <string name="dom_error_sc_2004_title">Nie rozpoznano pliku</string>
    <string name="dom_error_sc_2004_why">Typ tego pliku nie jest używany przez gry tej platformy.</string>
    <string name="dom_error_sc_2004_action">Sprawdź, czy plik jest grą dla tej platformy. Archiwa i łatki są pomijane celowo.</string>
    <string name="dom_error_sc_9001_title">Skanowanie nieoczekiwanie się nie powiodło</string>
    <string name="dom_error_sc_9001_why">Podczas skanowania wystąpił nieoczekiwany błąd.</string>
    <string name="dom_error_sc_9001_action">Spróbuj przeskanować ponownie. Jeśli to się powtarza, skopiuj szczegóły i zgłoś problem.</string>
    <string name="dom_error_ar_1001_title">Folder grafik niedostępny</string>
    <string name="dom_error_ar_1001_why">PFP nie ma dostępu do folderu grafik, więc pobieranie nowych grafik jest wstrzymane.</string>
    <string name="dom_error_ar_1001_action">Połącz ponownie folder w Ustawienia › Grafiki.</string>
    <string name="dom_error_ar_2001_title">Nie można zapisać pliku grafiki</string>
    <string name="dom_error_ar_2001_why">Pamięć była pełna lub nie można było zapisać w folderze grafik.</string>
    <string name="dom_error_ar_2001_action">Zwolnij trochę miejsca i spróbuj ponownie.</string>
    <string name="dom_error_ar_2002_title">Nie można skopiować pliku</string>
    <string name="dom_error_ar_2002_why">Kopiowanie przerwało się w trakcie lub nie można było zapisać w miejscu docelowym.</string>
    <string name="dom_error_ar_2002_action">Sprawdź, czy w miejscu docelowym jest wolne miejsce, a potem uruchom ponownie.</string>
    <string name="dom_error_ar_2003_title">Nieznany folder systemu w imporcie</string>
    <string name="dom_error_ar_2003_why">Ten folder w imporcie nie odpowiada żadnemu systemowi znanemu PlayFieldPortal.</string>
    <string name="dom_error_ar_2003_action">Zmień nazwę folderu na nazwę obsługiwanego systemu i zaimportuj ponownie.</string>
    <string name="dom_error_ar_3001_title">Nie można połączyć się ze źródłem grafik</string>
    <string name="dom_error_ar_3001_why">Urządzenie jest offline lub źródło nie odpowiedziało.</string>
    <string name="dom_error_ar_3001_action">Sprawdź połączenie i spróbuj ponownie później.</string>
    <string name="dom_error_ar_3002_title">Źródło odrzuciło zapytanie</string>
    <string name="dom_error_ar_3002_why">Źródło ogranicza liczbę zapytań lub odrzuciło wymagane konto albo klucz.</string>
    <string name="dom_error_ar_3002_action">Odczekaj chwilę i spróbuj ponownie lub sprawdź konto źródła w Ustawieniach.</string>
    <string name="dom_error_ar_3003_title">Nie znaleziono dopasowania dla tej gry</string>
    <string name="dom_error_ar_3003_why">Źródło nie ma wpisu pasującego do tytułu tej gry.</string>
    <string name="dom_error_ar_3003_action">Sprawdź tytuł gry lub wybierz grafiki ręcznie w Artwork Studio.</string>
    <string name="dom_error_ar_9001_title">Pobieranie nieoczekiwanie się nie powiodło</string>
    <string name="dom_error_ar_9001_why">Podczas pobierania wystąpił nieoczekiwany błąd.</string>
    <string name="dom_error_ar_9001_action">Spróbuj ponownie. Jeśli to się powtarza, skopiuj szczegóły i zgłoś problem.</string>
    <string name="dom_error_ac_1001_title">Nie dopasowano zestawu osiągnięć do tej gry</string>
    <string name="dom_error_ac_1001_why">Żadna z połączonych usług nie ma osiągnięć dla gry o tym tytule.</string>
