    <!-- Error codes: title, why it happened, and what the user can do (docs/dev/notification-error-codes.md) -->
    <!-- Error code LN-1001: title of the error. -->
    <string name="dom_error_ln_1001_title">Chưa gán trình giả lập cho nền tảng này</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal không biết ứng dụng nào sẽ chạy trò chơi cho nền tảng này.</string>
    <string name="dom_error_ln_1001_action">Hãy chọn trình giả lập cho nền tảng này trong Cài đặt › Gán trình giả lập.</string>
    <string name="dom_error_ln_1002_title">Core RetroArch đã chọn chưa được cài</string>
    <string name="dom_error_ln_1002_why">RetroArch được yêu cầu tải một core không có trên thiết bị này.</string>
    <string name="dom_error_ln_1002_action">Hãy cài core từ Online Updater của RetroArch, hoặc chọn core khác trong Gán trình giả lập.</string>
    <string name="dom_error_ln_2001_title">Tệp trò chơi bị thiếu hoặc không đọc được</string>
    <string name="dom_error_ln_2001_why">Tệp có thể đã bị di chuyển, đổi tên hoặc xóa, hoặc thẻ SD chứa nó đã bị tháo ra.</string>
    <string name="dom_error_ln_2001_action">Hãy kiểm tra tệp vẫn còn đó, rồi quét lại Memory Card của nó.</string>
    <string name="dom_error_ln_4001_title">Không tìm thấy trình giả lập</string>
    <string name="dom_error_ln_4001_why">Trình giả lập được gán cho trò chơi này chưa được cài, hoặc Android không tìm thấy màn hình mà PlayFieldPortal mở.</string>
    <string name="dom_error_ln_4001_action">Hãy cài trình giả lập, hoặc chọn trình giả lập khác trong Cài đặt › Gán trình giả lập.</string>
    <string name="dom_error_ln_4002_title">Android không cho phép mở trình giả lập</string>
    <string name="dom_error_ln_4002_why">Android từ chối quyền để PlayFieldPortal khởi động trình giả lập này.</string>
    <string name="dom_error_ln_4002_action">Hãy tự mở trình giả lập một lần, rồi thử lại. Nếu vẫn xảy ra, hãy cập nhật trình giả lập.</string>
    <string name="dom_error_ln_4003_title">Trình giả lập không hiện lên phía trước</string>
    <string name="dom_error_ln_4003_why">Nhiều khả năng trình giả lập đã đóng ngay khi khởi động, hoặc Android đã dừng nó trước khi trò chơi kịp tải.</string>
    <string name="dom_error_ln_4003_action">Hãy tự mở trình giả lập một lần để kiểm tra nó khởi động được, và cập nhật nếu có phiên bản mới hơn. Nếu vẫn xảy ra, hãy chọn trình giả lập khác trong Cài đặt › Gán trình giả lập.</string>
    <string name="dom_error_ln_9001_title">Không thể mở trình giả lập</string>
    <string name="dom_error_ln_9001_why">Đã xảy ra sự cố không mong muốn khi khởi động trình giả lập.</string>
    <string name="dom_error_ln_9001_action">Hãy thử lại. Nếu vẫn xảy ra, hãy sao chép chi tiết và báo cáo.</string>
    <string name="dom_error_sc_1001_title">Chưa đặt thư mục cho Memory Card này</string>
    <string name="dom_error_sc_1001_why">Memory Card này chưa có nơi nào để quét.</string>
    <string name="dom_error_sc_1001_action">Hãy chọn thư mục trong Tùy chọn của Memory Card, rồi quét.</string>
    <string name="dom_error_sc_1002_title">Đang có lượt quét chạy</string>
    <string name="dom_error_sc_1002_why">Memory Card này đang được quét, nên lượt quét thứ hai đã bị bỏ qua.</string>
    <string name="dom_error_sc_1002_action">Hãy chờ lượt quét hiện tại hoàn tất. Kết quả sẽ hiện ở đây khi xong.</string>
    <string name="dom_error_sc_2001_title">Đã mất quyền truy cập thư mục</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal đã mất quyền đọc thư mục này.</string>
    <string name="dom_error_sc_2001_action">Hãy chọn lại thư mục trong Tùy chọn của Memory Card để cấp quyền, rồi quét.</string>
    <string name="dom_error_sc_2002_title">Thư mục không còn tồn tại</string>
    <string name="dom_error_sc_2002_why">Thư mục đã bị di chuyển hoặc xóa. Nếu nó nằm trên thẻ SD, có thể thẻ đã bị tháo ra.</string>
    <string name="dom_error_sc_2002_action">Hãy lắp thẻ SD và quét lại, hoặc chọn thư mục mới trong Tùy chọn của Memory Card.</string>
    <string name="dom_error_sc_2003_title">Thư mục hệ máy không xác định</string>
    <string name="dom_error_sc_2003_why">Thư mục này trong thư mục ROM chính không khớp với hệ máy nào mà PlayFieldPortal biết.</string>
    <string name="dom_error_sc_2003_action">Hãy đổi tên thư mục theo tên hệ máy được hỗ trợ, hoặc chuyển trò chơi của nó vào một thư mục như vậy.</string>
    <string name="dom_error_sc_2004_title">Không nhận dạng được tệp</string>
    <string name="dom_error_sc_2004_why">Loại tệp này không phải loại mà trò chơi của nền tảng này dùng.</string>
    <string name="dom_error_sc_2004_action">Hãy kiểm tra tệp có phải trò chơi cho nền tảng này không. Tệp nén và bản vá được cố ý bỏ qua.</string>
    <string name="dom_error_sc_9001_title">Quét thất bại ngoài dự kiến</string>
    <string name="dom_error_sc_9001_why">Đã xảy ra sự cố không mong muốn khi quét.</string>
    <string name="dom_error_sc_9001_action">Hãy quét lại. Nếu vẫn xảy ra, hãy sao chép chi tiết và báo cáo.</string>
    <string name="dom_error_ar_1001_title">Thư mục ảnh minh họa không khả dụng</string>
    <string name="dom_error_ar_1001_why">PFP không truy cập được thư mục ảnh minh họa, nên việc tải ảnh mới đã tạm dừng.</string>
