    <!-- Error codes: title, why it happened, and what the user can do (docs/dev/notification-error-codes.md) -->
    <!-- Error code LN-1001: title of the error. -->
    <string name="dom_error_ln_1001_title">No emulator is assigned to this platform</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_1001_why">PlayFieldPortal doesn\'t know which app should run games for this platform.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1001_action">Pick an emulator for this platform in Settings › Emulator Assignment.</string>
    <!-- Error code LN-1002: title of the error. -->
    <string name="dom_error_ln_1002_title">The selected RetroArch core isn\'t installed</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_1002_why">RetroArch was asked to load a core that isn\'t on this device.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1002_action">Install the core from RetroArch\'s Online Updater, or choose another core in Emulator Assignment.</string>
    <!-- Error code LN-2001: title of the error. -->
    <string name="dom_error_ln_2001_title">The game file is missing or unreadable</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_2001_why">The file may have been moved, renamed or deleted, or the SD card holding it was removed.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_2001_action">Check the file is still there, then rescan its Memory Card.</string>
    <!-- Error code LN-4001: title of the error. -->
    <string name="dom_error_ln_4001_title">The emulator wasn\'t found</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_4001_why">The emulator assigned to this game isn\'t installed, or Android couldn\'t find the screen PlayFieldPortal opens.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4001_action">Install the emulator, or choose another one in Settings › Emulator Assignment.</string>
    <!-- Error code LN-4002: title of the error. -->
    <string name="dom_error_ln_4002_title">Android didn\'t allow the emulator to open</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_4002_why">Android refused permission for PlayFieldPortal to start this emulator.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4002_action">Open the emulator on its own once, then try again. If it keeps happening, update the emulator.</string>
    <!-- Error code LN-4003: title of the error. -->
    <string name="dom_error_ln_4003_title">The emulator never came to the front</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_4003_why">The emulator most likely closed as it started, or Android stopped it before the game could load.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4003_action">Open the emulator on its own once to check it starts, and update it if a newer version is available. If it keeps happening, choose another emulator in Settings › Emulator Assignment.</string>
    <!-- Error code LN-9001: title of the error. -->
    <string name="dom_error_ln_9001_title">The emulator couldn\'t be opened</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_9001_why">Something unexpected went wrong while starting the emulator.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_9001_action">Try again. If it keeps happening, copy the details and report it.</string>
    <!-- Error code SC-1001: title of the error. -->
    <string name="dom_error_sc_1001_title">No folder is set for this Memory Card</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_1001_why">This Memory Card has nowhere to scan yet.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1001_action">Choose a folder from the Memory Card\'s Options, then scan it.</string>
    <!-- Error code SC-1002: title of the error. -->
    <string name="dom_error_sc_1002_title">A scan is already running</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_1002_why">This Memory Card was already being scanned, so the second scan was skipped.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1002_action">Wait for the running scan to finish. Its result appears here when it\'s done.</string>
    <!-- Error code SC-2001: title of the error. -->
    <string name="dom_error_sc_2001_title">Folder access was lost</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_2001_why">PlayFieldPortal lost permission to read this folder.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2001_action">Choose the folder again from the Memory Card\'s Options so access is granted, then scan it.</string>
    <!-- Error code SC-2002: title of the error. -->
    <string name="dom_error_sc_2002_title">The folder no longer exists</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_2002_why">The folder was moved or deleted. If it\'s on an SD card, the card may have been removed.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2002_action">Insert the SD card and scan again, or choose a new folder from the Memory Card\'s Options.</string>
    <!-- Error code SC-2003: title of the error. -->
    <string name="dom_error_sc_2003_title">Unknown system folder</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_2003_why">This folder inside the main ROM folder doesn\'t match a system PlayFieldPortal knows.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2003_action">Rename the folder to a supported system name, or move its games into one.</string>
    <!-- Error code SC-2004: title of the error. -->
    <string name="dom_error_sc_2004_title">File not recognised</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_2004_why">This file\'s type isn\'t one this platform\'s games use.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2004_action">Check the file is a game for this platform. Archives and patches are skipped on purpose.</string>
    <!-- Error code SC-9001: title of the error. -->
    <string name="dom_error_sc_9001_title">The scan failed unexpectedly</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_9001_why">Something unexpected went wrong during the scan.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_9001_action">Try the scan again. If it keeps happening, copy the details and report it.</string>
    <!-- Error code AR-1001: title of the error. -->
    <string name="dom_error_ar_1001_title">Artwork folder unavailable</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_1001_why">PFP can\'t reach the artwork folder, so new artwork is paused.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_1001_action">Relink the folder in Settings › Artwork.</string>
    <!-- Error code AR-2001: title of the error. -->
    <string name="dom_error_ar_2001_title">The artwork file couldn\'t be saved</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_2001_why">Storage was full, or the artwork folder couldn\'t be written to.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2001_action">Free up some space and try again.</string>
    <!-- Error code AR-2002: title of the error. -->
    <string name="dom_error_ar_2002_title">A file couldn\'t be copied</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_2002_why">The copy failed partway, or the destination couldn\'t be written to.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2002_action">Check there\'s free space at the destination, then run it again.</string>
    <!-- Error code AR-2003: title of the error. -->
    <string name="dom_error_ar_2003_title">Unknown system folder in the import</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_2003_why">This folder in the import doesn\'t match a system PlayFieldPortal knows.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2003_action">Rename the folder to a supported system name and import again.</string>
    <!-- Error code AR-3001: title of the error. -->
    <string name="dom_error_ar_3001_title">The artwork source couldn\'t be reached</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_3001_why">The device is offline, or the source didn\'t answer.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3001_action">Check the connection and try again later.</string>
    <!-- Error code AR-3002: title of the error. -->
    <string name="dom_error_ar_3002_title">The source rejected the request</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_3002_why">The source is limiting requests, or the account or key it needs was refused.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3002_action">Wait a while and try again, or check the source\'s account in Settings.</string>
    <!-- Error code AR-3003: title of the error. -->
    <string name="dom_error_ar_3003_title">No match was found for this game</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_3003_why">The source has no entry that matches this game\'s title.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3003_action">Check the game\'s title, or choose artwork by hand in the Artwork Studio.</string>
    <!-- Error code AR-9001: title of the error. -->
    <string name="dom_error_ar_9001_title">The fetch failed unexpectedly</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_9001_why">Something unexpected went wrong while fetching.</string>
    <!-- What the user can do about it. -->
