    <!-- Error codes: title, why it happened, and what the user can do (docs/dev/notification-error-codes.md) -->
    <string name="dom_error_ln_1001_title">這個平台沒有指派模擬器</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal 不知道該用哪個應用程式執行這個平台的遊戲。</string>
    <string name="dom_error_ln_1001_action">請在「設定 › 模擬器指派」中為這個平台選擇模擬器。</string>
    <string name="dom_error_ln_1002_title">未安裝所選的 RetroArch 核心</string>
    <string name="dom_error_ln_1002_why">RetroArch 被要求載入這部裝置上沒有的核心。</string>
    <string name="dom_error_ln_1002_action">請從 RetroArch 的線上更新程式安裝核心，或在「模擬器指派」中選擇其他核心。</string>
    <string name="dom_error_ln_2001_title">遊戲檔案遺失或無法讀取</string>
    <string name="dom_error_ln_2001_why">檔案可能已被移動、重新命名或刪除，或存放它的 SD 卡已被取出。</string>
    <string name="dom_error_ln_2001_action">請確認檔案仍在原處，然後重新掃描其記憶卡。</string>
    <string name="dom_error_ln_4001_title">找不到模擬器</string>
    <string name="dom_error_ln_4001_why">指派給這款遊戲的模擬器未安裝，或 Android 找不到 PlayFieldPortal 要開啟的畫面。</string>
    <string name="dom_error_ln_4001_action">請安裝模擬器，或在「設定 › 模擬器指派」中選擇其他模擬器。</string>
    <string name="dom_error_ln_4002_title">Android 不允許開啟模擬器</string>
    <string name="dom_error_ln_4002_why">Android 拒絕讓 PlayFieldPortal 啟動這個模擬器。</string>
    <string name="dom_error_ln_4002_action">請先單獨開啟模擬器一次，然後再試一次。如果問題持續發生，請更新模擬器。</string>
    <string name="dom_error_ln_4003_title">模擬器一直沒有切換到前景</string>
    <string name="dom_error_ln_4003_why">模擬器很可能在啟動時就關閉了，或 Android 在遊戲載入前就將它停止。</string>
    <string name="dom_error_ln_4003_action">請單獨開啟模擬器一次，確認它能啟動；如有新版本，請更新。如果問題持續發生，請在「設定 › 模擬器指派」中選擇其他模擬器。</string>
    <string name="dom_error_ln_9001_title">無法開啟模擬器</string>
    <string name="dom_error_ln_9001_why">啟動模擬器時發生未預期的問題。</string>
    <string name="dom_error_ln_9001_action">請再試一次。如果問題持續發生，請複製詳細資料並回報。</string>
    <string name="dom_error_sc_1001_title">這張記憶卡未設定資料夾</string>
    <string name="dom_error_sc_1001_why">這張記憶卡還沒有可掃描的位置。</string>
    <string name="dom_error_sc_1001_action">請從記憶卡的選項中選擇資料夾，然後進行掃描。</string>
    <string name="dom_error_sc_1002_title">已有掃描正在進行</string>
    <string name="dom_error_sc_1002_why">這張記憶卡已在掃描中，因此略過了第二次掃描。</string>
    <string name="dom_error_sc_1002_action">請等待目前的掃描完成。完成後結果會顯示在這裡。</string>
    <string name="dom_error_sc_2001_title">已失去資料夾存取權</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal 已失去讀取這個資料夾的權限。</string>
    <string name="dom_error_sc_2001_action">請從記憶卡的選項中重新選擇資料夾以授予存取權，然後進行掃描。</string>
    <string name="dom_error_sc_2002_title">資料夾已不存在</string>
    <string name="dom_error_sc_2002_why">資料夾已被移動或刪除。如果它位於 SD 卡上，該卡可能已被取出。</string>
    <string name="dom_error_sc_2002_action">請插入 SD 卡後再次掃描，或從記憶卡的選項中選擇新的資料夾。</string>
    <string name="dom_error_sc_2003_title">不明的系統資料夾</string>
    <string name="dom_error_sc_2003_why">主要 ROM 資料夾中的這個資料夾不符合 PlayFieldPortal 已知的任何系統。</string>
    <string name="dom_error_sc_2003_action">請將資料夾重新命名為支援的系統名稱，或將其中的遊戲移至支援的資料夾。</string>
    <string name="dom_error_sc_2004_title">無法辨識的檔案</string>
    <string name="dom_error_sc_2004_why">這個檔案的類型不是這個平台的遊戲所使用的類型。</string>
    <string name="dom_error_sc_2004_action">請確認檔案是這個平台的遊戲。封存檔和修補檔會被刻意略過。</string>
    <string name="dom_error_sc_9001_title">掃描意外失敗</string>
    <string name="dom_error_sc_9001_why">掃描時發生未預期的問題。</string>
    <string name="dom_error_sc_9001_action">請再掃描一次。如果問題持續發生，請複製詳細資料並回報。</string>
    <string name="dom_error_ar_1001_title">無法使用圖片資料夾</string>
    <string name="dom_error_ar_1001_why">PFP 無法存取圖片資料夾，因此新圖片已暫停。</string>
    <string name="dom_error_ar_1001_action">請在「設定 › 圖片」中重新連結資料夾。</string>
    <string name="dom_error_ar_2001_title">無法儲存圖片檔案</string>
    <string name="dom_error_ar_2001_why">儲存空間已滿，或無法寫入圖片資料夾。</string>
    <string name="dom_error_ar_2001_action">請釋出一些空間後再試一次。</string>
    <string name="dom_error_ar_2002_title">無法複製檔案</string>
    <string name="dom_error_ar_2002_why">複製中途失敗，或無法寫入目標位置。</string>
    <string name="dom_error_ar_2002_action">請確認目標位置有足夠的可用空間，然後再執行一次。</string>
    <string name="dom_error_ar_2003_title">匯入內容中有不明的系統資料夾</string>
    <string name="dom_error_ar_2003_why">匯入內容中的這個資料夾不符合 PlayFieldPortal 已知的任何系統。</string>
    <string name="dom_error_ar_2003_action">請將資料夾重新命名為支援的系統名稱，然後重新匯入。</string>
    <string name="dom_error_ar_3001_title">無法連線至圖片來源</string>
    <string name="dom_error_ar_3001_why">裝置處於離線狀態，或來源沒有回應。</string>
    <string name="dom_error_ar_3001_action">請檢查連線，稍後再試一次。</string>
    <string name="dom_error_ar_3002_title">來源拒絕了請求</string>
    <string name="dom_error_ar_3002_why">來源正在限制請求，或其所需的帳戶或金鑰遭到拒絕。</string>
    <string name="dom_error_ar_3002_action">請稍候再試，或在「設定」中檢查該來源的帳戶。</string>
    <string name="dom_error_ar_3003_title">找不到這款遊戲的相符項目</string>
    <string name="dom_error_ar_3003_why">來源中沒有與這款遊戲標題相符的項目。</string>
    <string name="dom_error_ar_3003_action">請檢查遊戲標題，或在圖片工作室中手動選擇圖片。</string>
    <string name="dom_error_ar_9001_title">抓取意外失敗</string>
    <string name="dom_error_ar_9001_why">抓取時發生未預期的問題。</string>
    <string name="dom_error_ar_9001_action">請再試一次。如果問題持續發生，請複製詳細資料並回報。</string>
    <string name="dom_error_ac_1001_title">沒有與這款遊戲相符的成就組合</string>
