    <!-- Codis d'error: inici -->
    <string name="dom_error_ln_1001_title">No hi ha cap emulador assignat a aquesta plataforma</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal no sap quina aplicació ha d\'executar els jocs d\'aquesta plataforma.</string>
    <string name="dom_error_ln_1001_action">Tria un emulador per a aquesta plataforma a Configuració › Assignació d\'emuladors.</string>
    <string name="dom_error_ln_1002_title">El nucli de RetroArch seleccionat no està instal·lat</string>
    <string name="dom_error_ln_1002_why">S\'ha demanat a RetroArch que carregui un nucli que no és en aquest dispositiu.</string>
    <string name="dom_error_ln_1002_action">Instal·la el nucli des de l\'Online Updater de RetroArch o tria un altre nucli a Assignació d\'emuladors.</string>
    <string name="dom_error_ln_2001_title">Falta el fitxer del joc o no es pot llegir</string>
    <string name="dom_error_ln_2001_why">És possible que el fitxer s\'hagi mogut, canviat de nom o suprimit, o que s\'hagi tret la targeta SD que el conté.</string>
    <string name="dom_error_ln_2001_action">Comprova que el fitxer encara hi sigui i torna a escanejar la seva Memory Card.</string>
    <string name="dom_error_ln_4001_title">No s\'ha trobat l\'emulador</string>
    <string name="dom_error_ln_4001_why">L\'emulador assignat a aquest joc no està instal·lat, o Android no ha trobat la pantalla que obre PlayFieldPortal.</string>
    <string name="dom_error_ln_4001_action">Instal·la l\'emulador o tria\'n un altre a Configuració › Assignació d\'emuladors.</string>
    <string name="dom_error_ln_4002_title">Android no ha permès obrir l\'emulador</string>
    <string name="dom_error_ln_4002_why">Android ha denegat el permís perquè PlayFieldPortal iniciés aquest emulador.</string>
    <string name="dom_error_ln_4002_action">Obre l\'emulador pel seu compte una vegada i torna-ho a provar. Si continua passant, actualitza l\'emulador.</string>
    <string name="dom_error_ln_4003_title">L\'emulador no ha passat mai a primer pla</string>
    <string name="dom_error_ln_4003_why">El més probable és que l\'emulador s\'hagi tancat en iniciar-se, o que Android l\'hagi aturat abans que es pogués carregar el joc.</string>
    <string name="dom_error_ln_4003_action">Obre l\'emulador pel seu compte una vegada per comprovar que s\'inicia i actualitza\'l si hi ha una versió més nova. Si continua passant, tria un altre emulador a Configuració › Assignació d\'emuladors.</string>
    <string name="dom_error_ln_9001_title">No s\'ha pogut obrir l\'emulador</string>
    <string name="dom_error_ln_9001_why">Alguna cosa inesperada ha fallat en iniciar l\'emulador.</string>
    <string name="dom_error_ln_9001_action">Torna-ho a provar. Si continua passant, copia els detalls i informa\'n.</string>

    <!-- Codis d'error: escaneig -->
    <string name="dom_error_sc_1001_title">No hi ha cap carpeta definida per a aquesta Memory Card</string>
    <string name="dom_error_sc_1001_why">Aquesta Memory Card encara no té on escanejar.</string>
    <string name="dom_error_sc_1001_action">Tria una carpeta a les opcions de la Memory Card i escaneja-la.</string>
    <string name="dom_error_sc_1002_title">Ja hi ha un escaneig en curs</string>
    <string name="dom_error_sc_1002_why">Aquesta Memory Card ja s\'estava escanejant, així que s\'ha omès el segon escaneig.</string>
    <string name="dom_error_sc_1002_action">Espera que acabi l\'escaneig en curs. El resultat apareixerà aquí quan acabi.</string>
    <string name="dom_error_sc_2001_title">S\'ha perdut l\'accés a la carpeta</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal ha perdut el permís per llegir aquesta carpeta.</string>
    <string name="dom_error_sc_2001_action">Torna a triar la carpeta a les opcions de la Memory Card perquè se\'n concedeixi l\'accés i escaneja-la.</string>
    <string name="dom_error_sc_2002_title">La carpeta ja no existeix</string>
    <string name="dom_error_sc_2002_why">La carpeta s\'ha mogut o suprimit. Si és en una targeta SD, potser s\'ha tret la targeta.</string>
    <string name="dom_error_sc_2002_action">Insereix la targeta SD i torna a escanejar, o tria una carpeta nova a les opcions de la Memory Card.</string>
    <string name="dom_error_sc_2003_title">Carpeta de sistema desconeguda</string>
    <string name="dom_error_sc_2003_why">Aquesta carpeta dins de la carpeta de ROM principal no correspon a cap sistema que conegui PlayFieldPortal.</string>
    <string name="dom_error_sc_2003_action">Canvia el nom de la carpeta pel d\'un sistema compatible o mou-ne els jocs a una d\'aquestes carpetes.</string>
    <string name="dom_error_sc_2004_title">Fitxer no reconegut</string>
    <string name="dom_error_sc_2004_why">El tipus d\'aquest fitxer no és cap dels que fan servir els jocs d\'aquesta plataforma.</string>
    <string name="dom_error_sc_2004_action">Comprova que el fitxer sigui un joc d\'aquesta plataforma. Els arxius comprimits i els pedaços s\'ometen expressament.</string>
    <string name="dom_error_sc_9001_title">L\'escaneig ha fallat de manera inesperada</string>
    <string name="dom_error_sc_9001_why">Alguna cosa inesperada ha fallat durant l\'escaneig.</string>
    <string name="dom_error_sc_9001_action">Torna a provar l\'escaneig. Si continua passant, copia els detalls i informa\'n.</string>

    <!-- Codis d'error: imatges -->
    <string name="dom_error_ar_1001_title">La carpeta d\'imatges no està disponible</string>
    <string name="dom_error_ar_1001_why">PFP no pot accedir a la carpeta d\'imatges, així que les imatges noves estan en pausa.</string>
    <string name="dom_error_ar_1001_action">Torna a enllaçar la carpeta a Configuració › Imatges.</string>
    <string name="dom_error_ar_2001_title">No s\'ha pogut desar el fitxer d\'imatge</string>
    <string name="dom_error_ar_2001_why">L\'emmagatzematge era ple o no s\'ha pogut escriure a la carpeta d\'imatges.</string>
    <string name="dom_error_ar_2001_action">Allibera una mica d\'espai i torna-ho a provar.</string>
    <string name="dom_error_ar_2002_title">No s\'ha pogut copiar un fitxer</string>
    <string name="dom_error_ar_2002_why">La còpia ha fallat a mitges o no s\'ha pogut escriure a la destinació.</string>
    <string name="dom_error_ar_2002_action">Comprova que hi hagi espai lliure a la destinació i torna-ho a executar.</string>
    <string name="dom_error_ar_2003_title">Carpeta de sistema desconeguda a la importació</string>
    <string name="dom_error_ar_2003_why">Aquesta carpeta de la importació no correspon a cap sistema que conegui PlayFieldPortal.</string>
    <string name="dom_error_ar_2003_action">Canvia el nom de la carpeta pel d\'un sistema compatible i torna a importar.</string>
    <string name="dom_error_ar_3001_title">No s\'ha pogut connectar amb la font d\'imatges</string>
    <string name="dom_error_ar_3001_why">El dispositiu no té connexió o la font no ha respost.</string>
    <string name="dom_error_ar_3001_action">Comprova la connexió i torna-ho a provar més tard.</string>
    <string name="dom_error_ar_3002_title">La font ha rebutjat la sol·licitud</string>
    <string name="dom_error_ar_3002_why">La font està limitant les sol·licituds, o s\'ha rebutjat el compte o la clau que necessita.</string>
    <string name="dom_error_ar_3002_action">Espera una estona i torna-ho a provar, o comprova el compte de la font a Configuració.</string>
    <string name="dom_error_ar_3003_title">No s\'ha trobat cap coincidència per a aquest joc</string>
    <string name="dom_error_ar_3003_why">La font no té cap entrada que coincideixi amb el títol d\'aquest joc.</string>
    <string name="dom_error_ar_3003_action">Comprova el títol del joc o tria les imatges a mà a l\'Artwork Studio.</string>
    <string name="dom_error_ar_9001_title">L\'obtenció ha fallat de manera inesperada</string>
    <string name="dom_error_ar_9001_why">Alguna cosa inesperada ha fallat durant l\'obtenció.</string>
    <string name="dom_error_ar_9001_action">Torna-ho a provar. Si continua passant, copia els detalls i informa\'n.</string>

    <!-- Codis d'error: assoliments -->
    <string name="dom_error_ac_1001_title">Cap conjunt d\'assoliments no coincideix amb aquest joc</string>
    <string name="dom_error_ac_1001_why">Cap dels serveis connectats no té assoliments per a un joc amb aquest títol.</string>
    <string name="dom_error_ac_1001_action">Associa el joc a mà des de la seva pàgina d\'assoliments.</string>
    <string name="dom_error_ac_2001_title">No es pot llegir la carpeta d\'assoliments de Windows</string>
    <string name="dom_error_ac_2001_why">No s\'ha pogut obrir la carpeta triada per als assoliments locals d\'aquest joc.</string>
    <string name="dom_error_ac_2001_action">Torna a triar la carpeta del joc des de la seva pàgina d\'assoliments.</string>
    <string name="dom_error_ac_3001_title">El dispositiu no té connexió</string>
    <string name="dom_error_ac_3001_why">Els assoliments no es poden actualitzar sense connexió a Internet.</string>
    <string name="dom_error_ac_3001_action">Connecta\'t a Internet. L\'actualització es tornarà a executar sola.</string>
    <string name="dom_error_ac_3002_title">La sessió ha caducat</string>
    <string name="dom_error_ac_3002_why">El servei connectat ja no accepta la sessió de PlayFieldPortal.</string>
