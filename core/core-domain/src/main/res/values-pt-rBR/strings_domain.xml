    <!-- Error code LN-1001: title of the error. -->
    <string name="dom_error_ln_1001_title">Nenhum emulador atribuído a esta plataforma</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_1001_why">O PlayFieldPortal não sabe qual app deve rodar os jogos desta plataforma.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1001_action">Escolha um emulador para esta plataforma em Configurações › Atribuição de emuladores.</string>

    <!-- Error code LN-1002: title of the error. -->
    <string name="dom_error_ln_1002_title">O core do RetroArch selecionado não está instalado</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_1002_why">O RetroArch recebeu o pedido de carregar um core que não está neste dispositivo.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1002_action">Instale o core pelo Online Updater do RetroArch ou escolha outro core em Atribuição de emuladores.</string>

    <!-- Error code LN-2001: title of the error. -->
    <string name="dom_error_ln_2001_title">O arquivo do jogo está ausente ou ilegível</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_2001_why">O arquivo pode ter sido movido, renomeado ou excluído, ou o cartão SD que o contém foi removido.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_2001_action">Verifique se o arquivo ainda está lá e verifique o Memory Card dele de novo.</string>

    <!-- Error code LN-4001: title of the error. -->
    <string name="dom_error_ln_4001_title">O emulador não foi encontrado</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_4001_why">O emulador atribuído a este jogo não está instalado, ou o Android não encontrou a tela que o PlayFieldPortal abre.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4001_action">Instale o emulador ou escolha outro em Configurações › Atribuição de emuladores.</string>

    <!-- Error code LN-4002: title of the error. -->
    <string name="dom_error_ln_4002_title">O Android não permitiu abrir o emulador</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_4002_why">O Android negou permissão para o PlayFieldPortal iniciar este emulador.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4002_action">Abra o emulador sozinho uma vez e tente de novo. Se continuar acontecendo, atualize o emulador.</string>

    <!-- Error code LN-4003: title of the error. -->
    <string name="dom_error_ln_4003_title">O emulador não veio para o primeiro plano</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_4003_why">O emulador provavelmente fechou ao iniciar, ou o Android o encerrou antes que o jogo carregasse.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4003_action">Abra o emulador sozinho uma vez para ver se ele inicia e atualize-o se houver uma versão mais nova. Se continuar acontecendo, escolha outro emulador em Configurações › Atribuição de emuladores.</string>

    <!-- Error code LN-9001: title of the error. -->
    <string name="dom_error_ln_9001_title">Não foi possível abrir o emulador</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_9001_why">Algo inesperado deu errado ao iniciar o emulador.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_9001_action">Tente de novo. Se continuar acontecendo, copie os detalhes e informe o problema.</string>

    <!-- Error code SC-1001: title of the error. -->
    <string name="dom_error_sc_1001_title">Nenhuma pasta definida para este Memory Card</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_1001_why">Este Memory Card ainda não tem onde verificar.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1001_action">Escolha uma pasta nas Opções do Memory Card e verifique-a.</string>

    <!-- Error code SC-1002: title of the error. -->
    <string name="dom_error_sc_1002_title">Já há uma verificação em andamento</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_1002_why">Este Memory Card já estava sendo verificado, então a segunda verificação foi ignorada.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1002_action">Espere a verificação em andamento terminar. O resultado aparece aqui quando ela acabar.</string>

    <!-- Error code SC-2001: title of the error. -->
    <string name="dom_error_sc_2001_title">O acesso à pasta foi perdido</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2001_why">O PlayFieldPortal perdeu a permissão de ler esta pasta.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2001_action">Escolha a pasta de novo nas Opções do Memory Card para conceder o acesso e verifique-a.</string>

    <!-- Error code SC-2002: title of the error. -->
    <string name="dom_error_sc_2002_title">A pasta não existe mais</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2002_why">A pasta foi movida ou excluída. Se ela estiver em um cartão SD, o cartão pode ter sido removido.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2002_action">Insira o cartão SD e verifique de novo, ou escolha uma nova pasta nas Opções do Memory Card.</string>

    <!-- Error code SC-2003: title of the error. -->
    <string name="dom_error_sc_2003_title">Pasta de sistema desconhecida</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2003_why">Esta pasta dentro da pasta de ROMs principal não corresponde a um sistema que o PlayFieldPortal conhece.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2003_action">Renomeie a pasta com o nome de um sistema compatível ou mova os jogos dela para uma.</string>

    <!-- Error code SC-2004: title of the error. -->
    <string name="dom_error_sc_2004_title">Arquivo não reconhecido</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2004_why">O tipo deste arquivo não é um dos usados pelos jogos desta plataforma.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2004_action">Verifique se o arquivo é um jogo desta plataforma. Arquivos compactados e patches são ignorados de propósito.</string>

    <!-- Error code SC-9001: title of the error. -->
    <string name="dom_error_sc_9001_title">A verificação falhou inesperadamente</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_9001_why">Algo inesperado deu errado durante a verificação.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_9001_action">Tente verificar de novo. Se continuar acontecendo, copie os detalhes e informe o problema.</string>

    <!-- Error code AR-1001: title of the error. -->
    <string name="dom_error_ar_1001_title">Pasta de artes indisponível</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_1001_why">O PFP não consegue acessar a pasta de artes, então novas artes estão pausadas.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_1001_action">Vincule a pasta de novo em Configurações › Artes.</string>

    <!-- Error code AR-2001: title of the error. -->
    <string name="dom_error_ar_2001_title">Não foi possível salvar o arquivo de arte</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_2001_why">O armazenamento estava cheio ou não foi possível gravar na pasta de artes.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2001_action">Libere espaço e tente de novo.</string>

    <!-- Error code AR-2002: title of the error. -->
    <string name="dom_error_ar_2002_title">Não foi possível copiar um arquivo</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_2002_why">A cópia falhou no meio, ou não foi possível gravar no destino.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2002_action">Verifique se há espaço livre no destino e execute de novo.</string>

    <!-- Error code AR-2003: title of the error. -->
    <string name="dom_error_ar_2003_title">Pasta de sistema desconhecida na importação</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_2003_why">Esta pasta da importação não corresponde a um sistema que o PlayFieldPortal conhece.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2003_action">Renomeie a pasta com o nome de um sistema compatível e importe de novo.</string>

    <!-- Error code AR-3001: title of the error. -->
    <string name="dom_error_ar_3001_title">Não foi possível acessar a fonte de artes</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_3001_why">O dispositivo está off-line ou a fonte não respondeu.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3001_action">Verifique a conexão e tente de novo mais tarde.</string>

    <!-- Error code AR-3002: title of the error. -->
    <string name="dom_error_ar_3002_title">A fonte recusou a solicitação</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_3002_why">A fonte está limitando as solicitações, ou a conta ou chave necessária foi recusada.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3002_action">Espere um pouco e tente de novo, ou verifique a conta da fonte nas Configurações.</string>

    <!-- Error code AR-3003: title of the error. -->
    <string name="dom_error_ar_3003_title">Nenhuma correspondência encontrada para este jogo</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_3003_why">A fonte não tem nenhuma entrada que corresponda ao título deste jogo.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3003_action">Verifique o título do jogo ou escolha as artes manualmente no Artwork Studio.</string>

    <!-- Error code AR-9001: title of the error. -->
    <string name="dom_error_ar_9001_title">A busca falhou inesperadamente</string>

    <!-- Why the error happened. -->
