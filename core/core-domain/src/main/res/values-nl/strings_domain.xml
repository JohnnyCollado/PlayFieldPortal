    <!-- Error codes -->
    <string name="dom_error_ln_1001_title">Er is geen emulator aan dit platform toegewezen</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal weet niet welke app spellen voor dit platform moet uitvoeren.</string>
    <string name="dom_error_ln_1001_action">Kies een emulator voor dit platform in Instellingen › Emulatortoewijzing.</string>
    <string name="dom_error_ln_1002_title">De geselecteerde RetroArch-core is niet geïnstalleerd</string>
    <string name="dom_error_ln_1002_why">RetroArch moest een core laden die niet op dit apparaat staat.</string>
    <string name="dom_error_ln_1002_action">Installeer de core via de Online Updater van RetroArch, of kies een andere core in Emulatortoewijzing.</string>
    <string name="dom_error_ln_2001_title">Het spelbestand ontbreekt of is onleesbaar</string>
    <string name="dom_error_ln_2001_why">Het bestand is mogelijk verplaatst, hernoemd of verwijderd, of de SD-kaart waarop het stond is verwijderd.</string>
    <string name="dom_error_ln_2001_action">Controleer of het bestand er nog is en scan daarna de geheugenkaart opnieuw.</string>
    <string name="dom_error_ln_4001_title">De emulator is niet gevonden</string>
    <string name="dom_error_ln_4001_why">De emulator die aan dit spel is toegewezen, is niet geïnstalleerd, of Android kon het scherm dat PlayFieldPortal opent niet vinden.</string>
    <string name="dom_error_ln_4001_action">Installeer de emulator of kies een andere in Instellingen › Emulatortoewijzing.</string>
    <string name="dom_error_ln_4002_title">Android liet de emulator niet openen</string>
    <string name="dom_error_ln_4002_why">Android weigerde PlayFieldPortal toestemming om deze emulator te starten.</string>
    <string name="dom_error_ln_4002_action">Open de emulator één keer zelf en probeer het daarna opnieuw. Blijft het gebeuren, werk dan de emulator bij.</string>
    <string name="dom_error_ln_4003_title">De emulator is nooit naar voren gekomen</string>
    <string name="dom_error_ln_4003_why">De emulator is waarschijnlijk tijdens het starten gesloten, of Android heeft hem gestopt voordat het spel kon laden.</string>
    <string name="dom_error_ln_4003_action">Open de emulator één keer zelf om te controleren of hij start, en werk hem bij als er een nieuwere versie is. Blijft het gebeuren, kies dan een andere emulator in Instellingen › Emulatortoewijzing.</string>
    <string name="dom_error_ln_9001_title">De emulator kon niet worden geopend</string>
    <string name="dom_error_ln_9001_why">Er ging iets onverwachts mis bij het starten van de emulator.</string>
    <string name="dom_error_ln_9001_action">Probeer het opnieuw. Blijft het gebeuren, kopieer dan de details en meld het.</string>
    <string name="dom_error_sc_1001_title">Er is geen map ingesteld voor deze geheugenkaart</string>
    <string name="dom_error_sc_1001_why">Deze geheugenkaart heeft nog geen plek om te scannen.</string>
    <string name="dom_error_sc_1001_action">Kies een map via de opties van de geheugenkaart en scan die daarna.</string>
    <string name="dom_error_sc_1002_title">Er loopt al een scan</string>
    <string name="dom_error_sc_1002_why">Deze geheugenkaart werd al gescand, dus de tweede scan is overgeslagen.</string>
    <string name="dom_error_sc_1002_action">Wacht tot de lopende scan klaar is. Het resultaat verschijnt hier zodra hij klaar is.</string>
    <string name="dom_error_sc_2001_title">Toegang tot de map is verloren</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal heeft geen toestemming meer om deze map te lezen.</string>
    <string name="dom_error_sc_2001_action">Kies de map opnieuw via de opties van de geheugenkaart zodat er toegang wordt verleend, en scan hem daarna.</string>
    <string name="dom_error_sc_2002_title">De map bestaat niet meer</string>
    <string name="dom_error_sc_2002_why">De map is verplaatst of verwijderd. Staat hij op een SD-kaart, dan is de kaart misschien verwijderd.</string>
    <string name="dom_error_sc_2002_action">Plaats de SD-kaart en scan opnieuw, of kies een nieuwe map via de opties van de geheugenkaart.</string>
    <string name="dom_error_sc_2003_title">Onbekende systeemmap</string>
    <string name="dom_error_sc_2003_why">Deze map in de primaire ROM-map komt niet overeen met een systeem dat PlayFieldPortal kent.</string>
    <string name="dom_error_sc_2003_action">Hernoem de map naar een ondersteunde systeemnaam, of verplaats de spellen naar zo\'n map.</string>
    <string name="dom_error_sc_2004_title">Bestand niet herkend</string>
    <string name="dom_error_sc_2004_why">Het type van dit bestand wordt niet gebruikt door spellen voor dit platform.</string>
    <string name="dom_error_sc_2004_action">Controleer of het bestand een spel voor dit platform is. Archieven en patches worden bewust overgeslagen.</string>
    <string name="dom_error_sc_9001_title">De scan is onverwacht mislukt</string>
    <string name="dom_error_sc_9001_why">Er ging iets onverwachts mis tijdens het scannen.</string>
    <string name="dom_error_sc_9001_action">Probeer de scan opnieuw. Blijft het gebeuren, kopieer dan de details en meld het.</string>
    <string name="dom_error_ar_1001_title">Artworkmap niet beschikbaar</string>
    <string name="dom_error_ar_1001_why">PFP kan de artworkmap niet bereiken, dus nieuwe artwork is gepauzeerd.</string>
    <string name="dom_error_ar_1001_action">Koppel de map opnieuw in Instellingen › Artwork.</string>
    <string name="dom_error_ar_2001_title">Het artworkbestand kon niet worden opgeslagen</string>
    <string name="dom_error_ar_2001_why">De opslag was vol, of er kon niet naar de artworkmap worden geschreven.</string>
    <string name="dom_error_ar_2001_action">Maak wat ruimte vrij en probeer het opnieuw.</string>
    <string name="dom_error_ar_2002_title">Een bestand kon niet worden gekopieerd</string>
    <string name="dom_error_ar_2002_why">Het kopiëren is halverwege mislukt, of er kon niet naar de bestemming worden geschreven.</string>
    <string name="dom_error_ar_2002_action">Controleer of er vrije ruimte is op de bestemming en voer het daarna opnieuw uit.</string>
    <string name="dom_error_ar_2003_title">Onbekende systeemmap in de import</string>
    <string name="dom_error_ar_2003_why">Deze map in de import komt niet overeen met een systeem dat PlayFieldPortal kent.</string>
    <string name="dom_error_ar_2003_action">Hernoem de map naar een ondersteunde systeemnaam en importeer opnieuw.</string>
    <string name="dom_error_ar_3001_title">De artworkbron kon niet worden bereikt</string>
    <string name="dom_error_ar_3001_why">Het apparaat is offline, of de bron reageerde niet.</string>
    <string name="dom_error_ar_3001_action">Controleer de verbinding en probeer het later opnieuw.</string>
    <string name="dom_error_ar_3002_title">De bron heeft het verzoek geweigerd</string>
    <string name="dom_error_ar_3002_why">De bron beperkt het aantal verzoeken, of het benodigde account of de sleutel is geweigerd.</string>
    <string name="dom_error_ar_3002_action">Wacht even en probeer het opnieuw, of controleer het account van de bron in Instellingen.</string>
    <string name="dom_error_ar_3003_title">Geen overeenkomst gevonden voor dit spel</string>
    <string name="dom_error_ar_3003_why">De bron heeft geen vermelding die overeenkomt met de titel van dit spel.</string>
    <string name="dom_error_ar_3003_action">Controleer de titel van het spel, of kies zelf artwork in de Artwork Studio.</string>
    <string name="dom_error_ar_9001_title">Ophalen is onverwacht mislukt</string>
    <string name="dom_error_ar_9001_why">Er ging iets onverwachts mis tijdens het ophalen.</string>
    <string name="dom_error_ar_9001_action">Probeer het opnieuw. Blijft het gebeuren, kopieer dan de details en meld het.</string>
    <string name="dom_error_ac_1001_title">Geen prestatieset gevonden voor dit spel</string>
    <string name="dom_error_ac_1001_why">Geen van de verbonden diensten heeft prestaties voor een spel met deze titel.</string>
    <string name="dom_error_ac_1001_action">Koppel het spel handmatig via de prestatiepagina.</string>
    <string name="dom_error_ac_2001_title">De Windows-prestatiemap kan niet worden gelezen</string>
    <string name="dom_error_ac_2001_why">De map die voor de lokale prestaties van dit spel is gekozen, kon niet worden geopend.</string>
    <string name="dom_error_ac_2001_action">Kies de map van het spel opnieuw via de prestatiepagina.</string>
    <string name="dom_error_ac_3001_title">Het apparaat is offline</string>
    <string name="dom_error_ac_3001_why">Prestaties kunnen niet worden bijgewerkt zonder internetverbinding.</string>
    <string name="dom_error_ac_3001_action">Maak verbinding met internet. De update wordt vanzelf opnieuw uitgevoerd.</string>
    <string name="dom_error_ac_3002_title">Inloggen verlopen</string>
    <string name="dom_error_ac_3002_why">De verbonden dienst accepteert de aanmelding van PlayFieldPortal niet meer.</string>
    <string name="dom_error_ac_3002_action">Verbind de dienst opnieuw in Instellingen › Prestaties.</string>
    <string name="dom_error_ac_3003_title">Steam-speldetails zijn privé</string>
    <string name="dom_error_ac_3003_why">Steam deelt prestaties alleen als je speldetails openbaar zijn.</string>
    <string name="dom_error_ac_3003_action">Zet Speldetails op Openbaar in je Steam-privacyinstellingen en werk daarna opnieuw bij.</string>
    <string name="dom_error_ac_3004_title">Dit spel kon niet worden bijgewerkt</string>
    <string name="dom_error_ac_3004_why">De dienst reageerde niet voor dit spel, of gaf een fout terug.</string>
    <string name="dom_error_ac_3004_action">Probeer later opnieuw bij te werken.</string>
    <string name="dom_error_md_2001_title">De mediamap kan niet worden gelezen</string>
    <string name="dom_error_md_2001_why">PlayFieldPortal heeft geen toegang meer tot deze map, of hij bestaat niet meer.</string>
    <string name="dom_error_md_2001_action">Kies de map opnieuw in de media-instellingen en scan daarna.</string>
    <string name="dom_error_md_9001_title">De mediascan is onverwacht mislukt</string>
