    <!-- Error codes: title, why it happened, and what the user can do (docs/dev/notification-error-codes.md) -->
    <!-- Error code LN-1001: title of the error. -->
    <string name="dom_error_ln_1001_title">Овој платформи није додељен ниједан емулатор</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_1001_why">PlayFieldPortal не зна која апликација треба да покреће игре за ову платформу.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1001_action">Изаберите емулатор за ову платформу у Подешавања › Додела емулатора.</string>
    <!-- Error code LN-1002: title of the error. -->
    <string name="dom_error_ln_1002_title">Изабрано RetroArch језгро није инсталирано</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_1002_why">Од RetroArch-а је затражено да учита језгро које није на овом уређају.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1002_action">Инсталирајте језгро преко RetroArch Online Updater-а или изаберите друго језгро у Додели емулатора.</string>
    <!-- Error code LN-2001: title of the error. -->
    <string name="dom_error_ln_2001_title">Датотека игре недостаје или није читљива</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_2001_why">Датотека је можда премештена, преименована или избрисана, или је уклоњена SD картица на којој се налази.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_2001_action">Проверите да ли је датотека још увек ту, па поново скенирајте њену меморијску картицу.</string>
    <!-- Error code LN-4001: title of the error. -->
    <string name="dom_error_ln_4001_title">Емулатор није пронађен</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_4001_why">Емулатор додељен овој игри није инсталиран или Android није пронашао екран који PlayFieldPortal отвара.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4001_action">Инсталирајте емулатор или изаберите други у Подешавања › Додела емулатора.</string>
    <!-- Error code LN-4002: title of the error. -->
    <string name="dom_error_ln_4002_title">Android није дозволио отварање емулатора</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_4002_why">Android је одбио дозволу да PlayFieldPortal покрене овај емулатор.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4002_action">Једном отворите емулатор самостално, па покушајте поново. Ако се то понавља, ажурирајте емулатор.</string>
    <!-- Error code LN-4003: title of the error. -->
    <string name="dom_error_ln_4003_title">Емулатор није прешао у први план</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_4003_why">Емулатор се највероватније затворио при покретању или га је Android зауставио пре него што је игра учитана.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4003_action">Једном отворите емулатор самостално да проверите да ли се покреће и ажурирајте га ако постоји новија верзија. Ако се то понавља, изаберите други емулатор у Подешавања › Додела емулатора.</string>
    <!-- Error code LN-9001: title of the error. -->
    <string name="dom_error_ln_9001_title">Емулатор није могуће отворити</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ln_9001_why">Дошло је до неочекиване грешке при покретању емулатора.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ln_9001_action">Покушајте поново. Ако се то понавља, копирајте детаље и пријавите проблем.</string>
    <!-- Error code SC-1001: title of the error. -->
    <string name="dom_error_sc_1001_title">За ову меморијску картицу није подешена фасцикла</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_1001_why">Ова меморијска картица још нема шта да скенира.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1001_action">Изаберите фасциклу у опцијама меморијске картице, па је скенирајте.</string>
    <!-- Error code SC-1002: title of the error. -->
    <string name="dom_error_sc_1002_title">Скенирање је већ у току</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_1002_why">Ова меморијска картица се већ скенирала, па је друго скенирање прескочено.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1002_action">Сачекајте да се текуће скенирање заврши. Резултат ће се приказати овде када се заврши.</string>
    <!-- Error code SC-2001: title of the error. -->
    <string name="dom_error_sc_2001_title">Приступ фасцикли је изгубљен</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_2001_why">PlayFieldPortal је изгубио дозволу за читање ове фасцикле.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2001_action">Поново изаберите фасциклу у опцијама меморијске картице да бисте доделили приступ, па је скенирајте.</string>
    <!-- Error code SC-2002: title of the error. -->
    <string name="dom_error_sc_2002_title">Фасцикла више не постоји</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_2002_why">Фасцикла је премештена или избрисана. Ако је на SD картици, картица је можда уклоњена.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2002_action">Уметните SD картицу и поново скенирајте или изаберите нову фасциклу у опцијама меморијске картице.</string>
    <!-- Error code SC-2003: title of the error. -->
    <string name="dom_error_sc_2003_title">Непозната системска фасцикла</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_2003_why">Ова фасцикла у главној ROM фасцикли не одговара ниједном систему који PlayFieldPortal познаје.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2003_action">Преименујте фасциклу у назив подржаног система или преместите њене игре у такву фасциклу.</string>
    <!-- Error code SC-2004: title of the error. -->
    <string name="dom_error_sc_2004_title">Датотека није препозната</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_2004_why">Тип ове датотеке не користе игре за ову платформу.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2004_action">Проверите да ли је датотека игра за ову платформу. Архиве и закрпе се намерно прескачу.</string>
    <!-- Error code SC-9001: title of the error. -->
    <string name="dom_error_sc_9001_title">Скенирање је неочекивано пропало</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sc_9001_why">Дошло је до неочекиване грешке током скенирања.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sc_9001_action">Покушајте поново да скенирате. Ако се то понавља, копирајте детаље и пријавите проблем.</string>
    <!-- Error code AR-1001: title of the error. -->
    <string name="dom_error_ar_1001_title">Фасцикла за графику није доступна</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_1001_why">PFP не може да приступи фасцикли за графику, па је нова графика паузирана.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_1001_action">Поново повежите фасциклу у Подешавања › Графика.</string>
    <!-- Error code AR-2001: title of the error. -->
    <string name="dom_error_ar_2001_title">Датотеку графике није могуће сачувати</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_2001_why">Меморија је била пуна или није било могуће уписати у фасциклу за графику.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2001_action">Ослободите мало простора и покушајте поново.</string>
    <!-- Error code AR-2002: title of the error. -->
    <string name="dom_error_ar_2002_title">Датотеку није могуће копирати</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_2002_why">Копирање је прекинуто на пола или није било могуће уписати на одредиште.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2002_action">Проверите да ли на одредишту има слободног простора, па покрените поново.</string>
    <!-- Error code AR-2003: title of the error. -->
    <string name="dom_error_ar_2003_title">Непозната системска фасцикла у увозу</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_2003_why">Ова фасцикла у увозу не одговара ниједном систему који PlayFieldPortal познаје.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2003_action">Преименујте фасциклу у назив подржаног система и поново увезите.</string>
    <!-- Error code AR-3001: title of the error. -->
    <string name="dom_error_ar_3001_title">Извор графике није доступан</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_3001_why">Уређај није на мрежи или извор није одговорио.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3001_action">Проверите везу и покушајте поново касније.</string>
    <!-- Error code AR-3002: title of the error. -->
    <string name="dom_error_ar_3002_title">Извор је одбио захтев</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_3002_why">Извор ограничава захтеве или је одбијен налог или кључ који му је потребан.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3002_action">Сачекајте мало и покушајте поново или проверите налог извора у Подешавањима.</string>
    <!-- Error code AR-3003: title of the error. -->
    <string name="dom_error_ar_3003_title">За ову игру није пронађено подударање</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_3003_why">Извор нема унос који одговара наслову ове игре.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3003_action">Проверите наслов игре или ручно изаберите графику у Artwork Studio.</string>
    <!-- Error code AR-9001: title of the error. -->
    <string name="dom_error_ar_9001_title">Преузимање је неочекивано пропало</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ar_9001_why">Дошло је до неочекиване грешке током преузимања.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ar_9001_action">Покушајте поново. Ако се то понавља, копирајте детаље и пријавите проблем.</string>
    <!-- Error code AC-1001: title of the error. -->
    <string name="dom_error_ac_1001_title">Ниједан скуп достигнућа не одговара овој игри</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ac_1001_why">Ниједна повезана услуга нема достигнућа за игру са овим насловом.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ac_1001_action">Ручно повежите игру на њеној страници достигнућа.</string>
    <!-- Error code AC-2001: title of the error. -->
    <string name="dom_error_ac_2001_title">Фасциклу са Windows достигнућима није могуће прочитати</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ac_2001_why">Фасциклу изабрану за локална достигнућа ове игре није могуће отворити.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ac_2001_action">Поново изаберите фасциклу игре на њеној страници достигнућа.</string>
    <!-- Error code AC-3001: title of the error. -->
    <string name="dom_error_ac_3001_title">Уређај није на мрежи</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ac_3001_why">Достигнућа не могу да се ажурирају без интернет везе.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ac_3001_action">Повежите се на интернет. Ажурирање ће се поново покренути само.</string>
    <!-- Error code AC-3002: title of the error. -->
    <string name="dom_error_ac_3002_title">Пријава је истекла</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ac_3002_why">Повезана услуга више не прихвата пријаву PlayFieldPortal-а.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ac_3002_action">Поново повежите услугу у Подешавања › Достигнућа.</string>
    <!-- Error code AC-3003: title of the error. -->
    <string name="dom_error_ac_3003_title">Детаљи игара на Steam-у су приватни</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ac_3003_why">Steam дели достигнућа само када су ваши детаљи игара јавни.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ac_3003_action">Подесите детаље игара на „Јавно“ у подешавањима приватности на Steam-у, па поново ажурирајте.</string>
    <!-- Error code AC-3004: title of the error. -->
    <string name="dom_error_ac_3004_title">Ову игру није могуће ажурирати</string>
    <!-- Why the error happened. -->
    <string name="dom_error_ac_3004_why">Услуга није одговорила за ову игру или је одговорила грешком.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_ac_3004_action">Покушајте поново да ажурирате касније.</string>
    <!-- Error code MD-2001: title of the error. -->
    <string name="dom_error_md_2001_title">Фасциклу са медијима није могуће прочитати</string>
    <!-- Why the error happened. -->
    <string name="dom_error_md_2001_why">PlayFieldPortal је изгубио приступ овој фасцикли или она више не постоји.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_md_2001_action">Поново изаберите фасциклу у подешавањима медија, па скенирајте.</string>
    <!-- Error code MD-9001: title of the error. -->
    <string name="dom_error_md_9001_title">Скенирање медија је неочекивано пропало</string>
    <!-- Why the error happened. -->
    <string name="dom_error_md_9001_why">Дошло је до неочекиване грешке током скенирања.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_md_9001_action">Покушајте поново да скенирате. Ако се то понавља, копирајте детаље и пријавите проблем.</string>
    <!-- Error code BK-1001: title of the error. -->
    <string name="dom_error_bk_1001_title">Враћање је прескочило ставку</string>
    <!-- Why the error happened. -->
    <string name="dom_error_bk_1001_why">Ову ставку није било могуће безбедно вратити, па је остављена каква је била.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_bk_1001_action">Ништа друго није погођено. Ако вам је потребна, поново ручно подесите ову ставку.</string>
    <!-- Error code BK-2001: title of the error. -->
    <string name="dom_error_bk_2001_title">Датотеку резервне копије није могуће уписати</string>
    <!-- Why the error happened. -->
    <string name="dom_error_bk_2001_why">Меморија је била пуна или није било могуће уписати у фасциклу за резервне копије.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_bk_2001_action">Ослободите мало простора или изаберите другу локацију за резервне копије, па покушајте поново.</string>
    <!-- Error code BK-2002: title of the error. -->
    <string name="dom_error_bk_2002_title">Датотека резервне копије није читљива или је оштећена</string>
    <!-- Why the error happened. -->
    <string name="dom_error_bk_2002_why">Датотека није резервна копија PlayFieldPortal-а или је скраћена.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_bk_2002_action">Изаберите другу датотеку резервне копије.</string>
    <!-- Error code SY-9001: title of the error. -->
    <string name="dom_error_sy_9001_title">Нешто није у реду</string>
    <!-- Why the error happened. -->
    <string name="dom_error_sy_9001_why">Дошло је до неочекиване грешке.</string>
    <!-- What the user can do about it. -->
    <string name="dom_error_sy_9001_action">Покушајте поново. Ако се то понавља, копирајте детаље и пријавите проблем.</string>
