    <!-- Error codes -->
    <string name="dom_error_ln_1001_title">Nessun emulatore assegnato a questa piattaforma</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal non sa quale app deve avviare i giochi di questa piattaforma.</string>
    <string name="dom_error_ln_1001_action">Scegli un emulatore per questa piattaforma in Impostazioni › Assegnazione emulatori.</string>
    <string name="dom_error_ln_1002_title">Il core RetroArch selezionato non è installato</string>
    <string name="dom_error_ln_1002_why">È stato chiesto a RetroArch di caricare un core che non è presente su questo dispositivo.</string>
    <string name="dom_error_ln_1002_action">Installa il core dall\'Online Updater di RetroArch o scegli un altro core in Assegnazione emulatori.</string>
    <string name="dom_error_ln_2001_title">Il file del gioco manca o non è leggibile</string>
    <string name="dom_error_ln_2001_why">Il file potrebbe essere stato spostato, rinominato o eliminato, oppure la scheda SD che lo contiene è stata rimossa.</string>
    <string name="dom_error_ln_2001_action">Controlla che il file ci sia ancora, poi ripeti la scansione della sua Memory Card.</string>
    <string name="dom_error_ln_4001_title">Emulatore non trovato</string>
    <string name="dom_error_ln_4001_why">L\'emulatore assegnato a questo gioco non è installato, oppure Android non ha trovato la schermata che PlayFieldPortal apre.</string>
    <string name="dom_error_ln_4001_action">Installa l\'emulatore o scegline un altro in Impostazioni › Assegnazione emulatori.</string>
    <string name="dom_error_ln_4002_title">Android non ha permesso l\'apertura dell\'emulatore</string>
    <string name="dom_error_ln_4002_why">Android ha negato a PlayFieldPortal il permesso di avviare questo emulatore.</string>
    <string name="dom_error_ln_4002_action">Apri l\'emulatore da solo una volta, poi riprova. Se continua a succedere, aggiorna l\'emulatore.</string>
    <string name="dom_error_ln_4003_title">L\'emulatore non è mai passato in primo piano</string>
    <string name="dom_error_ln_4003_why">Molto probabilmente l\'emulatore si è chiuso all\'avvio, oppure Android l\'ha fermato prima che il gioco venisse caricato.</string>
    <string name="dom_error_ln_4003_action">Apri l\'emulatore da solo una volta per verificare che si avvii e aggiornalo se è disponibile una versione più recente. Se continua a succedere, scegli un altro emulatore in Impostazioni › Assegnazione emulatori.</string>
    <string name="dom_error_ln_9001_title">Impossibile aprire l\'emulatore</string>
    <string name="dom_error_ln_9001_why">Si è verificato un problema imprevisto durante l\'avvio dell\'emulatore.</string>
    <string name="dom_error_ln_9001_action">Riprova. Se continua a succedere, copia i dettagli e segnalalo.</string>
    <string name="dom_error_sc_1001_title">Nessuna cartella impostata per questa Memory Card</string>
    <string name="dom_error_sc_1001_why">Questa Memory Card non ha ancora una posizione da analizzare.</string>
    <string name="dom_error_sc_1001_action">Scegli una cartella dalle Opzioni della Memory Card, poi avvia la scansione.</string>
    <string name="dom_error_sc_1002_title">Una scansione è già in corso</string>
    <string name="dom_error_sc_1002_why">Questa Memory Card era già in fase di scansione, quindi la seconda scansione è stata saltata.</string>
    <string name="dom_error_sc_1002_action">Attendi che la scansione in corso finisca. Il risultato apparirà qui al termine.</string>
    <string name="dom_error_sc_2001_title">Accesso alla cartella perso</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal ha perso il permesso di leggere questa cartella.</string>
    <string name="dom_error_sc_2001_action">Scegli di nuovo la cartella dalle Opzioni della Memory Card per concedere l\'accesso, poi avvia la scansione.</string>
    <string name="dom_error_sc_2002_title">La cartella non esiste più</string>
    <string name="dom_error_sc_2002_why">La cartella è stata spostata o eliminata. Se si trova su una scheda SD, la scheda potrebbe essere stata rimossa.</string>
    <string name="dom_error_sc_2002_action">Inserisci la scheda SD e ripeti la scansione, oppure scegli una nuova cartella dalle Opzioni della Memory Card.</string>
    <string name="dom_error_sc_2003_title">Cartella di sistema sconosciuta</string>
    <string name="dom_error_sc_2003_why">Questa cartella nella cartella ROM principale non corrisponde a nessun sistema noto a PlayFieldPortal.</string>
    <string name="dom_error_sc_2003_action">Rinomina la cartella con il nome di un sistema supportato o sposta i suoi giochi in una di queste.</string>
    <string name="dom_error_sc_2004_title">File non riconosciuto</string>
    <string name="dom_error_sc_2004_why">Il tipo di questo file non è tra quelli usati dai giochi di questa piattaforma.</string>
    <string name="dom_error_sc_2004_action">Controlla che il file sia un gioco per questa piattaforma. Archivi e patch vengono saltati di proposito.</string>
    <string name="dom_error_sc_9001_title">La scansione non è riuscita per un errore imprevisto</string>
    <string name="dom_error_sc_9001_why">Si è verificato un problema imprevisto durante la scansione.</string>
    <string name="dom_error_sc_9001_action">Ripeti la scansione. Se continua a succedere, copia i dettagli e segnalalo.</string>
    <string name="dom_error_ar_1001_title">Cartella delle immagini non disponibile</string>
    <string name="dom_error_ar_1001_why">PFP non riesce a raggiungere la cartella delle immagini, quindi le nuove immagini sono in pausa.</string>
    <string name="dom_error_ar_1001_action">Ricollega la cartella in Impostazioni › Immagini.</string>
    <string name="dom_error_ar_2001_title">Impossibile salvare il file dell\'immagine</string>
    <string name="dom_error_ar_2001_why">La memoria era piena oppure non è stato possibile scrivere nella cartella delle immagini.</string>
    <string name="dom_error_ar_2001_action">Libera un po\' di spazio e riprova.</string>
    <string name="dom_error_ar_2002_title">Impossibile copiare un file</string>
    <string name="dom_error_ar_2002_why">La copia si è interrotta a metà oppure non è stato possibile scrivere nella destinazione.</string>
    <string name="dom_error_ar_2002_action">Controlla che ci sia spazio libero nella destinazione, poi riprova.</string>
    <string name="dom_error_ar_2003_title">Cartella di sistema sconosciuta nell\'importazione</string>
    <string name="dom_error_ar_2003_why">Questa cartella nell\'importazione non corrisponde a nessun sistema noto a PlayFieldPortal.</string>
    <string name="dom_error_ar_2003_action">Rinomina la cartella con il nome di un sistema supportato e ripeti l\'importazione.</string>
    <string name="dom_error_ar_3001_title">Impossibile raggiungere la fonte delle immagini</string>
    <string name="dom_error_ar_3001_why">Il dispositivo è offline oppure la fonte non ha risposto.</string>
    <string name="dom_error_ar_3001_action">Controlla la connessione e riprova più tardi.</string>
    <string name="dom_error_ar_3002_title">La fonte ha rifiutato la richiesta</string>
    <string name="dom_error_ar_3002_why">La fonte sta limitando le richieste, oppure l\'account o la chiave richiesti sono stati rifiutati.</string>
    <string name="dom_error_ar_3002_action">Attendi un po\' e riprova, oppure controlla l\'account della fonte in Impostazioni.</string>
    <string name="dom_error_ar_3003_title">Nessuna corrispondenza trovata per questo gioco</string>
    <string name="dom_error_ar_3003_why">La fonte non ha voci che corrispondano al titolo di questo gioco.</string>
    <string name="dom_error_ar_3003_action">Controlla il titolo del gioco oppure scegli le immagini a mano nell\'Artwork Studio.</string>
    <string name="dom_error_ar_9001_title">Il download non è riuscito per un errore imprevisto</string>
    <string name="dom_error_ar_9001_why">Si è verificato un problema imprevisto durante il download.</string>
    <string name="dom_error_ar_9001_action">Riprova. Se continua a succedere, copia i dettagli e segnalalo.</string>
    <string name="dom_error_ac_1001_title">Nessun set di achievement corrisponde a questo gioco</string>
    <string name="dom_error_ac_1001_why">Nessuno dei servizi collegati ha achievement per un gioco con questo titolo.</string>
    <string name="dom_error_ac_1001_action">Abbina il gioco a mano dalla sua pagina degli achievement.</string>
    <string name="dom_error_ac_2001_title">Impossibile leggere la cartella degli achievement Windows</string>
    <string name="dom_error_ac_2001_why">Non è stato possibile aprire la cartella scelta per gli achievement locali di questo gioco.</string>
    <string name="dom_error_ac_2001_action">Scegli di nuovo la cartella del gioco dalla sua pagina degli achievement.</string>
    <string name="dom_error_ac_3001_title">Il dispositivo è offline</string>
    <string name="dom_error_ac_3001_why">Gli achievement non possono aggiornarsi senza una connessione a Internet.</string>
    <string name="dom_error_ac_3001_action">Connettiti a Internet. L\'aggiornamento ripartirà da solo.</string>
    <string name="dom_error_ac_3002_title">Accesso scaduto</string>
    <string name="dom_error_ac_3002_why">Il servizio collegato non accetta più l\'accesso di PlayFieldPortal.</string>
    <string name="dom_error_ac_3002_action">Ricollega il servizio in Impostazioni › Achievement.</string>
    <string name="dom_error_ac_3003_title">I dettagli di gioco di Steam sono privati</string>
    <string name="dom_error_ac_3003_why">Steam condivide gli achievement solo quando i tuoi dettagli di gioco sono pubblici.</string>
    <string name="dom_error_ac_3003_action">Imposta Dettagli di gioco su Pubblico nelle impostazioni della privacy di Steam, poi aggiorna di nuovo.</string>
    <string name="dom_error_ac_3004_title">Impossibile aggiornare questo gioco</string>
    <string name="dom_error_ac_3004_why">Il servizio non ha risposto per questo gioco oppure ha risposto con un errore.</string>
    <string name="dom_error_ac_3004_action">Riprova l\'aggiornamento più tardi.</string>
    <string name="dom_error_md_2001_title">Impossibile leggere la cartella multimediale</string>
    <string name="dom_error_md_2001_why">PlayFieldPortal ha perso l\'accesso a questa cartella oppure non esiste più.</string>
    <string name="dom_error_md_2001_action">Scegli di nuovo la cartella nelle impostazioni multimediali, poi avvia la scansione.</string>
    <string name="dom_error_md_9001_title">La scansione multimediale non è riuscita per un errore imprevisto</string>
    <string name="dom_error_md_9001_why">Si è verificato un problema imprevisto durante la scansione.</string>
