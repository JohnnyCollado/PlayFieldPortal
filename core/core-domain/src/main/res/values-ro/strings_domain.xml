    <!-- Error codes: launch -->
    <string name="dom_error_ln_1001_title">Niciun emulator nu este atribuit acestei platforme</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal nu știe ce aplicație trebuie să ruleze jocurile pentru această platformă.</string>
    <string name="dom_error_ln_1001_action">Alege un emulator pentru această platformă în Setări › Atribuire emulatoare.</string>
    <string name="dom_error_ln_1002_title">Core-ul RetroArch selectat nu este instalat</string>
    <string name="dom_error_ln_1002_why">RetroArch a primit cererea de a încărca un core care nu se află pe acest dispozitiv.</string>
    <string name="dom_error_ln_1002_action">Instalează core-ul din Online Updater al RetroArch sau alege alt core în Atribuire emulatoare.</string>
    <string name="dom_error_ln_2001_title">Fișierul jocului lipsește sau nu poate fi citit</string>
    <string name="dom_error_ln_2001_why">Este posibil ca fișierul să fi fost mutat, redenumit sau șters ori ca cardul SD pe care se afla să fi fost scos.</string>
    <string name="dom_error_ln_2001_action">Verifică dacă fișierul mai există, apoi rescanează cardul de memorie.</string>
    <string name="dom_error_ln_4001_title">Emulatorul nu a fost găsit</string>
    <string name="dom_error_ln_4001_why">Emulatorul atribuit acestui joc nu este instalat sau Android nu a găsit ecranul pe care îl deschide PlayFieldPortal.</string>
    <string name="dom_error_ln_4001_action">Instalează emulatorul sau alege altul în Setări › Atribuire emulatoare.</string>
    <string name="dom_error_ln_4002_title">Android nu a permis deschiderea emulatorului</string>
    <string name="dom_error_ln_4002_why">Android a refuzat permisiunea ca PlayFieldPortal să pornească acest emulator.</string>
    <string name="dom_error_ln_4002_action">Deschide o dată emulatorul separat, apoi încearcă din nou. Dacă problema persistă, actualizează emulatorul.</string>
    <string name="dom_error_ln_4003_title">Emulatorul nu a ajuns niciodată în prim-plan</string>
    <string name="dom_error_ln_4003_why">Cel mai probabil emulatorul s-a închis la pornire sau Android l-a oprit înainte ca jocul să se încarce.</string>
    <string name="dom_error_ln_4003_action">Deschide o dată emulatorul separat pentru a verifica dacă pornește și actualizează-l dacă există o versiune mai nouă. Dacă problema persistă, alege alt emulator în Setări › Atribuire emulatoare.</string>
    <string name="dom_error_ln_9001_title">Emulatorul nu a putut fi deschis</string>
    <string name="dom_error_ln_9001_why">Ceva neașteptat a mers prost la pornirea emulatorului.</string>
    <string name="dom_error_ln_9001_action">Încearcă din nou. Dacă problema persistă, copiază detaliile și raportează-o.</string>

    <!-- Error codes: scan -->
    <string name="dom_error_sc_1001_title">Niciun dosar setat pentru acest card de memorie</string>
    <string name="dom_error_sc_1001_why">Acest card de memorie nu are încă unde să scaneze.</string>
    <string name="dom_error_sc_1001_action">Alege un dosar din Opțiunile cardului de memorie, apoi scanează-l.</string>
    <string name="dom_error_sc_1002_title">O scanare rulează deja</string>
    <string name="dom_error_sc_1002_why">Acest card de memorie era deja în curs de scanare, așa că a doua scanare a fost omisă.</string>
    <string name="dom_error_sc_1002_action">Așteaptă să se termine scanarea în curs. Rezultatul ei apare aici când e gata.</string>
    <string name="dom_error_sc_2001_title">Accesul la dosar s-a pierdut</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal a pierdut permisiunea de a citi acest dosar.</string>
    <string name="dom_error_sc_2001_action">Alege din nou dosarul din Opțiunile cardului de memorie pentru a acorda accesul, apoi scanează-l.</string>
    <string name="dom_error_sc_2002_title">Dosarul nu mai există</string>
    <string name="dom_error_sc_2002_why">Dosarul a fost mutat sau șters. Dacă este pe un card SD, este posibil ca acesta să fi fost scos.</string>
    <string name="dom_error_sc_2002_action">Introdu cardul SD și scanează din nou sau alege un dosar nou din Opțiunile cardului de memorie.</string>
    <string name="dom_error_sc_2003_title">Dosar de sistem necunoscut</string>
    <string name="dom_error_sc_2003_why">Acest dosar din dosarul ROM principal nu corespunde unui sistem cunoscut de PlayFieldPortal.</string>
    <string name="dom_error_sc_2003_action">Redenumește dosarul cu numele unui sistem acceptat sau mută-i jocurile într-unul.</string>
    <string name="dom_error_sc_2004_title">Fișier nerecunoscut</string>
    <string name="dom_error_sc_2004_why">Tipul acestui fișier nu este folosit de jocurile acestei platforme.</string>
    <string name="dom_error_sc_2004_action">Verifică dacă fișierul este un joc pentru această platformă. Arhivele și patch-urile sunt omise intenționat.</string>
    <string name="dom_error_sc_9001_title">Scanarea a eșuat neașteptat</string>
    <string name="dom_error_sc_9001_why">Ceva neașteptat a mers prost în timpul scanării.</string>
    <string name="dom_error_sc_9001_action">Încearcă din nou scanarea. Dacă problema persistă, copiază detaliile și raportează-o.</string>

    <!-- Error codes: artwork -->
    <string name="dom_error_ar_1001_title">Dosarul de artwork nu este disponibil</string>
    <string name="dom_error_ar_1001_why">PFP nu poate accesa dosarul de artwork, așa că artwork-ul nou este întrerupt.</string>
    <string name="dom_error_ar_1001_action">Leagă din nou dosarul în Setări › Artwork.</string>
    <string name="dom_error_ar_2001_title">Fișierul de artwork nu a putut fi salvat</string>
    <string name="dom_error_ar_2001_why">Spațiul de stocare era plin sau nu s-a putut scrie în dosarul de artwork.</string>
    <string name="dom_error_ar_2001_action">Eliberează spațiu și încearcă din nou.</string>
    <string name="dom_error_ar_2002_title">Un fișier nu a putut fi copiat</string>
    <string name="dom_error_ar_2002_why">Copierea a eșuat la jumătate sau nu s-a putut scrie la destinație.</string>
    <string name="dom_error_ar_2002_action">Verifică dacă există spațiu liber la destinație, apoi rulează din nou.</string>
    <string name="dom_error_ar_2003_title">Dosar de sistem necunoscut în import</string>
    <string name="dom_error_ar_2003_why">Acest dosar din import nu corespunde unui sistem cunoscut de PlayFieldPortal.</string>
    <string name="dom_error_ar_2003_action">Redenumește dosarul cu numele unui sistem acceptat și importă din nou.</string>
    <string name="dom_error_ar_3001_title">Sursa de artwork nu a putut fi accesată</string>
    <string name="dom_error_ar_3001_why">Dispozitivul este offline sau sursa nu a răspuns.</string>
    <string name="dom_error_ar_3001_action">Verifică conexiunea și încearcă din nou mai târziu.</string>
    <string name="dom_error_ar_3002_title">Sursa a respins cererea</string>
    <string name="dom_error_ar_3002_why">Sursa limitează cererile sau contul ori cheia necesară a fost refuzată.</string>
    <string name="dom_error_ar_3002_action">Așteaptă puțin și încearcă din nou sau verifică contul sursei în Setări.</string>
    <string name="dom_error_ar_3003_title">Nu s-a găsit nicio potrivire pentru acest joc</string>
    <string name="dom_error_ar_3003_why">Sursa nu are nicio intrare care să corespundă titlului acestui joc.</string>
    <string name="dom_error_ar_3003_action">Verifică titlul jocului sau alege manual artwork-ul în Artwork Studio.</string>
    <string name="dom_error_ar_9001_title">Descărcarea a eșuat neașteptat</string>
    <string name="dom_error_ar_9001_why">Ceva neașteptat a mers prost în timpul descărcării.</string>
    <string name="dom_error_ar_9001_action">Încearcă din nou. Dacă problema persistă, copiază detaliile și raportează-o.</string>

    <!-- Error codes: achievements -->
    <string name="dom_error_ac_1001_title">Niciun set de realizări nu corespunde acestui joc</string>
    <string name="dom_error_ac_1001_why">Niciunul dintre serviciile conectate nu are realizări pentru un joc cu acest titlu.</string>
    <string name="dom_error_ac_1001_action">Potrivește manual jocul din pagina sa de realizări.</string>
    <string name="dom_error_ac_2001_title">Dosarul de realizări Windows nu poate fi citit</string>
    <string name="dom_error_ac_2001_why">Dosarul ales pentru realizările locale ale acestui joc nu a putut fi deschis.</string>
    <string name="dom_error_ac_2001_action">Alege din nou dosarul jocului din pagina sa de realizări.</string>
    <string name="dom_error_ac_3001_title">Dispozitivul este offline</string>
    <string name="dom_error_ac_3001_why">Realizările nu se pot actualiza fără conexiune la internet.</string>
    <string name="dom_error_ac_3001_action">Conectează-te la internet. Actualizarea va rula din nou automat.</string>
    <string name="dom_error_ac_3002_title">Conectarea a expirat</string>
    <string name="dom_error_ac_3002_why">Serviciul conectat nu mai acceptă conectarea PlayFieldPortal.</string>
    <string name="dom_error_ac_3002_action">Reconectează serviciul în Setări › Realizări.</string>
    <string name="dom_error_ac_3003_title">Detaliile jocurilor Steam sunt private</string>
    <string name="dom_error_ac_3003_why">Steam partajează realizările doar când Detaliile jocurilor sunt publice.</string>
    <string name="dom_error_ac_3003_action">Setează Detaliile jocurilor la Public în setările de confidențialitate Steam, apoi actualizează din nou.</string>
    <string name="dom_error_ac_3004_title">Acest joc nu s-a putut actualiza</string>
    <string name="dom_error_ac_3004_why">Serviciul nu a răspuns pentru acest joc sau a răspuns cu o eroare.</string>
    <string name="dom_error_ac_3004_action">Încearcă din nou actualizarea mai târziu.</string>

    <!-- Error codes: media -->
    <string name="dom_error_md_2001_title">Dosarul media nu poate fi citit</string>
