    <!-- Error codes -->
    <string name="dom_error_ln_1001_title">Ingen emulator är tilldelad till plattformen</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal vet inte vilken app som ska köra spel för plattformen.</string>
    <string name="dom_error_ln_1001_action">Välj en emulator för plattformen i Inställningar › Emulatortilldelning.</string>
    <string name="dom_error_ln_1002_title">Den valda RetroArch-kärnan är inte installerad</string>
    <string name="dom_error_ln_1002_why">RetroArch ombads ladda en kärna som inte finns på enheten.</string>
    <string name="dom_error_ln_1002_action">Installera kärnan från RetroArchs Online Updater eller välj en annan kärna i Emulatortilldelning.</string>
    <string name="dom_error_ln_2001_title">Spelfilen saknas eller kan inte läsas</string>
    <string name="dom_error_ln_2001_why">Filen kan ha flyttats, bytt namn eller raderats, eller så har SD-kortet den låg på tagits ut.</string>
    <string name="dom_error_ln_2001_action">Kontrollera att filen finns kvar och sök sedan igenom dess minneskort igen.</string>
    <string name="dom_error_ln_4001_title">Emulatorn hittades inte</string>
    <string name="dom_error_ln_4001_why">Emulatorn som är tilldelad till spelet är inte installerad, eller så hittade Android inte skärmen som PlayFieldPortal öppnar.</string>
    <string name="dom_error_ln_4001_action">Installera emulatorn eller välj en annan i Inställningar › Emulatortilldelning.</string>
    <string name="dom_error_ln_4002_title">Android tillät inte att emulatorn öppnades</string>
    <string name="dom_error_ln_4002_why">Android nekade PlayFieldPortal behörighet att starta emulatorn.</string>
    <string name="dom_error_ln_4002_action">Öppna emulatorn separat en gång och försök sedan igen. Om det fortsätter uppdaterar du emulatorn.</string>
    <string name="dom_error_ln_4003_title">Emulatorn kom aldrig i förgrunden</string>
    <string name="dom_error_ln_4003_why">Emulatorn stängdes troligen när den startade, eller så stoppade Android den innan spelet hann laddas.</string>
    <string name="dom_error_ln_4003_action">Öppna emulatorn separat en gång för att kontrollera att den startar, och uppdatera den om en nyare version finns. Om det fortsätter väljer du en annan emulator i Inställningar › Emulatortilldelning.</string>
    <string name="dom_error_ln_9001_title">Emulatorn kunde inte öppnas</string>
    <string name="dom_error_ln_9001_why">Något oväntat gick fel när emulatorn startades.</string>
    <string name="dom_error_ln_9001_action">Försök igen. Om det fortsätter kopierar du detaljerna och rapporterar felet.</string>
    <string name="dom_error_sc_1001_title">Ingen mapp har angetts för minneskortet</string>
    <string name="dom_error_sc_1001_why">Minneskortet har ännu ingen plats att söka i.</string>
    <string name="dom_error_sc_1001_action">Välj en mapp under minneskortets Alternativ och sök sedan igenom den.</string>
    <string name="dom_error_sc_1002_title">En sökning pågår redan</string>
    <string name="dom_error_sc_1002_why">Minneskortet söktes redan igenom, så den andra sökningen hoppades över.</string>
    <string name="dom_error_sc_1002_action">Vänta tills den pågående sökningen är klar. Resultatet visas här när den är färdig.</string>
    <string name="dom_error_sc_2001_title">Åtkomsten till mappen förlorades</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal förlorade behörigheten att läsa mappen.</string>
    <string name="dom_error_sc_2001_action">Välj mappen igen under minneskortets Alternativ så att åtkomst ges och sök sedan igenom den.</string>
    <string name="dom_error_sc_2002_title">Mappen finns inte längre</string>
    <string name="dom_error_sc_2002_why">Mappen har flyttats eller raderats. Om den ligger på ett SD-kort kan kortet ha tagits ut.</string>
    <string name="dom_error_sc_2002_action">Sätt i SD-kortet och sök igen, eller välj en ny mapp under minneskortets Alternativ.</string>
    <string name="dom_error_sc_2003_title">Okänd systemmapp</string>
    <string name="dom_error_sc_2003_why">Mappen i den primära ROM-mappen matchar inget system som PlayFieldPortal känner till.</string>
    <string name="dom_error_sc_2003_action">Byt namn på mappen till ett systemnamn som stöds eller flytta dess spel till en sådan mapp.</string>
    <string name="dom_error_sc_2004_title">Filen kändes inte igen</string>
    <string name="dom_error_sc_2004_why">Filtypen används inte av spel för den här plattformen.</string>
    <string name="dom_error_sc_2004_action">Kontrollera att filen är ett spel för plattformen. Arkiv och patchar hoppas över avsiktligt.</string>
    <string name="dom_error_sc_9001_title">Sökningen misslyckades oväntat</string>
    <string name="dom_error_sc_9001_why">Något oväntat gick fel under sökningen.</string>
    <string name="dom_error_sc_9001_action">Försök söka igen. Om det fortsätter kopierar du detaljerna och rapporterar felet.</string>
    <string name="dom_error_ar_1001_title">Grafikmappen är inte tillgänglig</string>
    <string name="dom_error_ar_1001_why">PFP kan inte nå grafikmappen, så ny grafik har pausats.</string>
    <string name="dom_error_ar_1001_action">Länka mappen igen i Inställningar › Grafik.</string>
    <string name="dom_error_ar_2001_title">Grafikfilen kunde inte sparas</string>
    <string name="dom_error_ar_2001_why">Lagringen var full, eller så gick det inte att skriva till grafikmappen.</string>
    <string name="dom_error_ar_2001_action">Frigör lite utrymme och försök igen.</string>
    <string name="dom_error_ar_2002_title">En fil kunde inte kopieras</string>
    <string name="dom_error_ar_2002_why">Kopieringen avbröts halvvägs, eller så gick det inte att skriva till målet.</string>
    <string name="dom_error_ar_2002_action">Kontrollera att det finns ledigt utrymme vid målet och kör sedan igen.</string>
    <string name="dom_error_ar_2003_title">Okänd systemmapp i importen</string>
    <string name="dom_error_ar_2003_why">Mappen i importen matchar inget system som PlayFieldPortal känner till.</string>
    <string name="dom_error_ar_2003_action">Byt namn på mappen till ett systemnamn som stöds och importera igen.</string>
    <string name="dom_error_ar_3001_title">Det gick inte att nå grafikkällan</string>
    <string name="dom_error_ar_3001_why">Enheten är offline, eller så svarade inte källan.</string>
    <string name="dom_error_ar_3001_action">Kontrollera anslutningen och försök igen senare.</string>
    <string name="dom_error_ar_3002_title">Källan avvisade begäran</string>
    <string name="dom_error_ar_3002_why">Källan begränsar antalet förfrågningar, eller så nekades kontot eller nyckeln som krävs.</string>
    <string name="dom_error_ar_3002_action">Vänta en stund och försök igen, eller kontrollera källans konto i Inställningar.</string>
