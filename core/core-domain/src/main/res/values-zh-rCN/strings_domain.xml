    <!-- Error codes -->
    <string name="dom_error_ln_1001_title">此平台未指定模拟器</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal 不知道应由哪个应用运行此平台的游戏。</string>
    <string name="dom_error_ln_1001_action">请在“设置 › 模拟器分配”中为此平台选择模拟器。</string>
    <string name="dom_error_ln_1002_title">未安装所选的 RetroArch 核心</string>
    <string name="dom_error_ln_1002_why">RetroArch 被要求加载一个此设备上没有的核心。</string>
    <string name="dom_error_ln_1002_action">请通过 RetroArch 的在线更新程序安装该核心，或在“模拟器分配”中选择其他核心。</string>
    <string name="dom_error_ln_2001_title">游戏文件缺失或无法读取</string>
    <string name="dom_error_ln_2001_why">文件可能已被移动、重命名或删除，或存放它的 SD 卡已被移除。</string>
    <string name="dom_error_ln_2001_action">请检查文件是否仍在原处，然后重新扫描其记忆卡。</string>
    <string name="dom_error_ln_4001_title">找不到模拟器</string>
    <string name="dom_error_ln_4001_why">为此游戏分配的模拟器未安装，或 Android 找不到 PlayFieldPortal 要打开的界面。</string>
    <string name="dom_error_ln_4001_action">请安装该模拟器，或在“设置 › 模拟器分配”中选择其他模拟器。</string>
    <string name="dom_error_ln_4002_title">Android 不允许打开该模拟器</string>
    <string name="dom_error_ln_4002_why">Android 拒绝了 PlayFieldPortal 启动此模拟器的权限。</string>
    <string name="dom_error_ln_4002_action">请先单独打开一次该模拟器，然后重试。如果问题持续出现，请更新该模拟器。</string>
    <string name="dom_error_ln_4003_title">模拟器始终未切换到前台</string>
    <string name="dom_error_ln_4003_why">模拟器很可能在启动时就关闭了，或 Android 在游戏加载前就将其停止。</string>
    <string name="dom_error_ln_4003_action">请单独打开一次该模拟器，确认它能正常启动；如有新版本，请进行更新。如果问题持续出现，请在“设置 › 模拟器分配”中选择其他模拟器。</string>
    <string name="dom_error_ln_9001_title">无法打开模拟器</string>
    <string name="dom_error_ln_9001_why">启动模拟器时发生意外错误。</string>
    <string name="dom_error_ln_9001_action">请重试。如果问题持续出现，请复制详情并报告。</string>
    <string name="dom_error_sc_1001_title">此记忆卡未设置文件夹</string>
    <string name="dom_error_sc_1001_why">此记忆卡还没有可扫描的位置。</string>
