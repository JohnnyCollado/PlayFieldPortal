    <!-- Error codes -->
    <string name="dom_error_ln_1001_title">No hay ningún emulador asignado a esta plataforma</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal no sabe qué app debe ejecutar los juegos de esta plataforma.</string>
    <string name="dom_error_ln_1001_action">Elige un emulador para esta plataforma en Ajustes › Asignación de emuladores.</string>
    <string name="dom_error_ln_1002_title">El núcleo de RetroArch seleccionado no está instalado</string>
    <string name="dom_error_ln_1002_why">Se pidió a RetroArch que cargara un núcleo que no está en este dispositivo.</string>
    <string name="dom_error_ln_1002_action">Instala el núcleo desde el Actualizador en línea de RetroArch o elige otro núcleo en Asignación de emuladores.</string>
    <string name="dom_error_ln_2001_title">Falta el archivo del juego o no se puede leer</string>
    <string name="dom_error_ln_2001_why">Puede que el archivo se haya movido, renombrado o eliminado, o que se haya extraído la tarjeta SD que lo contenía.</string>
    <string name="dom_error_ln_2001_action">Comprueba que el archivo sigue ahí y vuelve a escanear su Memory Card.</string>
    <string name="dom_error_ln_4001_title">No se encontró el emulador</string>
    <string name="dom_error_ln_4001_why">El emulador asignado a este juego no está instalado, o Android no encontró la pantalla que abre PlayFieldPortal.</string>
    <string name="dom_error_ln_4001_action">Instala el emulador o elige otro en Ajustes › Asignación de emuladores.</string>
    <string name="dom_error_ln_4002_title">Android no permitió abrir el emulador</string>
    <string name="dom_error_ln_4002_why">Android denegó a PlayFieldPortal el permiso para iniciar este emulador.</string>
    <string name="dom_error_ln_4002_action">Abre el emulador por separado una vez y vuelve a intentarlo. Si sigue pasando, actualiza el emulador.</string>
    <string name="dom_error_ln_4003_title">El emulador nunca pasó a primer plano</string>
    <string name="dom_error_ln_4003_why">Lo más probable es que el emulador se cerrara al iniciarse o que Android lo detuviera antes de que se cargara el juego.</string>
    <string name="dom_error_ln_4003_action">Abre el emulador por separado una vez para comprobar que se inicia y actualízalo si hay una versión más reciente. Si sigue pasando, elige otro emulador en Ajustes › Asignación de emuladores.</string>
    <string name="dom_error_ln_9001_title">No se pudo abrir el emulador</string>
    <string name="dom_error_ln_9001_why">Algo salió mal de forma inesperada al iniciar el emulador.</string>
    <string name="dom_error_ln_9001_action">Vuelve a intentarlo. Si sigue pasando, copia los detalles e infórmalo.</string>
    <string name="dom_error_sc_1001_title">No hay ninguna carpeta asignada a esta Memory Card</string>
    <string name="dom_error_sc_1001_why">Esta Memory Card todavía no tiene dónde escanear.</string>
    <string name="dom_error_sc_1001_action">Elige una carpeta desde las Opciones de la Memory Card y luego escanéala.</string>
    <string name="dom_error_sc_1002_title">Ya hay un escaneo en curso</string>
    <string name="dom_error_sc_1002_why">Esta Memory Card ya se estaba escaneando, así que se omitió el segundo escaneo.</string>
    <string name="dom_error_sc_1002_action">Espera a que termine el escaneo en curso. Su resultado aparecerá aquí cuando acabe.</string>
    <string name="dom_error_sc_2001_title">Se perdió el acceso a la carpeta</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal perdió el permiso para leer esta carpeta.</string>
    <string name="dom_error_sc_2001_action">Vuelve a elegir la carpeta desde las Opciones de la Memory Card para conceder el acceso y luego escanéala.</string>
    <string name="dom_error_sc_2002_title">La carpeta ya no existe</string>
    <string name="dom_error_sc_2002_why">La carpeta se movió o se eliminó. Si está en una tarjeta SD, puede que se haya extraído la tarjeta.</string>
    <string name="dom_error_sc_2002_action">Inserta la tarjeta SD y vuelve a escanear, o elige una carpeta nueva desde las Opciones de la Memory Card.</string>
    <string name="dom_error_sc_2003_title">Carpeta de sistema desconocida</string>
    <string name="dom_error_sc_2003_why">Esta carpeta dentro de la carpeta de ROM principal no coincide con ningún sistema que PlayFieldPortal conozca.</string>
    <string name="dom_error_sc_2003_action">Renombra la carpeta con un nombre de sistema compatible o mueve sus juegos a una que lo tenga.</string>
    <string name="dom_error_sc_2004_title">Archivo no reconocido</string>
    <string name="dom_error_sc_2004_why">El tipo de este archivo no es uno de los que usan los juegos de esta plataforma.</string>
    <string name="dom_error_sc_2004_action">Comprueba que el archivo sea un juego de esta plataforma. Los archivos comprimidos y los parches se omiten a propósito.</string>
    <string name="dom_error_sc_9001_title">El escaneo falló de forma inesperada</string>
    <string name="dom_error_sc_9001_why">Algo salió mal de forma inesperada durante el escaneo.</string>
    <string name="dom_error_sc_9001_action">Vuelve a escanear. Si sigue pasando, copia los detalles e infórmalo.</string>
    <string name="dom_error_ar_1001_title">Carpeta de ilustraciones no disponible</string>
    <string name="dom_error_ar_1001_why">PFP no puede acceder a la carpeta de ilustraciones, así que las nuevas ilustraciones están en pausa.</string>
    <string name="dom_error_ar_1001_action">Vuelve a vincular la carpeta en Ajustes › Ilustraciones.</string>
    <string name="dom_error_ar_2001_title">No se pudo guardar el archivo de ilustración</string>
    <string name="dom_error_ar_2001_why">El almacenamiento estaba lleno o no se pudo escribir en la carpeta de ilustraciones.</string>
    <string name="dom_error_ar_2001_action">Libera algo de espacio y vuelve a intentarlo.</string>
    <string name="dom_error_ar_2002_title">No se pudo copiar un archivo</string>
    <string name="dom_error_ar_2002_why">La copia falló a medias o no se pudo escribir en el destino.</string>
    <string name="dom_error_ar_2002_action">Comprueba que haya espacio libre en el destino y vuelve a ejecutarlo.</string>
    <string name="dom_error_ar_2003_title">Carpeta de sistema desconocida en la importación</string>
    <string name="dom_error_ar_2003_why">Esta carpeta de la importación no coincide con ningún sistema que PlayFieldPortal conozca.</string>
    <string name="dom_error_ar_2003_action">Renombra la carpeta con un nombre de sistema compatible y vuelve a importar.</string>
    <string name="dom_error_ar_3001_title">No se pudo acceder a la fuente de ilustraciones</string>
    <string name="dom_error_ar_3001_why">El dispositivo no tiene conexión o la fuente no respondió.</string>
    <string name="dom_error_ar_3001_action">Comprueba la conexión y vuelve a intentarlo más tarde.</string>
    <string name="dom_error_ar_3002_title">La fuente rechazó la solicitud</string>
    <string name="dom_error_ar_3002_why">La fuente está limitando las solicitudes, o se rechazó la cuenta o clave que necesita.</string>
    <string name="dom_error_ar_3002_action">Espera un rato y vuelve a intentarlo, o revisa la cuenta de la fuente en Ajustes.</string>
    <string name="dom_error_ar_3003_title">No se encontró ninguna coincidencia para este juego</string>
    <string name="dom_error_ar_3003_why">La fuente no tiene ninguna entrada que coincida con el título de este juego.</string>
    <string name="dom_error_ar_3003_action">Revisa el título del juego o elige las ilustraciones a mano en el Artwork Studio.</string>
    <string name="dom_error_ar_9001_title">La descarga falló de forma inesperada</string>
    <string name="dom_error_ar_9001_why">Algo salió mal de forma inesperada durante la descarga.</string>
    <string name="dom_error_ar_9001_action">Vuelve a intentarlo. Si sigue pasando, copia los detalles e infórmalo.</string>
    <string name="dom_error_ac_1001_title">Ningún conjunto de logros coincidió con este juego</string>
    <string name="dom_error_ac_1001_why">Ninguno de los servicios conectados tiene logros para un juego con este título.</string>
    <string name="dom_error_ac_1001_action">Asocia el juego a mano desde su página de logros.</string>
    <string name="dom_error_ac_2001_title">No se puede leer la carpeta de logros de Windows</string>
    <string name="dom_error_ac_2001_why">No se pudo abrir la carpeta elegida para los logros locales de este juego.</string>
    <string name="dom_error_ac_2001_action">Vuelve a elegir la carpeta del juego desde su página de logros.</string>
    <string name="dom_error_ac_3001_title">El dispositivo no tiene conexión</string>
    <string name="dom_error_ac_3001_why">Los logros no se pueden actualizar sin conexión a internet.</string>
    <string name="dom_error_ac_3001_action">Conéctate a internet. La actualización se volverá a ejecutar sola.</string>
    <string name="dom_error_ac_3002_title">La sesión caducó</string>
    <string name="dom_error_ac_3002_why">El servicio conectado ya no acepta la sesión de PlayFieldPortal.</string>
    <string name="dom_error_ac_3002_action">Vuelve a conectar el servicio en Ajustes › Logros.</string>
    <string name="dom_error_ac_3003_title">Los detalles de juego de Steam son privados</string>
    <string name="dom_error_ac_3003_why">Steam solo comparte los logros cuando tus detalles de juego son públicos.</string>
    <string name="dom_error_ac_3003_action">Establece los detalles de juego como públicos en la configuración de privacidad de Steam y vuelve a actualizar.</string>
    <string name="dom_error_ac_3004_title">No se pudo actualizar este juego</string>
    <string name="dom_error_ac_3004_why">El servicio no respondió para este juego o respondió con un error.</string>
    <string name="dom_error_ac_3004_action">Vuelve a intentar la actualización más tarde.</string>
    <string name="dom_error_md_2001_title">No se puede leer la carpeta de medios</string>
    <string name="dom_error_md_2001_why">PlayFieldPortal perdió el acceso a esta carpeta o ya no existe.</string>
    <string name="dom_error_md_2001_action">Vuelve a elegir la carpeta en los ajustes de medios y luego escanea.</string>
