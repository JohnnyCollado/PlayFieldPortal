    <!-- Error codes: title, why it happened, and what the user can do (docs/dev/notification-error-codes.md) -->
    <!-- Error code LN-1001: title of the error. -->
    <string name="dom_error_ln_1001_title">لم يتم تعيين محاكٍ لهذه المنصة</string>
    <string name="dom_error_ln_1001_why">لا يعرف PlayFieldPortal أي تطبيق يجب أن يشغّل ألعاب هذه المنصة.</string>
    <string name="dom_error_ln_1001_action">اختر محاكيًا لهذه المنصة من الإعدادات › تعيين المحاكيات.</string>
    <string name="dom_error_ln_1002_title">نواة RetroArch المحددة غير مثبّتة</string>
    <string name="dom_error_ln_1002_why">طُلب من RetroArch تحميل نواة غير موجودة على هذا الجهاز.</string>
    <string name="dom_error_ln_1002_action">ثبّت النواة من Online Updater في RetroArch، أو اختر نواة أخرى في تعيين المحاكيات.</string>
    <string name="dom_error_ln_2001_title">ملف اللعبة مفقود أو غير قابل للقراءة</string>
    <string name="dom_error_ln_2001_why">ربما نُقل الملف أو أُعيدت تسميته أو حُذف، أو أُزيلت بطاقة SD التي تحمله.</string>
    <string name="dom_error_ln_2001_action">تأكّد من أن الملف لا يزال موجودًا، ثم أعِد فحص بطاقة الذاكرة الخاصة به.</string>
    <string name="dom_error_ln_4001_title">لم يتم العثور على المحاكي</string>
    <string name="dom_error_ln_4001_why">المحاكي المعيّن لهذه اللعبة غير مثبّت، أو لم يعثر Android على الشاشة التي يفتحها PlayFieldPortal.</string>
    <string name="dom_error_ln_4001_action">ثبّت المحاكي، أو اختر محاكيًا آخر من الإعدادات › تعيين المحاكيات.</string>
    <string name="dom_error_ln_4002_title">لم يسمح Android بفتح المحاكي</string>
    <string name="dom_error_ln_4002_why">رفض Android منح PlayFieldPortal إذنًا لتشغيل هذا المحاكي.</string>
    <string name="dom_error_ln_4002_action">افتح المحاكي بمفرده مرة واحدة، ثم حاول مجددًا. إذا تكرر ذلك، حدّث المحاكي.</string>
    <string name="dom_error_ln_4003_title">لم يظهر المحاكي في الواجهة أبدًا</string>
    <string name="dom_error_ln_4003_why">على الأرجح أُغلق المحاكي أثناء بدء تشغيله، أو أوقفه Android قبل أن تُحمَّل اللعبة.</string>
    <string name="dom_error_ln_4003_action">افتح المحاكي بمفرده مرة واحدة للتأكد من أنه يعمل، وحدّثه إن توفّر إصدار أحدث. إذا تكرر ذلك، اختر محاكيًا آخر من الإعدادات › تعيين المحاكيات.</string>
    <string name="dom_error_ln_9001_title">تعذّر فتح المحاكي</string>
    <string name="dom_error_ln_9001_why">حدث خطأ غير متوقع أثناء تشغيل المحاكي.</string>
    <string name="dom_error_ln_9001_action">حاول مجددًا. إذا تكرر ذلك، انسخ التفاصيل وأبلغ عنه.</string>
    <string name="dom_error_sc_1001_title">لم يتم تعيين مجلد لبطاقة الذاكرة هذه</string>
    <string name="dom_error_sc_1001_why">لا يوجد لبطاقة الذاكرة هذه مكان لفحصه بعد.</string>
    <string name="dom_error_sc_1001_action">اختر مجلدًا من خيارات بطاقة الذاكرة، ثم افحصه.</string>
    <string name="dom_error_sc_1002_title">هناك فحص قيد التشغيل بالفعل</string>
    <string name="dom_error_sc_1002_why">كانت بطاقة الذاكرة هذه قيد الفحص بالفعل، لذا تم تخطي الفحص الثاني.</string>
    <string name="dom_error_sc_1002_action">انتظر حتى ينتهي الفحص الجاري. ستظهر نتيجته هنا عند اكتماله.</string>
    <string name="dom_error_sc_2001_title">فُقد الوصول إلى المجلد</string>
    <string name="dom_error_sc_2001_why">فقد PlayFieldPortal إذن قراءة هذا المجلد.</string>
    <string name="dom_error_sc_2001_action">اختر المجلد مرة أخرى من خيارات بطاقة الذاكرة لمنح الوصول، ثم افحصه.</string>
    <string name="dom_error_sc_2002_title">المجلد لم يعد موجودًا</string>
    <string name="dom_error_sc_2002_why">نُقل المجلد أو حُذف. إذا كان على بطاقة SD، فربما أُزيلت البطاقة.</string>
    <string name="dom_error_sc_2002_action">أدخِل بطاقة SD وافحص مجددًا، أو اختر مجلدًا جديدًا من خيارات بطاقة الذاكرة.</string>
    <string name="dom_error_sc_2003_title">مجلد نظام غير معروف</string>
    <string name="dom_error_sc_2003_why">هذا المجلد داخل مجلد ROM الرئيسي لا يطابق أي نظام يعرفه PlayFieldPortal.</string>
    <string name="dom_error_sc_2003_action">أعِد تسمية المجلد إلى اسم نظام مدعوم، أو انقل ألعابه إلى مجلد مدعوم.</string>
    <string name="dom_error_sc_2004_title">لم يتم التعرّف على الملف</string>
    <string name="dom_error_sc_2004_why">نوع هذا الملف ليس من الأنواع التي تستخدمها ألعاب هذه المنصة.</string>
    <string name="dom_error_sc_2004_action">تأكّد من أن الملف لعبة لهذه المنصة. يتم تخطي الأرشيفات والتصحيحات عمدًا.</string>
    <string name="dom_error_sc_9001_title">فشل الفحص بشكل غير متوقع</string>
    <string name="dom_error_sc_9001_why">حدث خطأ غير متوقع أثناء الفحص.</string>
