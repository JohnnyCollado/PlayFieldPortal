    <!-- Error codes: title, why it happened, and what the user can do -->
    <string name="dom_error_ln_1001_title">Dieser Plattform ist kein Emulator zugewiesen</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal weiß nicht, welche App Spiele für diese Plattform ausführen soll.</string>
    <string name="dom_error_ln_1001_action">Wähle einen Emulator für diese Plattform unter Einstellungen › Emulator-Zuweisung.</string>
    <string name="dom_error_ln_1002_title">Der gewählte RetroArch-Core ist nicht installiert</string>
    <string name="dom_error_ln_1002_why">RetroArch sollte einen Core laden, der sich nicht auf diesem Gerät befindet.</string>
    <string name="dom_error_ln_1002_action">Installiere den Core über den Online-Updater von RetroArch oder wähle unter Emulator-Zuweisung einen anderen Core.</string>
    <string name="dom_error_ln_2001_title">Die Spieldatei fehlt oder ist nicht lesbar</string>
    <string name="dom_error_ln_2001_why">Die Datei wurde möglicherweise verschoben, umbenannt oder gelöscht, oder die SD-Karte mit der Datei wurde entfernt.</string>
    <string name="dom_error_ln_2001_action">Prüfe, ob die Datei noch vorhanden ist, und scanne dann ihre Memory Card neu.</string>
    <string name="dom_error_ln_4001_title">Der Emulator wurde nicht gefunden</string>
    <string name="dom_error_ln_4001_why">Der diesem Spiel zugewiesene Emulator ist nicht installiert, oder Android konnte den Bildschirm nicht finden, den PlayFieldPortal öffnet.</string>
    <string name="dom_error_ln_4001_action">Installiere den Emulator oder wähle einen anderen unter Einstellungen › Emulator-Zuweisung.</string>
    <string name="dom_error_ln_4002_title">Android hat das Öffnen des Emulators nicht erlaubt</string>
    <string name="dom_error_ln_4002_why">Android hat PlayFieldPortal die Berechtigung verweigert, diesen Emulator zu starten.</string>
    <string name="dom_error_ln_4002_action">Öffne den Emulator einmal selbst und versuche es dann erneut. Wenn es weiterhin passiert, aktualisiere den Emulator.</string>
    <string name="dom_error_ln_4003_title">Der Emulator kam nie in den Vordergrund</string>
    <string name="dom_error_ln_4003_why">Der Emulator wurde wahrscheinlich beim Start beendet, oder Android hat ihn gestoppt, bevor das Spiel laden konnte.</string>
    <string name="dom_error_ln_4003_action">Öffne den Emulator einmal selbst, um zu prüfen, ob er startet, und aktualisiere ihn, falls eine neuere Version verfügbar ist. Wenn es weiterhin passiert, wähle einen anderen Emulator unter Einstellungen › Emulator-Zuweisung.</string>
    <string name="dom_error_ln_9001_title">Der Emulator konnte nicht geöffnet werden</string>
    <string name="dom_error_ln_9001_why">Beim Starten des Emulators ist etwas Unerwartetes schiefgelaufen.</string>
    <string name="dom_error_ln_9001_action">Versuche es erneut. Wenn es weiterhin passiert, kopiere die Details und melde den Fehler.</string>
    <string name="dom_error_sc_1001_title">Für diese Memory Card ist kein Ordner festgelegt</string>
    <string name="dom_error_sc_1001_why">Diese Memory Card hat noch keinen Ort zum Scannen.</string>
    <string name="dom_error_sc_1001_action">Wähle einen Ordner in den Optionen der Memory Card und scanne ihn dann.</string>
    <string name="dom_error_sc_1002_title">Ein Scan läuft bereits</string>
    <string name="dom_error_sc_1002_why">Diese Memory Card wurde bereits gescannt, daher wurde der zweite Scan übersprungen.</string>
    <string name="dom_error_sc_1002_action">Warte, bis der laufende Scan fertig ist. Sein Ergebnis erscheint hier, sobald er abgeschlossen ist.</string>
    <string name="dom_error_sc_2001_title">Ordnerzugriff verloren</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal hat die Berechtigung zum Lesen dieses Ordners verloren.</string>
    <string name="dom_error_sc_2001_action">Wähle den Ordner erneut in den Optionen der Memory Card, damit der Zugriff erteilt wird, und scanne ihn dann.</string>
    <string name="dom_error_sc_2002_title">Der Ordner existiert nicht mehr</string>
    <string name="dom_error_sc_2002_why">Der Ordner wurde verschoben oder gelöscht. Liegt er auf einer SD-Karte, wurde die Karte möglicherweise entfernt.</string>
    <string name="dom_error_sc_2002_action">Setze die SD-Karte ein und scanne erneut, oder wähle in den Optionen der Memory Card einen neuen Ordner.</string>
    <string name="dom_error_sc_2003_title">Unbekannter Systemordner</string>
    <string name="dom_error_sc_2003_why">Dieser Ordner im Haupt-ROM-Ordner entspricht keinem System, das PlayFieldPortal kennt.</string>
    <string name="dom_error_sc_2003_action">Benenne den Ordner nach einem unterstützten Systemnamen um oder verschiebe seine Spiele in einen solchen Ordner.</string>
    <string name="dom_error_sc_2004_title">Datei nicht erkannt</string>
    <string name="dom_error_sc_2004_why">Der Typ dieser Datei wird von Spielen dieser Plattform nicht verwendet.</string>
    <string name="dom_error_sc_2004_action">Prüfe, ob die Datei ein Spiel für diese Plattform ist. Archive und Patches werden absichtlich übersprungen.</string>
    <string name="dom_error_sc_9001_title">Der Scan ist unerwartet fehlgeschlagen</string>
    <string name="dom_error_sc_9001_why">Während des Scans ist etwas Unerwartetes schiefgelaufen.</string>
    <string name="dom_error_sc_9001_action">Versuche den Scan erneut. Wenn es weiterhin passiert, kopiere die Details und melde den Fehler.</string>
    <string name="dom_error_ar_1001_title">Artwork-Ordner nicht verfügbar</string>
    <string name="dom_error_ar_1001_why">PFP kann den Artwork-Ordner nicht erreichen, daher ist neues Artwork pausiert.</string>
    <string name="dom_error_ar_1001_action">Verknüpfe den Ordner erneut unter Einstellungen › Artwork.</string>
    <string name="dom_error_ar_2001_title">Die Artwork-Datei konnte nicht gespeichert werden</string>
    <string name="dom_error_ar_2001_why">Der Speicher war voll, oder in den Artwork-Ordner konnte nicht geschrieben werden.</string>
    <string name="dom_error_ar_2001_action">Gib etwas Speicherplatz frei und versuche es erneut.</string>
    <string name="dom_error_ar_2002_title">Eine Datei konnte nicht kopiert werden</string>
    <string name="dom_error_ar_2002_why">Das Kopieren brach mittendrin ab, oder in das Ziel konnte nicht geschrieben werden.</string>
    <string name="dom_error_ar_2002_action">Prüfe, ob am Ziel genug Speicherplatz frei ist, und starte den Vorgang erneut.</string>
    <string name="dom_error_ar_2003_title">Unbekannter Systemordner im Import</string>
    <string name="dom_error_ar_2003_why">Dieser Ordner im Import entspricht keinem System, das PlayFieldPortal kennt.</string>
    <string name="dom_error_ar_2003_action">Benenne den Ordner nach einem unterstützten Systemnamen um und importiere erneut.</string>
    <string name="dom_error_ar_3001_title">Die Artwork-Quelle war nicht erreichbar</string>
    <string name="dom_error_ar_3001_why">Das Gerät ist offline, oder die Quelle hat nicht geantwortet.</string>
    <string name="dom_error_ar_3001_action">Prüfe die Verbindung und versuche es später erneut.</string>
    <string name="dom_error_ar_3002_title">Die Quelle hat die Anfrage abgelehnt</string>
    <string name="dom_error_ar_3002_why">Die Quelle begrenzt Anfragen, oder das benötigte Konto bzw. der Schlüssel wurde abgelehnt.</string>
    <string name="dom_error_ar_3002_action">Warte eine Weile und versuche es erneut, oder prüfe das Konto der Quelle in den Einstellungen.</string>
    <string name="dom_error_ar_3003_title">Für dieses Spiel wurde keine Übereinstimmung gefunden</string>
    <string name="dom_error_ar_3003_why">Die Quelle hat keinen Eintrag, der zum Titel dieses Spiels passt.</string>
    <string name="dom_error_ar_3003_action">Prüfe den Titel des Spiels oder wähle das Artwork von Hand im Artwork Studio.</string>
    <string name="dom_error_ar_9001_title">Der Abruf ist unerwartet fehlgeschlagen</string>
    <string name="dom_error_ar_9001_why">Beim Abrufen ist etwas Unerwartetes schiefgelaufen.</string>
    <string name="dom_error_ar_9001_action">Versuche es erneut. Wenn es weiterhin passiert, kopiere die Details und melde den Fehler.</string>
    <string name="dom_error_ac_1001_title">Für dieses Spiel wurde kein Errungenschaftsset gefunden</string>
    <string name="dom_error_ac_1001_why">Keiner der verbundenen Dienste hat Errungenschaften für ein Spiel mit diesem Titel.</string>
    <string name="dom_error_ac_1001_action">Ordne das Spiel auf seiner Errungenschaftsseite von Hand zu.</string>
    <string name="dom_error_ac_2001_title">Der Windows-Errungenschaftsordner kann nicht gelesen werden</string>
    <string name="dom_error_ac_2001_why">Der für die lokalen Errungenschaften dieses Spiels gewählte Ordner konnte nicht geöffnet werden.</string>
    <string name="dom_error_ac_2001_action">Wähle den Ordner des Spiels erneut auf seiner Errungenschaftsseite.</string>
    <string name="dom_error_ac_3001_title">Das Gerät ist offline</string>
    <string name="dom_error_ac_3001_why">Ohne Internetverbindung können Errungenschaften nicht aktualisiert werden.</string>
    <string name="dom_error_ac_3001_action">Verbinde dich mit dem Internet. Die Aktualisierung läuft dann von selbst erneut.</string>
    <string name="dom_error_ac_3002_title">Anmeldung abgelaufen</string>
    <string name="dom_error_ac_3002_why">Der verbundene Dienst akzeptiert die Anmeldung von PlayFieldPortal nicht mehr.</string>
    <string name="dom_error_ac_3002_action">Verbinde den Dienst erneut unter Einstellungen › Errungenschaften.</string>
    <string name="dom_error_ac_3003_title">Steam-Spieldetails sind privat</string>
    <string name="dom_error_ac_3003_why">Steam teilt Errungenschaften nur, wenn deine Spieldetails öffentlich sind.</string>
    <string name="dom_error_ac_3003_action">Stelle die Spieldetails in deinen Steam-Privatsphäre-Einstellungen auf „Öffentlich“ und aktualisiere dann erneut.</string>
    <string name="dom_error_ac_3004_title">Dieses Spiel konnte nicht aktualisiert werden</string>
    <string name="dom_error_ac_3004_why">Der Dienst hat für dieses Spiel nicht oder mit einem Fehler geantwortet.</string>
    <string name="dom_error_ac_3004_action">Versuche die Aktualisierung später erneut.</string>
    <string name="dom_error_md_2001_title">Der Medienordner kann nicht gelesen werden</string>
    <string name="dom_error_md_2001_why">PlayFieldPortal hat den Zugriff auf diesen Ordner verloren, oder er existiert nicht mehr.</string>
    <string name="dom_error_md_2001_action">Wähle den Ordner in den Medieneinstellungen erneut und scanne dann.</string>
