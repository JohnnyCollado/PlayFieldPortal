    <string name="dom_error_md_9001_action">Versuche den Scan erneut. Wenn es weiterhin passiert, kopiere die Details und melde den Fehler.</string>
    <string name="dom_error_bk_1001_title">Wiederherstellung hat ein Element übersprungen</string>
