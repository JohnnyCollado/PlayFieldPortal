    <!-- Error code LN-1001: title of the error. -->
    <string name="dom_error_ln_1001_title">Для этой платформы не назначен эмулятор</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_1001_why">PlayFieldPortal не знает, каким приложением запускать игры этой платформы.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1001_action">Выберите эмулятор для этой платформы в разделе «Настройки › Назначение эмуляторов».</string>

    <!-- Error code LN-1002: title of the error. -->
    <string name="dom_error_ln_1002_title">Выбранное ядро RetroArch не установлено</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_1002_why">RetroArch попросили загрузить ядро, которого нет на устройстве.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1002_action">Установите ядро через Online Updater в RetroArch или выберите другое ядро в разделе «Назначение эмуляторов».</string>

    <!-- Error code LN-2001: title of the error. -->
    <string name="dom_error_ln_2001_title">Файл игры отсутствует или не читается</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_2001_why">Возможно, файл перемещён, переименован или удалён либо извлечена SD-карта, на которой он хранится.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_2001_action">Проверьте, что файл на месте, затем пересканируйте его карту памяти.</string>

    <!-- Error code LN-4001: title of the error. -->
    <string name="dom_error_ln_4001_title">Эмулятор не найден</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_4001_why">Назначенный этой игре эмулятор не установлен, или Android не нашёл экран, который открывает PlayFieldPortal.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4001_action">Установите эмулятор или выберите другой в разделе «Настройки › Назначение эмуляторов».</string>

    <!-- Error code LN-4002: title of the error. -->
    <string name="dom_error_ln_4002_title">Android не разрешил открыть эмулятор</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_4002_why">Android отказал PlayFieldPortal в разрешении запустить этот эмулятор.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4002_action">Откройте эмулятор отдельно один раз и повторите попытку. Если ошибка повторяется, обновите эмулятор.</string>

    <!-- Error code LN-4003: title of the error. -->
    <string name="dom_error_ln_4003_title">Эмулятор не вышел на передний план</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_4003_why">Скорее всего, эмулятор закрылся при запуске или Android остановил его до загрузки игры.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4003_action">Откройте эмулятор отдельно и проверьте, что он запускается; обновите его, если есть новая версия. Если ошибка повторяется, выберите другой эмулятор в разделе «Настройки › Назначение эмуляторов».</string>

    <!-- Error code LN-9001: title of the error. -->
    <string name="dom_error_ln_9001_title">Не удалось открыть эмулятор</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_9001_why">При запуске эмулятора произошла непредвиденная ошибка.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_9001_action">Повторите попытку. Если ошибка повторяется, скопируйте сведения и сообщите о ней.</string>

    <!-- Error code SC-1001: title of the error. -->
    <string name="dom_error_sc_1001_title">Для этой карты памяти не задана папка</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_1001_why">Этой карте памяти пока нечего сканировать.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1001_action">Выберите папку в параметрах карты памяти и запустите сканирование.</string>

    <!-- Error code SC-1002: title of the error. -->
    <string name="dom_error_sc_1002_title">Сканирование уже идёт</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_1002_why">Эта карта памяти уже сканировалась, поэтому повторное сканирование пропущено.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1002_action">Дождитесь окончания текущего сканирования. Результат появится здесь.</string>

    <!-- Error code SC-2001: title of the error. -->
    <string name="dom_error_sc_2001_title">Доступ к папке потерян</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2001_why">PlayFieldPortal потерял разрешение на чтение этой папки.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2001_action">Выберите папку снова в параметрах карты памяти, чтобы выдать доступ, и запустите сканирование.</string>

    <!-- Error code SC-2002: title of the error. -->
    <string name="dom_error_sc_2002_title">Папка больше не существует</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2002_why">Папку переместили или удалили. Если она на SD-карте, карту могли извлечь.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2002_action">Вставьте SD-карту и повторите сканирование или выберите новую папку в параметрах карты памяти.</string>

    <!-- Error code SC-2003: title of the error. -->
    <string name="dom_error_sc_2003_title">Неизвестная папка системы</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2003_why">Эта папка в основной папке ROM не соответствует ни одной известной PlayFieldPortal системе.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2003_action">Переименуйте папку в название поддерживаемой системы или перенесите игры в такую папку.</string>

    <!-- Error code SC-2004: title of the error. -->
    <string name="dom_error_sc_2004_title">Файл не распознан</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2004_why">Игры этой платформы не используют такой тип файлов.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2004_action">Проверьте, что файл — игра для этой платформы. Архивы и патчи пропускаются намеренно.</string>

    <!-- Error code SC-9001: title of the error. -->
    <string name="dom_error_sc_9001_title">Непредвиденная ошибка сканирования</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_9001_why">Во время сканирования произошла непредвиденная ошибка.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_9001_action">Повторите сканирование. Если ошибка повторяется, скопируйте сведения и сообщите о ней.</string>

    <!-- Error code AR-1001: title of the error. -->
    <string name="dom_error_ar_1001_title">Папка обложек недоступна</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_1001_why">PFP не может получить доступ к папке обложек, поэтому новые обложки приостановлены.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_1001_action">Привяжите папку заново в разделе «Настройки › Обложки».</string>

    <!-- Error code AR-2001: title of the error. -->
    <string name="dom_error_ar_2001_title">Не удалось сохранить файл обложки</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_2001_why">Память заполнена, или в папку обложек нельзя записывать.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2001_action">Освободите место и повторите попытку.</string>

    <!-- Error code AR-2002: title of the error. -->
    <string name="dom_error_ar_2002_title">Не удалось скопировать файл</string>

    <!-- Why the error happened. -->
