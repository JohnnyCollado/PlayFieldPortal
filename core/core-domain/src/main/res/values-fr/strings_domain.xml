    <!-- Codes d'erreur -->
    <string name="dom_error_ln_1001_title">Aucun émulateur n\'est attribué à cette plateforme</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal ne sait pas quelle appli doit lancer les jeux de cette plateforme.</string>
    <string name="dom_error_ln_1001_action">Choisissez un émulateur pour cette plateforme dans Paramètres › Attribution des émulateurs.</string>
    <string name="dom_error_ln_1002_title">Le core RetroArch sélectionné n\'est pas installé</string>
    <string name="dom_error_ln_1002_why">RetroArch a dû charger un core absent de cet appareil.</string>
    <string name="dom_error_ln_1002_action">Installez le core depuis le Online Updater de RetroArch, ou choisissez un autre core dans Attribution des émulateurs.</string>
    <string name="dom_error_ln_2001_title">Le fichier du jeu est absent ou illisible</string>
    <string name="dom_error_ln_2001_why">Le fichier a peut-être été déplacé, renommé ou supprimé, ou la carte SD qui le contient a été retirée.</string>
    <string name="dom_error_ln_2001_action">Vérifiez que le fichier est toujours là, puis réanalysez sa carte mémoire.</string>
    <string name="dom_error_ln_4001_title">L\'émulateur est introuvable</string>
    <string name="dom_error_ln_4001_why">L\'émulateur attribué à ce jeu n\'est pas installé, ou Android n\'a pas trouvé l\'écran qu\'ouvre PlayFieldPortal.</string>
    <string name="dom_error_ln_4001_action">Installez l\'émulateur ou choisissez-en un autre dans Paramètres › Attribution des émulateurs.</string>
    <string name="dom_error_ln_4002_title">Android n\'a pas autorisé l\'ouverture de l\'émulateur</string>
    <string name="dom_error_ln_4002_why">Android a refusé à PlayFieldPortal l\'autorisation de démarrer cet émulateur.</string>
    <string name="dom_error_ln_4002_action">Ouvrez l\'émulateur seul une fois, puis réessayez. Si le problème persiste, mettez à jour l\'émulateur.</string>
    <string name="dom_error_ln_4003_title">L\'émulateur n\'est jamais passé au premier plan</string>
    <string name="dom_error_ln_4003_why">L\'émulateur s\'est très probablement fermé au démarrage, ou Android l\'a arrêté avant le chargement du jeu.</string>
    <string name="dom_error_ln_4003_action">Ouvrez l\'émulateur seul une fois pour vérifier qu\'il démarre, et mettez-le à jour si une version plus récente existe. Si le problème persiste, choisissez un autre émulateur dans Paramètres › Attribution des émulateurs.</string>
    <string name="dom_error_ln_9001_title">Impossible d\'ouvrir l\'émulateur</string>
    <string name="dom_error_ln_9001_why">Un problème inattendu est survenu au démarrage de l\'émulateur.</string>
    <string name="dom_error_ln_9001_action">Réessayez. Si le problème persiste, copiez les détails et signalez-le.</string>
    <string name="dom_error_sc_1001_title">Aucun dossier défini pour cette carte mémoire</string>
    <string name="dom_error_sc_1001_why">Cette carte mémoire n\'a encore aucun emplacement à analyser.</string>
    <string name="dom_error_sc_1001_action">Choisissez un dossier dans les Options de la carte mémoire, puis analysez-le.</string>
    <string name="dom_error_sc_1002_title">Une analyse est déjà en cours</string>
    <string name="dom_error_sc_1002_why">Cette carte mémoire était déjà en cours d\'analyse, la seconde analyse a donc été ignorée.</string>
    <string name="dom_error_sc_1002_action">Attendez la fin de l\'analyse en cours. Son résultat s\'affichera ici une fois terminée.</string>
    <string name="dom_error_sc_2001_title">L\'accès au dossier a été perdu</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal a perdu l\'autorisation de lire ce dossier.</string>
    <string name="dom_error_sc_2001_action">Choisissez à nouveau le dossier dans les Options de la carte mémoire pour accorder l\'accès, puis analysez-le.</string>
    <string name="dom_error_sc_2002_title">Le dossier n\'existe plus</string>
    <string name="dom_error_sc_2002_why">Le dossier a été déplacé ou supprimé. S\'il se trouve sur une carte SD, la carte a peut-être été retirée.</string>
    <string name="dom_error_sc_2002_action">Insérez la carte SD et relancez l\'analyse, ou choisissez un nouveau dossier dans les Options de la carte mémoire.</string>
    <string name="dom_error_sc_2003_title">Dossier système inconnu</string>
    <string name="dom_error_sc_2003_why">Ce dossier dans le dossier de ROM principal ne correspond à aucun système connu de PlayFieldPortal.</string>
    <string name="dom_error_sc_2003_action">Renommez le dossier avec un nom de système pris en charge, ou déplacez ses jeux dans l\'un d\'eux.</string>
    <string name="dom_error_sc_2004_title">Fichier non reconnu</string>
    <string name="dom_error_sc_2004_why">Le type de ce fichier ne fait pas partie de ceux utilisés par les jeux de cette plateforme.</string>
    <string name="dom_error_sc_2004_action">Vérifiez que le fichier est un jeu pour cette plateforme. Les archives et les patchs sont ignorés volontairement.</string>
    <string name="dom_error_sc_9001_title">L\'analyse a échoué de manière inattendue</string>
    <string name="dom_error_sc_9001_why">Un problème inattendu est survenu pendant l\'analyse.</string>
    <string name="dom_error_sc_9001_action">Relancez l\'analyse. Si le problème persiste, copiez les détails et signalez-le.</string>
    <string name="dom_error_ar_1001_title">Dossier d\'illustrations indisponible</string>
    <string name="dom_error_ar_1001_why">PFP ne peut pas accéder au dossier d\'illustrations, les nouvelles illustrations sont donc en pause.</string>
    <string name="dom_error_ar_1001_action">Liez à nouveau le dossier dans Paramètres › Illustrations.</string>
    <string name="dom_error_ar_2001_title">Impossible d\'enregistrer le fichier d\'illustration</string>
    <string name="dom_error_ar_2001_why">Le stockage était plein, ou l\'écriture dans le dossier d\'illustrations a échoué.</string>
    <string name="dom_error_ar_2001_action">Libérez de l\'espace et réessayez.</string>
    <string name="dom_error_ar_2002_title">Impossible de copier un fichier</string>
    <string name="dom_error_ar_2002_why">La copie a échoué en cours de route, ou l\'écriture vers la destination a échoué.</string>
    <string name="dom_error_ar_2002_action">Vérifiez qu\'il reste de l\'espace à la destination, puis relancez.</string>
    <string name="dom_error_ar_2003_title">Dossier système inconnu dans l\'import</string>
    <string name="dom_error_ar_2003_why">Ce dossier de l\'import ne correspond à aucun système connu de PlayFieldPortal.</string>
    <string name="dom_error_ar_2003_action">Renommez le dossier avec un nom de système pris en charge et importez à nouveau.</string>
    <string name="dom_error_ar_3001_title">Impossible de joindre la source d\'illustrations</string>
    <string name="dom_error_ar_3001_why">L\'appareil est hors ligne, ou la source n\'a pas répondu.</string>
    <string name="dom_error_ar_3001_action">Vérifiez la connexion et réessayez plus tard.</string>
    <string name="dom_error_ar_3002_title">La source a refusé la requête</string>
    <string name="dom_error_ar_3002_why">La source limite les requêtes, ou le compte ou la clé requis a été refusé.</string>
    <string name="dom_error_ar_3002_action">Patientez un moment et réessayez, ou vérifiez le compte de la source dans les Paramètres.</string>
    <string name="dom_error_ar_3003_title">Aucune correspondance trouvée pour ce jeu</string>
    <string name="dom_error_ar_3003_why">La source n\'a aucune entrée correspondant au titre de ce jeu.</string>
    <string name="dom_error_ar_3003_action">Vérifiez le titre du jeu, ou choisissez les illustrations à la main dans l\'Artwork Studio.</string>
    <string name="dom_error_ar_9001_title">La récupération a échoué de manière inattendue</string>
    <string name="dom_error_ar_9001_why">Un problème inattendu est survenu pendant la récupération.</string>
    <string name="dom_error_ar_9001_action">Réessayez. Si le problème persiste, copiez les détails et signalez-le.</string>
    <string name="dom_error_ac_1001_title">Aucun ensemble de succès ne correspond à ce jeu</string>
    <string name="dom_error_ac_1001_why">Aucun des services connectés n\'a de succès pour un jeu portant ce titre.</string>
    <string name="dom_error_ac_1001_action">Associez le jeu à la main depuis sa page de succès.</string>
    <string name="dom_error_ac_2001_title">Impossible de lire le dossier de succès Windows</string>
    <string name="dom_error_ac_2001_why">Le dossier choisi pour les succès locaux de ce jeu n\'a pas pu être ouvert.</string>
    <string name="dom_error_ac_2001_action">Choisissez à nouveau le dossier du jeu depuis sa page de succès.</string>
    <string name="dom_error_ac_3001_title">L\'appareil est hors ligne</string>
    <string name="dom_error_ac_3001_why">Les succès ne peuvent pas être mis à jour sans connexion Internet.</string>
    <string name="dom_error_ac_3001_action">Connectez-vous à Internet. La mise à jour se relancera d\'elle-même.</string>
    <string name="dom_error_ac_3002_title">Connexion expirée</string>
    <string name="dom_error_ac_3002_why">Le service connecté n\'accepte plus la connexion de PlayFieldPortal.</string>
    <string name="dom_error_ac_3002_action">Reconnectez le service dans Paramètres › Succès.</string>
    <string name="dom_error_ac_3003_title">Les détails des jeux Steam sont privés</string>
    <string name="dom_error_ac_3003_why">Steam ne partage les succès que si vos détails des jeux sont publics.</string>
    <string name="dom_error_ac_3003_action">Réglez Détails des jeux sur Public dans vos paramètres de confidentialité Steam, puis relancez la mise à jour.</string>
    <string name="dom_error_ac_3004_title">Impossible de mettre à jour ce jeu</string>
    <string name="dom_error_ac_3004_why">Le service n\'a pas répondu pour ce jeu, ou a répondu par une erreur.</string>
    <string name="dom_error_ac_3004_action">Relancez la mise à jour plus tard.</string>
    <string name="dom_error_md_2001_title">Impossible de lire le dossier de médias</string>
    <string name="dom_error_md_2001_why">PlayFieldPortal a perdu l\'accès à ce dossier, ou il n\'existe plus.</string>
    <string name="dom_error_md_2001_action">Choisissez à nouveau le dossier dans les paramètres des médias, puis lancez l\'analyse.</string>
