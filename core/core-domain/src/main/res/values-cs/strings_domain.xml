    <!-- Error codes -->
    <string name="dom_error_ln_1001_title">Této platformě není přiřazen žádný emulátor</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal neví, která aplikace má spouštět hry pro tuto platformu.</string>
    <string name="dom_error_ln_1001_action">Vyberte emulátor pro tuto platformu v Nastavení › Přiřazení emulátorů.</string>
    <string name="dom_error_ln_1002_title">Vybrané jádro RetroArch není nainstalováno</string>
    <string name="dom_error_ln_1002_why">RetroArch měl načíst jádro, které na tomto zařízení není.</string>
    <string name="dom_error_ln_1002_action">Nainstalujte jádro přes Online Updater v RetroArchu nebo vyberte jiné jádro v Přiřazení emulátorů.</string>
    <string name="dom_error_ln_2001_title">Soubor hry chybí nebo jej nelze přečíst</string>
    <string name="dom_error_ln_2001_why">Soubor mohl být přesunut, přejmenován nebo smazán, nebo byla vyjmuta SD karta, na které je.</string>
    <string name="dom_error_ln_2001_action">Zkontrolujte, zda soubor stále existuje, a znovu prohledejte jeho Paměťovou kartu.</string>
    <string name="dom_error_ln_4001_title">Emulátor nebyl nalezen</string>
    <string name="dom_error_ln_4001_why">Emulátor přiřazený této hře není nainstalován nebo Android nenašel obrazovku, kterou PlayFieldPortal otevírá.</string>
    <string name="dom_error_ln_4001_action">Nainstalujte emulátor nebo vyberte jiný v Nastavení › Přiřazení emulátorů.</string>
    <string name="dom_error_ln_4002_title">Android nepovolil otevření emulátoru</string>
    <string name="dom_error_ln_4002_why">Android odepřel aplikaci PlayFieldPortal oprávnění spustit tento emulátor.</string>
    <string name="dom_error_ln_4002_action">Jednou otevřete emulátor samostatně a zkuste to znovu. Pokud se to opakuje, aktualizujte emulátor.</string>
    <string name="dom_error_ln_4003_title">Emulátor se nikdy nedostal do popředí</string>
    <string name="dom_error_ln_4003_why">Emulátor se nejspíš při spouštění zavřel, nebo jej Android zastavil dřív, než se hra načetla.</string>
    <string name="dom_error_ln_4003_action">Jednou otevřete emulátor samostatně a ověřte, že se spustí, a aktualizujte jej, pokud je k dispozici novější verze. Pokud se to opakuje, vyberte jiný emulátor v Nastavení › Přiřazení emulátorů.</string>
    <string name="dom_error_ln_9001_title">Emulátor nelze otevřít</string>
    <string name="dom_error_ln_9001_why">Při spouštění emulátoru se stalo něco neočekávaného.</string>
    <string name="dom_error_ln_9001_action">Zkuste to znovu. Pokud se to opakuje, zkopírujte podrobnosti a nahlaste to.</string>
    <string name="dom_error_sc_1001_title">Pro tuto Paměťovou kartu není nastavena složka</string>
    <string name="dom_error_sc_1001_why">Tato Paměťová karta zatím nemá co prohledávat.</string>
    <string name="dom_error_sc_1001_action">Vyberte složku v Možnostech Paměťové karty a pak ji prohledejte.</string>
    <string name="dom_error_sc_1002_title">Prohledávání již probíhá</string>
    <string name="dom_error_sc_1002_why">Tato Paměťová karta se již prohledávala, proto bylo druhé prohledávání přeskočeno.</string>
    <string name="dom_error_sc_1002_action">Počkejte, až probíhající prohledávání skončí. Jeho výsledek se zde zobrazí po dokončení.</string>
    <string name="dom_error_sc_2001_title">Přístup ke složce byl ztracen</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal ztratil oprávnění číst tuto složku.</string>
    <string name="dom_error_sc_2001_action">Vyberte složku znovu v Možnostech Paměťové karty, aby byl udělen přístup, a pak ji prohledejte.</string>
    <string name="dom_error_sc_2002_title">Složka již neexistuje</string>
    <string name="dom_error_sc_2002_why">Složka byla přesunuta nebo smazána. Pokud je na SD kartě, karta mohla být vyjmuta.</string>
    <string name="dom_error_sc_2002_action">Vložte SD kartu a prohledejte znovu, nebo vyberte novou složku v Možnostech Paměťové karty.</string>
    <string name="dom_error_sc_2003_title">Neznámá složka systému</string>
    <string name="dom_error_sc_2003_why">Tato složka v hlavní složce ROM neodpovídá žádnému systému, který PlayFieldPortal zná.</string>
    <string name="dom_error_sc_2003_action">Přejmenujte složku na podporovaný název systému, nebo do takové složky přesuňte její hry.</string>
    <string name="dom_error_sc_2004_title">Soubor nebyl rozpoznán</string>
    <string name="dom_error_sc_2004_why">Typ tohoto souboru hry této platformy nepoužívají.</string>
    <string name="dom_error_sc_2004_action">Zkontrolujte, zda je soubor hrou pro tuto platformu. Archivy a patche se záměrně přeskakují.</string>
    <string name="dom_error_sc_9001_title">Prohledávání neočekávaně selhalo</string>
    <string name="dom_error_sc_9001_why">Během prohledávání se stalo něco neočekávaného.</string>
    <string name="dom_error_sc_9001_action">Zkuste prohledávání znovu. Pokud se to opakuje, zkopírujte podrobnosti a nahlaste to.</string>
    <string name="dom_error_ar_1001_title">Složka grafiky není dostupná</string>
    <string name="dom_error_ar_1001_why">PFP nemá přístup ke složce grafiky, proto je nová grafika pozastavena.</string>
    <string name="dom_error_ar_1001_action">Znovu propojte složku v Nastavení › Grafika.</string>
    <string name="dom_error_ar_2001_title">Soubor grafiky nelze uložit</string>
    <string name="dom_error_ar_2001_why">Úložiště bylo plné nebo do složky grafiky nelze zapisovat.</string>
    <string name="dom_error_ar_2001_action">Uvolněte místo a zkuste to znovu.</string>
    <string name="dom_error_ar_2002_title">Soubor nelze zkopírovat</string>
    <string name="dom_error_ar_2002_why">Kopírování selhalo v průběhu nebo do cíle nelze zapisovat.</string>
    <string name="dom_error_ar_2002_action">Zkontrolujte, zda je v cíli volné místo, a spusťte to znovu.</string>
    <string name="dom_error_ar_2003_title">Neznámá složka systému v importu</string>
    <string name="dom_error_ar_2003_why">Tato složka v importu neodpovídá žádnému systému, který PlayFieldPortal zná.</string>
    <string name="dom_error_ar_2003_action">Přejmenujte složku na podporovaný název systému a importujte znovu.</string>
