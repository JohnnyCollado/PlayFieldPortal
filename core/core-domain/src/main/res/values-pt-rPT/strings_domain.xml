    <!-- Error code LN-1001: title of the error. -->
    <string name="dom_error_ln_1001_title">Nenhum emulador atribuído a esta plataforma</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_1001_why">O PlayFieldPortal não sabe qual app deve executar os jogos desta plataforma.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1001_action">Escolha um emulador para esta plataforma em Definições › Atribuição de emuladores.</string>

    <!-- Error code LN-1002: title of the error. -->
    <string name="dom_error_ln_1002_title">O core do RetroArch selecionado não está instalado</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_1002_why">O RetroArch recebeu o pedido para carregar um core que não está neste dispositivo.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_1002_action">Instale o core através do Online Updater do RetroArch ou escolha outro core em Atribuição de emuladores.</string>

    <!-- Error code LN-2001: title of the error. -->
    <string name="dom_error_ln_2001_title">O ficheiro do jogo está em falta ou ilegível</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_2001_why">O ficheiro pode ter sido movido, renomeado ou eliminado, ou o cartão SD que o contém foi removido.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_2001_action">Verifique se o ficheiro ainda lá está e volte a verificar o respetivo Memory Card.</string>

    <!-- Error code LN-4001: title of the error. -->
    <string name="dom_error_ln_4001_title">O emulador não foi encontrado</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_4001_why">O emulador atribuído a este jogo não está instalado, ou o Android não encontrou o ecrã que o PlayFieldPortal abre.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4001_action">Instale o emulador ou escolha outro em Definições › Atribuição de emuladores.</string>

    <!-- Error code LN-4002: title of the error. -->
    <string name="dom_error_ln_4002_title">O Android não permitiu abrir o emulador</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_4002_why">O Android recusou ao PlayFieldPortal a permissão para iniciar este emulador.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4002_action">Abra o emulador sozinho uma vez e tente novamente. Se continuar a acontecer, atualize o emulador.</string>

    <!-- Error code LN-4003: title of the error. -->
    <string name="dom_error_ln_4003_title">O emulador não passou para primeiro plano</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_4003_why">Provavelmente o emulador fechou ao iniciar, ou o Android terminou-o antes de o jogo carregar.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_4003_action">Abra o emulador sozinho uma vez para ver se inicia e atualize-o se houver uma versão mais recente. Se continuar a acontecer, escolha outro emulador em Definições › Atribuição de emuladores.</string>

    <!-- Error code LN-9001: title of the error. -->
    <string name="dom_error_ln_9001_title">Não foi possível abrir o emulador</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ln_9001_why">Algo inesperado correu mal ao iniciar o emulador.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ln_9001_action">Tente novamente. Se continuar a acontecer, copie os detalhes e comunique o problema.</string>

    <!-- Error code SC-1001: title of the error. -->
    <string name="dom_error_sc_1001_title">Nenhuma pasta definida para este Memory Card</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_1001_why">Este Memory Card ainda não tem onde verificar.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1001_action">Escolha uma pasta nas Opções do Memory Card e verifique-a.</string>

    <!-- Error code SC-1002: title of the error. -->
    <string name="dom_error_sc_1002_title">Já há uma verificação em curso</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_1002_why">Este Memory Card já estava a ser verificado, por isso a segunda verificação foi ignorada.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_1002_action">Aguarde que a verificação em curso termine. O resultado aparece aqui quando acabar.</string>

    <!-- Error code SC-2001: title of the error. -->
    <string name="dom_error_sc_2001_title">O acesso à pasta foi perdido</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2001_why">O PlayFieldPortal perdeu a permissão de ler esta pasta.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2001_action">Escolha novamente a pasta nas Opções do Memory Card para conceder o acesso e verifique-a.</string>

    <!-- Error code SC-2002: title of the error. -->
    <string name="dom_error_sc_2002_title">A pasta já não existe</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2002_why">A pasta foi movida ou eliminada. Se estiver num cartão SD, o cartão pode ter sido removido.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2002_action">Insira o cartão SD e verifique novamente, ou escolha uma nova pasta nas Opções do Memory Card.</string>

    <!-- Error code SC-2003: title of the error. -->
    <string name="dom_error_sc_2003_title">Pasta de sistema desconhecida</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2003_why">Esta pasta dentro da pasta de ROMs principal não corresponde a um sistema que o PlayFieldPortal conhece.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2003_action">Mude o nome da pasta para o de um sistema compatível ou mova os jogos para uma dessas pastas.</string>

    <!-- Error code SC-2004: title of the error. -->
    <string name="dom_error_sc_2004_title">Ficheiro não reconhecido</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_2004_why">O tipo deste ficheiro não é um dos usados pelos jogos desta plataforma.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_2004_action">Verifique se o ficheiro é um jogo desta plataforma. Ficheiros compactados e patches são ignorados de propósito.</string>

    <!-- Error code SC-9001: title of the error. -->
    <string name="dom_error_sc_9001_title">A verificação falhou inesperadamente</string>

    <!-- Why the error happened. -->
    <string name="dom_error_sc_9001_why">Algo inesperado correu mal durante a verificação.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_sc_9001_action">Tente verificar novamente. Se continuar a acontecer, copie os detalhes e comunique o problema.</string>

    <!-- Error code AR-1001: title of the error. -->
    <string name="dom_error_ar_1001_title">Pasta de artes indisponível</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_1001_why">O PFP não consegue aceder à pasta de artes, por isso as novas artes estão em pausa.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_1001_action">Volte a associar a pasta em Definições › Artes.</string>

    <!-- Error code AR-2001: title of the error. -->
    <string name="dom_error_ar_2001_title">Não foi possível guardar o ficheiro de arte</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_2001_why">O armazenamento estava cheio ou não foi possível gravar na pasta de artes.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2001_action">Liberte espaço e tente novamente.</string>

    <!-- Error code AR-2002: title of the error. -->
    <string name="dom_error_ar_2002_title">Não foi possível copiar um ficheiro</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_2002_why">A cópia falhou a meio, ou não foi possível gravar no destino.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2002_action">Verifique se há espaço livre no destino e execute novamente.</string>

    <!-- Error code AR-2003: title of the error. -->
    <string name="dom_error_ar_2003_title">Pasta de sistema desconhecida na importação</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_2003_why">Esta pasta da importação não corresponde a um sistema que o PlayFieldPortal conhece.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_2003_action">Mude o nome da pasta para o de um sistema compatível e importe novamente.</string>

    <!-- Error code AR-3001: title of the error. -->
    <string name="dom_error_ar_3001_title">Não foi possível aceder à fonte de artes</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_3001_why">O dispositivo está offline ou a fonte não respondeu.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3001_action">Verifique a ligação e tente novamente mais tarde.</string>

    <!-- Error code AR-3002: title of the error. -->
    <string name="dom_error_ar_3002_title">A fonte recusou o pedido</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_3002_why">A fonte está a limitar os pedidos, ou a conta ou chave necessária foi recusada.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3002_action">Aguarde um pouco e tente novamente, ou verifique a conta da fonte nas Definições.</string>

    <!-- Error code AR-3003: title of the error. -->
    <string name="dom_error_ar_3003_title">Nenhuma correspondência encontrada para este jogo</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_3003_why">A fonte não tem nenhuma entrada que corresponda ao título deste jogo.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_3003_action">Verifique o título do jogo ou escolha as artes manualmente no Artwork Studio.</string>

    <!-- Error code AR-9001: title of the error. -->
    <string name="dom_error_ar_9001_title">A pesquisa falhou inesperadamente</string>

    <!-- Why the error happened. -->
    <string name="dom_error_ar_9001_why">Algo inesperado correu mal durante a pesquisa.</string>

    <!-- What the user can do about it. -->
    <string name="dom_error_ar_9001_action">Tente novamente. Se continuar a acontecer, copie os detalhes e comunique o problema.</string>

