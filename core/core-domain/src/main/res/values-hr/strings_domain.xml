    <!-- Error codes: title, why it happened, and what the user can do (docs/dev/notification-error-codes.md) -->
    <string name="dom_error_ln_1001_title">Ovoj platformi nije dodijeljen emulator</string>
    <string name="dom_error_ln_1001_why">PlayFieldPortal ne zna koja bi aplikacija trebala pokretati igre za ovu platformu.</string>
    <string name="dom_error_ln_1001_action">Odaberite emulator za ovu platformu u Postavke › Dodjela emulatora.</string>
    <string name="dom_error_ln_1002_title">Odabrana RetroArch jezgra nije instalirana</string>
    <string name="dom_error_ln_1002_why">Od RetroArcha je zatraženo učitavanje jezgre koja nije na ovom uređaju.</string>
    <string name="dom_error_ln_1002_action">Instalirajte jezgru putem RetroArchova Online Updatera ili odaberite drugu jezgru u Dodjeli emulatora.</string>
    <string name="dom_error_ln_2001_title">Datoteka igre nedostaje ili nije čitljiva</string>
    <string name="dom_error_ln_2001_why">Datoteka je možda premještena, preimenovana ili izbrisana ili je uklonjena SD kartica na kojoj se nalazi.</string>
    <string name="dom_error_ln_2001_action">Provjerite je li datoteka još uvijek tamo, a zatim ponovno skenirajte njezinu memorijsku karticu.</string>
    <string name="dom_error_ln_4001_title">Emulator nije pronađen</string>
    <string name="dom_error_ln_4001_why">Emulator dodijeljen ovoj igri nije instaliran ili Android nije pronašao zaslon koji PlayFieldPortal otvara.</string>
    <string name="dom_error_ln_4001_action">Instalirajte emulator ili odaberite drugi u Postavke › Dodjela emulatora.</string>
    <string name="dom_error_ln_4002_title">Android nije dopustio otvaranje emulatora</string>
    <string name="dom_error_ln_4002_why">Android je odbio dopuštenje PlayFieldPortalu za pokretanje ovog emulatora.</string>
    <string name="dom_error_ln_4002_action">Jednom samostalno otvorite emulator, a zatim pokušajte ponovno. Ako se to ponavlja, ažurirajte emulator.</string>
    <string name="dom_error_ln_4003_title">Emulator se nije prikazao u prvom planu</string>
    <string name="dom_error_ln_4003_why">Emulator se najvjerojatnije zatvorio pri pokretanju ili ga je Android zaustavio prije nego što se igra učitala.</string>
    <string name="dom_error_ln_4003_action">Jednom samostalno otvorite emulator kako biste provjerili pokreće li se i ažurirajte ga ako je dostupna novija verzija. Ako se to ponavlja, odaberite drugi emulator u Postavke › Dodjela emulatora.</string>
    <string name="dom_error_ln_9001_title">Emulator nije bilo moguće otvoriti</string>
    <string name="dom_error_ln_9001_why">Došlo je do neočekivane pogreške pri pokretanju emulatora.</string>
    <string name="dom_error_ln_9001_action">Pokušajte ponovno. Ako se to ponavlja, kopirajte pojedinosti i prijavite problem.</string>
    <string name="dom_error_sc_1001_title">Za ovu memorijsku karticu nije postavljena mapa</string>
    <string name="dom_error_sc_1001_why">Ova memorijska kartica još nema što skenirati.</string>
    <string name="dom_error_sc_1001_action">Odaberite mapu u Opcijama memorijske kartice, a zatim je skenirajte.</string>
    <string name="dom_error_sc_1002_title">Skeniranje je već u tijeku</string>
    <string name="dom_error_sc_1002_why">Ova se memorijska kartica već skenirala pa je drugo skeniranje preskočeno.</string>
    <string name="dom_error_sc_1002_action">Pričekajte da se trenutačno skeniranje završi. Rezultat će se prikazati ovdje kad bude gotovo.</string>
    <string name="dom_error_sc_2001_title">Pristup mapi je izgubljen</string>
    <string name="dom_error_sc_2001_why">PlayFieldPortal je izgubio dopuštenje za čitanje ove mape.</string>
    <string name="dom_error_sc_2001_action">Ponovno odaberite mapu u Opcijama memorijske kartice kako bi se dodijelio pristup, a zatim je skenirajte.</string>
    <string name="dom_error_sc_2002_title">Mapa više ne postoji</string>
    <string name="dom_error_sc_2002_why">Mapa je premještena ili izbrisana. Ako je na SD kartici, kartica je možda uklonjena.</string>
    <string name="dom_error_sc_2002_action">Umetnite SD karticu i ponovno skenirajte ili odaberite novu mapu u Opcijama memorijske kartice.</string>
    <string name="dom_error_sc_2003_title">Nepoznata mapa sustava</string>
    <string name="dom_error_sc_2003_why">Ova mapa u glavnoj mapi ROM-ova ne odgovara nijednom sustavu koji PlayFieldPortal poznaje.</string>
    <string name="dom_error_sc_2003_action">Preimenujte mapu u naziv podržanog sustava ili premjestite njezine igre u takvu mapu.</string>
    <string name="dom_error_sc_2004_title">Datoteka nije prepoznata</string>
    <string name="dom_error_sc_2004_why">Vrsta ove datoteke nije ona koju koriste igre ove platforme.</string>
    <string name="dom_error_sc_2004_action">Provjerite je li datoteka igra za ovu platformu. Arhive i zakrpe namjerno se preskaču.</string>
    <string name="dom_error_sc_9001_title">Skeniranje neočekivano nije uspjelo</string>
