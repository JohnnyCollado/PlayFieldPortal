# Auto detect text files and perform LF normalization
* text=auto

# Discord Social SDK vendored binaries — tracked via Git LFS (large, not our IP)
discord/discord-native/libs/*.aar filter=lfs diff=lfs merge=lfs -text

# Batch scripts must keep CRLF - cmd.exe mis-parses blocks/labels with LF endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Signed emulator knowledge files must stay byte-exact on every checkout (no CRLF conversion),
# so the bytes that are signed, bundled and uploaded are the same everywhere.
feature/feature-launcher/src/main/assets/emulator_kb/*.json -text
feature/feature-launcher/src/test/resources/kb_sign/** -text
*.sig -text
