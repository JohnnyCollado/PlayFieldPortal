# Android / Gradle
*.iml
.gradle
**/build/
/captures
.externalNativeBuild
.cxx

# IntelliJ / Android Studio
/.idea
*.orig

# VS Code
/.vscode
# Eclipse JDT output — the VS Code Java language server writes these per module
# (core/theme-kit/bin, studio/bin). Regenerated on demand; never build inputs.
bin/

# Local config — never commit
local.properties
keystore.properties
# Filled-in debug credentials file (template: docs/templates/pfp-debug-credentials.template.properties)
pfp-debug-credentials.properties

# Signing keys & keystores
*.jks
*.keystore

# Build artifacts
*.apk
*.aab
# Installers downloaded into the tree (JDK/SDK msi) — large and machine-specific.
*.msi
/app/release/
/dist/
/debug/

# Portable WiX v3 toolchain (wix314-binaries.zip), used by
# build-theme-studio-installer.bat so packaging needs no admin install.
# ~40MB of third-party binaries — fetched, never committed.
/tools/wix3/

# Google Services (Firebase)
google-services.json

# Heap dumps & profiling
*.hprof

# Kotlin build cache
.kotlin/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# Logs, temp files, and patch/merge leftovers
**/*.log
.env*
*.tmp
*.bak
*.rej
replay_pid*

# AI-assistant configuration and local state — kept out of version control
.claude/
.codex/
.agents/
CLAUDE.md

# Local companion tools and reference material — never committed. GSE-Generator-main
# caches a personal Steam Web API key in Tools/steam_api_key.txt, so it must stay out
# of version control.
GSE-Generator-main/
hw/
emu-pack-links/test-roms/

# Local FX clips used to test the boot sequence and GameBoot presentations. Working
# media, not app assets — the shipped GameBoot default is drawn in Compose
# (GameBootSequence) and the boot sequence's default is the PFP logo animation.
assets/FX/

# Sony PSP firmware audio: local reference only, must never be committed or shipped.
# Measurements derived from it live in assets/SFX/REFERENCE.md, which is safe to track.
assets/SFX/sony_firmware/*.wav
assets/SFX/official/*
assets/SFX/alt/*
assets/SFX/resources/*
!assets/SFX/**/*.md

# Local tool leftovers and third-party UI reference material (C21 task 0.2)
/.py
.freebuff/
assets/UI/*.zip
assets/UI/ui samples/*.jpg
assets/UI/ui samples/*.png
assets/UI/ui samples/*.webp
.acside/
/.run/
skills-lock.json
/package-lock.json
docs/feedback/

# Byte-identical copies of core/core-ui/src/main/res/raw — res/raw is the tracked copy.
assets/SFX/active/*.wav
assets/SFX/active/*.mp3