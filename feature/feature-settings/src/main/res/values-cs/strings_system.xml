    <!-- Settings ▸ Credits -->
    <string name="sets_credits_group_xmb">Design XMB — Sony</string>
    <string name="sets_credits_xmb_inspired">Vzhled a ovládání tohoto launcheru jsou inspirovány rozhraním XMB (XrossMediaBar), které Sony vytvořilo pro PlayStation Portable a PlayStation 3 — křížové uspořádání, plynoucí vlna i model navigace jsou poctou tomuto rozhraní.</string>
    <string name="sets_credits_xmb_trademarks">„XrossMediaBar“, „XMB“, „PSP“ a „PlayStation“ jsou ochranné známky společnosti Sony Interactive Entertainment Inc. Play Field Portal je nezávislý, nekomerční fanouškovský projekt — není se Sony spojen, není jí schválen ani sponzorován. Přiložená grafika rozhraní pochází z komunitního motivu „XMB Menu for ES-DE“ (uveden níže) a zůstává majetkem příslušných autorů. Žádný zvuk od Sony není přiložen: každý zvuk nabídky je uveden zvlášť níže.</string>
    <string name="sets_credits_group_icon">Ikona aplikace a logo</string>
    <string name="sets_credits_icon_designed">Ikonu a logo aplikace Play Field Portal navrhl johakovi. Velké díky za grafiku, která dává launcheru jeho identitu.</string>
    <string name="sets_credits_label_design">Design</string>
    <string name="sets_credits_group_artwork">Grafika systémů a konzolí</string>
    <string name="sets_credits_artwork_from">Ikony systémů, konzolí a kategorií použité v celém launcheru pocházejí z motivu „XMB Menu for ES-DE“ — komunitní rekreace XMB z PSP.</string>
    <string name="sets_credits_artwork_rights">Všechna práva k této grafice patří jejím tvůrcům — Anthony Caccese, navazující na původní práci InitialDin. Ikony jsou zde použity s vděčností a zůstávají majetkem příslušných autorů.</string>
    <string name="sets_credits_label_project">Projekt</string>
    <string name="sets_credits_label_authors">Autoři</string>
    <string name="sets_credits_label_source">Zdroj</string>
    <string name="sets_credits_group_buttons">Ikony tlačítek ovladače</string>
    <string name="sets_credits_buttons_from">Všechny výzvy tlačítek na obrazovce — tlačítka PlayStation, Xbox a Nintendo, D-pady, bumpery, triggery, páčky a systémová tlačítka — pocházejí z balíčků ikon tlačítek od Zacksly, použitých v rámci licence Creative Commons Attribution 3.0.</string>
    <string name="sets_credits_buttons_unmodified">Grafika není upravena: změněny byly jen názvy souborů na názvy prostředků Androidu a přiloženy jsou jen ikony, které launcher vykresluje.</string>
    <string name="sets_credits_label_author">Autor</string>
    <string name="sets_credits_label_website">Web</string>
    <string name="sets_credits_label_support">Podpora</string>
    <string name="sets_credits_label_packs">Balíčky</string>
    <string name="sets_credits_label_license">Licence</string>
    <string name="sets_credits_group_sounds">Zvuky nabídky</string>
    <string name="sets_credits_sounds_built">Přiložené zvuky nabídky — navigace, zpět, potvrzení, chyba, spuštění, oznámení a spouštěcí znělka — vznikly z bezplatného zvuku zveřejněného na Pixabay, upraveného pro launcher: zkráceného, přeladěného, vyrovnaného a převedeného. Děkujeme tvůrcům, z jejichž práce sada vychází.</string>
    <string name="sets_credits_sounds_license">Licence obsahu Pixabay uvedení autora nevyžaduje; i tak jej zde s díky uvádíme. Pokud jste jedním z těchto tvůrců a chcete změnit uvedení nebo odebrat prvek, ozvěte se prosím.</string>
    <string name="sets_credits_group_metadata">Grafika a metadata her</string>
    <string name="sets_credits_metadata_fetched">Obaly, 3D obaly, snímky cartridgí/disků, bannery hero, loga, ikony, manuály, videoukázky a metadata her se stahují na vaši žádost od poskytovatelů třetích stran a zůstávají majetkem příslušných vlastníků.</string>
    <string name="sets_credits_label_primary_scraper">Hlavní scraper</string>
    <string name="sets_credits_value_screenscraper">ScreenScraper — screenscraper.fr, komunitní databáze herních médií</string>
    <string name="sets_credits_label_artwork">Grafika</string>
    <string name="sets_credits_label_metadata">Metadata</string>
    <string name="sets_credits_group_achievements">Achievementy — Shiba Coins</string>
    <string name="sets_credits_achievements_from">Data achievementů pro systém Shiba Coins pocházejí z následujících služeb a projektů a zůstávají majetkem příslušných vlastníků.</string>
    <string name="sets_credits_value_retroachievements">retroachievements.org — komunitní sady achievementů a data o odemčení pro retro hry, přes oficiální RetroAchievements Web API a klienta api-kotlin</string>
    <string name="sets_credits_value_steam">Powered by Steam — schémata achievementů a data o odemčení přes Steam Web API s vaším vlastním klíčem. Steam a logo Steam jsou ochranné známky společnosti Valve Corporation. steampowered.com</string>
    <string name="sets_credits_goldberg_bundles">Místní sledování achievementů pro PC hry s emulací Steamu obsahuje Goldberg Steam Emulator — konkrétně gbe_fork, komunitní fork spravovaný Detanup01 a přispěvateli, navazující na původní Goldberg Emulator od Mr. Goldberga.</string>
    <string name="sets_credits_goldberg_license">Emulátor je svobodný software licencovaný pod GNU Lesser General Public License v3.0 (LGPL-3.0). Play Field Portal obsahuje neupravené sestavení jeho steam_api64.dll; kompletní odpovídající zdrojový kód a plné znění licence jsou k dispozici na odkazech níže.</string>
    <string name="sets_credits_value_gbe">gbe_fork — Detanup01 a přispěvatelé</string>
    <string name="sets_credits_label_original_project">Původní projekt</string>
    <string name="sets_credits_value_goldberg_original">Goldberg Emulator od Mr. Goldberga — gitlab.com/Mr_Goldberg/goldberg_emulator</string>
    <string name="sets_credits_group_support">Podpořte projekt</string>
    <string name="sets_credits_support_thanks">Děkuji vám všem za podporu. Vytvořil jsem to jako milostný dopis PSP a úžasné komunitě, která ji také miluje, takže tento projekt zůstane navždy zdarma. Pokud si přesto mé práce vážíte a chcete to dát najevo jinak, můžete mi koupit taco. Dary jsou samozřejmě vždy dobrovolné a nikdy povinné. Mám vás všechny rád a šťastný 15. červen.</string>
    <string name="sets_credits_label_buy_taco">Kupte mi taco</string>
    <string name="sets_credits_group_notes">Poznámky</string>
    <string name="sets_credits_notes_text">Pokud jste držitelem práv a chcete změnit uvedení autora nebo odebrat jakýkoli prvek, ozvěte se prosím a vše bude neprodleně vyřešeno.</string>
    <string name="sets_credits_title">Poděkování</string>
    <string name="sets_credits_no_browser">Žádná aplikace neumí otevřít webové odkazy. Navštivte %1$s v prohlížeči.</string>

