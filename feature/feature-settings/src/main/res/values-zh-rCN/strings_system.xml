    <!-- Settings ▸ Credits -->
    <string name="sets_credits_group_xmb">XMB 设计：Sony</string>
    <string name="sets_credits_xmb_inspired">此启动器的外观和操作感受源自 XMB（XrossMediaBar），即 Sony 为 PlayStation Portable 和 PlayStation 3 打造的界面。十字栏布局、流动的波浪以及导航方式都是对它的致敬。</string>
    <string name="sets_credits_xmb_trademarks">“XrossMediaBar”、“XMB”、“PSP”和“PlayStation”是 Sony Interactive Entertainment Inc. 的商标。Play Field Portal 是一个独立的非商业粉丝项目，与 Sony 无关联，亦未获其认可或赞助。内置的界面图片来自社区主题“XMB Menu for ES-DE”（见下方致谢），其所有权归各自作者所有。未内置任何 Sony 音频：每个菜单音效均在下方单独致谢。</string>
    <string name="sets_credits_group_icon">应用图标与标志</string>
    <string name="sets_credits_icon_designed">Play Field Portal 的应用图标和标志由 johakovi 设计。非常感谢这些赋予启动器独特形象的作品。</string>
    <string name="sets_credits_label_design">设计</string>
    <string name="sets_credits_group_artwork">系统与主机图片</string>
    <string name="sets_credits_artwork_from">此启动器中使用的系统、主机和类别图标来自“XMB Menu for ES-DE”主题，这是一个由社区重现的 PSP XMB。</string>
    <string name="sets_credits_artwork_rights">这些图片的所有权利归其创作者 Anthony Caccese 所有，其作品基于 InitialDin 的原创作品。我们怀着感激之情在此使用这些图标，其所有权仍归各自作者所有。</string>
    <string name="sets_credits_label_project">项目</string>
    <string name="sets_credits_label_authors">作者</string>
    <string name="sets_credits_label_source">来源</string>
    <string name="sets_credits_group_buttons">控制器按键图标</string>
    <string name="sets_credits_buttons_from">屏幕上的所有按键提示（PlayStation、Xbox 和 Nintendo 的功能键、方向键、肩键、扳机键、摇杆和系统键）均取自 Zacksly 的按键图标包，依据知识共享署名 3.0 许可协议使用。</string>
    <string name="sets_credits_buttons_unmodified">图片未经修改：仅将文件名改为 Android 资源名称，且只内置了启动器实际显示的图标。</string>
    <string name="sets_credits_label_author">作者</string>
    <string name="sets_credits_label_website">网站</string>
    <string name="sets_credits_label_support">支持</string>
    <string name="sets_credits_label_packs">图标包</string>
    <string name="sets_credits_label_license">许可协议</string>
    <string name="sets_credits_group_sounds">菜单音效</string>
    <string name="sets_credits_sounds_built">内置的菜单音效（导航、返回、确认、错误、启动、通知和开机提示音）基于 Pixabay 上发布的免版税音频制作，并为启动器进行了剪辑、变调、音量调整和格式转换。感谢这些作品的创作者。</string>
    <string name="sets_credits_sounds_license">Pixabay 内容许可无需署名，但我们仍在此致谢。如果你是这些创作者之一，希望更改署名或移除某个素材，请与我们联系。</string>
    <string name="sets_credits_group_metadata">游戏图片与元数据</string>
    <string name="sets_credits_metadata_fetched">封面、3D 包装盒、卡带/光盘照片、主视觉横幅、标志、图标、说明书、视频片段和游戏元数据均应你的请求从第三方服务获取，其所有权归各自所有者所有。</string>
    <string name="sets_credits_label_primary_scraper">主要抓取来源</string>
    <string name="sets_credits_value_screenscraper">ScreenScraper：screenscraper.fr，由社区维护的游戏媒体数据库</string>
    <string name="sets_credits_label_artwork">图片</string>
    <string name="sets_credits_label_metadata">元数据</string>
    <string name="sets_credits_group_achievements">成就：Shiba Coins</string>
    <string name="sets_credits_achievements_from">Shiba Coins 系统的成就数据来自以下服务和项目，其所有权归各自所有者所有。</string>
    <string name="sets_credits_value_retroachievements">retroachievements.org：由社区制作的复古游戏成就组和解锁数据，通过官方 RetroAchievements Web API 和 api-kotlin 客户端获取</string>
    <string name="sets_credits_value_steam">Powered by Steam：成就架构和解锁数据通过 Steam Web API 获取，使用你自己的密钥。Steam 和 Steam 标志是 Valve Corporation 的商标。steampowered.com</string>
    <string name="sets_credits_goldberg_bundles">针对 Steam 模拟运行的 PC 游戏，本地成就追踪内置了 Goldberg Steam Emulator，具体为 gbe_fork：由 Detanup01 及贡献者维护的社区分支，基于 Mr. Goldberg 的原版 Goldberg Emulator。</string>
    <string name="sets_credits_goldberg_license">该模拟器是依据 GNU 宽通用公共许可证 v3.0（LGPL-3.0）授权的自由软件。Play Field Portal 内置了其未经修改的 steam_api64.dll；完整的对应源代码和完整的许可证文本可通过下方链接获取。</string>
    <string name="sets_credits_value_gbe">gbe_fork：Detanup01 及贡献者</string>
    <string name="sets_credits_label_original_project">原始项目</string>
    <string name="sets_credits_value_goldberg_original">Mr. Goldberg 的 Goldberg Emulator：gitlab.com/Mr_Goldberg/goldberg_emulator</string>
    <string name="sets_credits_group_support">支持本项目</string>
    <string name="sets_credits_support_thanks">感谢大家的支持。我制作这个项目，是为了向 PSP 以及同样热爱它的出色社区致敬，因此本项目将永远免费。话虽如此，如果你认可我的工作，并想以其他方式表达心意，可以请我吃个塔可。当然，捐助始终是自愿的，绝不强求。爱你们，祝大家 6 月 15 日快乐。</string>
    <string name="sets_credits_label_buy_taco">请我吃个塔可</string>
    <string name="sets_credits_group_notes">备注</string>
    <string name="sets_credits_notes_text">如果你是权利人，希望更改署名或移除任何素材，请与我们联系，我们会尽快处理。</string>
    <string name="sets_credits_title">致谢</string>
    <string name="sets_credits_no_browser">没有可打开网页链接的应用。请在浏览器中访问 %1$s。</string>

