    <!-- Settings ▸ Credits -->
    <string name="sets_credits_group_xmb">XMB 디자인 — Sony</string>
    <string name="sets_credits_xmb_inspired">이 런처의 디자인과 사용감은 Sony가 PlayStation Portable과 PlayStation 3용으로 만든 인터페이스인 XMB(XrossMediaBar)에서 영감을 받았습니다 — 크로스바 레이아웃, 흐르는 웨이브, 탐색 방식 모두 XMB에 대한 오마주입니다.</string>
    <string name="sets_credits_xmb_trademarks">\"XrossMediaBar\", \"XMB\", \"PSP\", \"PlayStation\"은 Sony Interactive Entertainment Inc.의 상표입니다. Play Field Portal은 독립적인 비상업 팬 프로젝트이며 Sony와 제휴하거나 Sony의 보증 또는 후원을 받지 않습니다. 번들된 UI 아트워크는 커뮤니티 테마 \"XMB Menu for ES-DE\"(아래에 표기)에서 가져온 것이며 각 제작자의 소유입니다. Sony 오디오는 번들되어 있지 않으며, 모든 메뉴 사운드의 출처는 아래에 별도로 표기되어 있습니다.</string>
    <string name="sets_credits_group_icon">앱 아이콘 및 로고</string>
    <string name="sets_credits_icon_designed">Play Field Portal 앱 아이콘과 로고는 johakovi가 디자인했습니다. 런처에 정체성을 부여해 준 아트워크에 깊이 감사드립니다.</string>
    <string name="sets_credits_label_design">디자인</string>
    <string name="sets_credits_group_artwork">시스템 및 콘솔 아트워크</string>
    <string name="sets_credits_artwork_from">이 런처 전반에 사용된 시스템, 콘솔 및 카테고리 아이콘은 PSP XMB를 커뮤니티에서 재현한 \"XMB Menu for ES-DE\" 테마에서 가져왔습니다.</string>
    <string name="sets_credits_artwork_rights">이 아트워크에 대한 모든 권리는 제작자인 Anthony Caccese(InitialDin의 원작 기반)에게 있습니다. 아이콘은 감사한 마음으로 사용하고 있으며 각 제작자의 소유입니다.</string>
    <string name="sets_credits_label_project">프로젝트</string>
    <string name="sets_credits_label_authors">제작자</string>
    <string name="sets_credits_label_source">소스</string>
    <string name="sets_credits_group_buttons">컨트롤러 버튼 아이콘</string>
    <string name="sets_credits_buttons_from">화면에 표시되는 모든 버튼 안내 — PlayStation, Xbox, Nintendo 페이스 버튼, 방향 패드, 범퍼, 트리거, 스틱 및 시스템 버튼 — 는 Zacksly의 버튼 아이콘 팩을 Creative Commons Attribution 3.0 라이선스에 따라 사용했습니다.</string>
    <string name="sets_credits_buttons_unmodified">아트워크는 수정되지 않았습니다. 파일 이름만 Android 리소스 이름으로 바꾸었으며 런처에서 표시하는 아이콘만 번들되어 있습니다.</string>
    <string name="sets_credits_label_author">제작자</string>
    <string name="sets_credits_label_website">웹사이트</string>
    <string name="sets_credits_label_support">후원</string>
    <string name="sets_credits_label_packs">팩</string>
    <string name="sets_credits_label_license">라이선스</string>
    <string name="sets_credits_group_sounds">메뉴 사운드</string>
    <string name="sets_credits_sounds_built">번들된 메뉴 사운드 — 탐색, 뒤로, 확인, 오류, 실행, 알림, 부팅 차임 — 는 Pixabay에 공개된 로열티 프리 오디오를 런처용으로 편집(자르기, 음정 조정, 레벨 조정, 변환)하여 만들었습니다. 이 사운드의 바탕이 된 작품의 제작자분들께 감사드립니다.</string>
    <string name="sets_credits_sounds_license">Pixabay 콘텐츠 라이선스는 출처 표기를 요구하지 않지만 감사의 뜻으로 여기에 표기합니다. 제작자 중 한 분으로서 표기를 변경하거나 에셋을 삭제하길 원하시면 연락해 주세요.</string>
    <string name="sets_credits_group_metadata">게임 아트워크 및 메타데이터</string>
    <string name="sets_credits_metadata_fetched">박스 아트, 3D 박스, 카트리지/디스크 사진, 히어로 배너, 로고, 아이콘, 설명서, 동영상 스냅 및 게임 메타데이터는 사용자의 요청에 따라 타사 제공자에게서 가져오며 각 소유자의 소유입니다.</string>
    <string name="sets_credits_label_primary_scraper">기본 스크래퍼</string>
    <string name="sets_credits_value_screenscraper">ScreenScraper — screenscraper.fr, 커뮤니티에서 관리하는 게임 미디어 데이터베이스</string>
    <string name="sets_credits_label_artwork">아트워크</string>
    <string name="sets_credits_label_metadata">메타데이터</string>
    <string name="sets_credits_group_achievements">도전 과제 — Shiba Coins</string>
    <string name="sets_credits_achievements_from">Shiba Coins 시스템의 도전 과제 데이터는 다음 서비스 및 프로젝트에서 제공되며 각 소유자의 소유입니다.</string>
    <string name="sets_credits_value_retroachievements">retroachievements.org — 공식 RetroAchievements Web API 및 api-kotlin 클라이언트를 통한, 커뮤니티가 만든 레트로 게임용 도전 과제 세트 및 달성 데이터</string>
    <string name="sets_credits_value_steam">Powered by Steam — 본인의 키를 사용해 Steam Web API로 가져오는 도전 과제 스키마 및 달성 데이터. Steam 및 Steam 로고는 Valve Corporation의 상표입니다. steampowered.com</string>
    <string name="sets_credits_goldberg_bundles">Steam 에뮬레이션 PC 게임의 로컬 도전 과제 추적에는 Goldberg Steam Emulator가 번들되어 있습니다 — 정확히는 Mr. Goldberg의 원본 Goldberg Emulator를 바탕으로 Detanup01과 기여자들이 관리하는 커뮤니티 포크인 gbe_fork입니다.</string>
    <string name="sets_credits_goldberg_license">이 에뮬레이터는 GNU Lesser General Public License v3.0(LGPL-3.0)에 따라 배포되는 자유 소프트웨어입니다. Play Field Portal은 수정되지 않은 steam_api64.dll 빌드를 번들하며, 해당하는 전체 소스 코드와 라이선스 전문은 아래 링크에서 확인할 수 있습니다.</string>
    <string name="sets_credits_value_gbe">gbe_fork — Detanup01 및 기여자</string>
    <string name="sets_credits_label_original_project">원본 프로젝트</string>
    <string name="sets_credits_value_goldberg_original">Goldberg Emulator by Mr. Goldberg — gitlab.com/Mr_Goldberg/goldberg_emulator</string>
    <string name="sets_credits_group_support">프로젝트 후원</string>
    <string name="sets_credits_support_thanks">여러분의 응원에 감사드립니다. 이 프로젝트는 PSP와 PSP를 사랑하는 멋진 커뮤니티에 보내는 러브레터로 만들었기에 앞으로도 영원히 무료로 유지됩니다. 그래도 제 작업이 마음에 들어 다른 방식으로 감사를 표현하고 싶으시다면 타코 하나 사 주셔도 좋습니다. 물론 후원은 언제나 선택 사항이며 절대 필수가 아닙니다. 모두 사랑합니다. 6월 15일을 축하해요.</string>
    <string name="sets_credits_label_buy_taco">타코 하나 사 주기</string>
    <string name="sets_credits_group_notes">참고</string>
    <string name="sets_credits_notes_text">권리 보유자로서 표기를 변경하거나 에셋을 삭제하길 원하시면 연락해 주세요. 신속하게 처리하겠습니다.</string>
