    <!-- Settings ▸ Credits -->
    <string name="sets_credits_group_xmb">تصميم XMB — Sony</string>
    <string name="sets_credits_xmb_inspired">مظهر هذا المشغّل وأسلوبه مستوحيان من XMB (XrossMediaBar)، الواجهة التي ابتكرتها Sony لـ PlayStation Portable وPlayStation 3 — فتخطيط الشريط المتقاطع والموجة المتدفقة ونموذج التنقل كلها تحية لها.</string>
    <string name="sets_credits_xmb_trademarks">تُعد \"XrossMediaBar\" و\"XMB\" و\"PSP\" و\"PlayStation\" علامات تجارية لشركة Sony Interactive Entertainment Inc. Play Field Portal مشروع مستقل وغير تجاري من المعجبين — غير تابع لـ Sony ولا معتمد أو مموّل منها. الصور الفنية المرفقة للواجهة مأخوذة من سمة المجتمع \"XMB Menu for ES-DE\" (المذكورة أدناه) وتبقى ملكًا لمؤلفيها. لا توجد أي أصوات من Sony مرفقة: كل صوت في القائمة مذكور مصدره بشكل منفصل أدناه.</string>
    <string name="sets_credits_group_icon">أيقونة التطبيق والشعار</string>
    <string name="sets_credits_icon_designed">صمّم johakovi أيقونة تطبيق Play Field Portal وشعاره. شكرًا جزيلاً على العمل الفني الذي يمنح المشغّل هويته.</string>
    <string name="sets_credits_label_design">التصميم</string>
    <string name="sets_credits_group_artwork">الصور الفنية للأنظمة وأجهزة الألعاب</string>
    <string name="sets_credits_artwork_from">أيقونات الأنظمة وأجهزة الألعاب والفئات المستخدمة في هذا المشغّل مأخوذة من سمة \"XMB Menu for ES-DE\" — وهي إعادة إنشاء مجتمعية لـ XMB في PSP.</string>
    <string name="sets_credits_artwork_rights">جميع حقوق هذه الصور الفنية لمبدعيها — Anthony Caccese، بناءً على العمل الأصلي لـ InitialDin. تُستخدم الأيقونات هنا بامتنان وتبقى ملكًا لمؤلفيها.</string>
    <string name="sets_credits_label_project">المشروع</string>
    <string name="sets_credits_label_authors">المؤلفون</string>
    <string name="sets_credits_label_source">المصدر</string>
    <string name="sets_credits_group_buttons">أيقونات أزرار وحدة التحكم</string>
    <string name="sets_credits_buttons_from">كل تعليمات الأزرار على الشاشة — أزرار PlayStation وXbox وNintendo، ولوحات الاتجاهات، والأزرار الكتفية، والزنادات، وعصي التحكم، وأزرار النظام — مأخوذة من حزم أيقونات الأزرار الخاصة بـ Zacksly، وتُستخدم بموجب ترخيص Creative Commons Attribution 3.0.</string>
    <string name="sets_credits_buttons_unmodified">الصور الفنية غير معدّلة: تم تغيير أسماء الملفات فقط إلى أسماء موارد Android، ولم تُرفق إلا الأيقونات التي يعرضها المشغّل.</string>
    <string name="sets_credits_label_author">المؤلف</string>
    <string name="sets_credits_label_website">الموقع الإلكتروني</string>
    <string name="sets_credits_label_support">الدعم</string>
    <string name="sets_credits_label_packs">الحزم</string>
    <string name="sets_credits_label_license">الترخيص</string>
    <string name="sets_credits_group_sounds">أصوات القائمة</string>
    <string name="sets_credits_sounds_built">أصوات القائمة المرفقة — التنقل والرجوع والتأكيد والخطأ والتشغيل والإشعار ونغمة الإقلاع — مبنية من مقاطع صوتية خالية من حقوق الاستخدام منشورة على Pixabay، ومعدّلة للمشغّل: مقصوصة ومعدّلة الطبقة والمستوى ومحوّلة. شكرًا للمبدعين الذين بُنيت المجموعة من أعمالهم.</string>
    <string name="sets_credits_sounds_license">لا يشترط ترخيص محتوى Pixabay ذكر المصدر؛ لكنه مذكور هنا مع الشكر على أي حال. إذا كنت أحد هؤلاء المبدعين وتريد تغيير الإشارة أو إزالة أحد الملفات، يُرجى التواصل.</string>
    <string name="sets_credits_group_metadata">الصور الفنية والبيانات الوصفية للألعاب</string>
    <string name="sets_credits_metadata_fetched">تُجلب صور العلب والعلب ثلاثية الأبعاد وصور الخراطيش/الأقراص واللافتات الرئيسية والشعارات والأيقونات والأدلة ومقاطع الفيديو والبيانات الوصفية للألعاب بناءً على طلبك من مزوّدين خارجيين، وتبقى ملكًا لأصحابها.</string>
    <string name="sets_credits_label_primary_scraper">مصدر الجلب الأساسي</string>
    <string name="sets_credits_value_screenscraper">ScreenScraper — screenscraper.fr، قاعدة بيانات وسائط ألعاب يديرها المجتمع</string>
    <string name="sets_credits_label_artwork">الصور الفنية</string>
    <string name="sets_credits_label_metadata">البيانات الوصفية</string>
    <string name="sets_credits_group_achievements">الإنجازات — Shiba Coins</string>
    <string name="sets_credits_achievements_from">تأتي بيانات الإنجازات لنظام Shiba Coins من الخدمات والمشاريع التالية، وتبقى ملكًا لأصحابها.</string>
    <string name="sets_credits_value_retroachievements">retroachievements.org — مجموعات إنجازات وبيانات فتح يصنعها المجتمع للألعاب القديمة، عبر RetroAchievements Web API الرسمي وعميل api-kotlin</string>
    <string name="sets_credits_value_steam">Powered by Steam — مخططات الإنجازات وبيانات الفتح عبر Steam Web API، باستخدام مفتاحك الخاص. Steam وشعار Steam علامتان تجاريتان لشركة Valve Corporation. steampowered.com</string>
    <string name="sets_credits_goldberg_bundles">يتضمن التتبّع المحلي للإنجازات في ألعاب PC المحاكية لـ Steam محاكي Goldberg Steam Emulator — وتحديدًا gbe_fork، النسخة المجتمعية التي يديرها Detanup01 والمساهمون، المبنية على Goldberg Emulator الأصلي من Mr. Goldberg.</string>
    <string name="sets_credits_goldberg_license">المحاكي برنامج حر مرخّص بموجب GNU Lesser General Public License v3.0 (LGPL-3.0). يتضمن Play Field Portal إصدارًا غير معدّل من steam_api64.dll الخاص به؛ والشيفرة المصدرية المقابلة كاملة ونص الترخيص الكامل متاحان في الروابط أدناه.</string>
    <string name="sets_credits_value_gbe">gbe_fork — Detanup01 والمساهمون</string>
    <string name="sets_credits_label_original_project">المشروع الأصلي</string>
    <string name="sets_credits_value_goldberg_original">Goldberg Emulator من Mr. Goldberg — gitlab.com/Mr_Goldberg/goldberg_emulator</string>
    <string name="sets_credits_group_support">ادعم المشروع</string>
    <string name="sets_credits_support_thanks">شكرًا لكم جميعًا على دعمكم. أنشأت هذا كرسالة حب إلى PSP والمجتمع الرائع الذي يحبه أيضًا، لذا سيبقى هذا المشروع مجانيًا إلى الأبد. ومع ذلك، إن كنت تقدّر ما أفعله وتودّ التعبير عن ذلك بطريقة أخرى، يمكنك أن تشتري لي تاكو. وبالطبع، التبرعات اختيارية دائمًا وليست مطلوبة أبدًا. أحبكم جميعًا، وسعيد 15 يونيو.</string>
    <string name="sets_credits_label_buy_taco">اشترِ لي تاكو</string>
    <string name="sets_credits_group_notes">ملاحظات</string>
    <string name="sets_credits_notes_text">إذا كنت صاحب حقوق وتريد تغيير الإشارة إلى المصدر أو إزالة أي ملف، يُرجى التواصل وستتم معالجة الأمر سريعًا.</string>
    <string name="sets_credits_title">الشكر والتقدير</string>
    <string name="sets_credits_no_browser">لا يوجد تطبيق يمكنه فتح روابط الويب. زُر %1$s في متصفح.</string>

