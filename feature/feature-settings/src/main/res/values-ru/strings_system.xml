    <!-- Settings ▸ Interface ▸ Notifications -->
    <string name="sets_notif_title">Уведомления</string>
    <string name="sets_notif_record">Записывать уведомления</string>
    <string name="sets_notif_record_help">Хранить историю сканирований, обложек, загрузки данных и работы с достижениями. Если выключено, новые записи не создаются; идущие задачи по-прежнему показывают ход.</string>
    <string name="sets_notif_group_history">История</string>
    <string name="sets_notif_keep_for">Хранить записи</string>
    <string name="sets_notif_keep_for_help">Старые записи удаляются при следующей новой записи. В любом случае хранится не более 200 записей, прочитанные удаляются первыми.</string>
    <string name="sets_notif_never">Никогда</string>
