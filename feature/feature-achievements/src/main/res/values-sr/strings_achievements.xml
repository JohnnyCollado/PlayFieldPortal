    <!-- Local Steam: linking a picked game folder -->
    <!-- %1$s is the folder name -->
    <string name="ach_link_no_match">Steam нема игру која одговара називу „%1$s“. Преименујте фасциклу у назив игре на Steam-у или је прво повежите у Детаљи игре ▸ Повежи игру.</string>
    <!-- %1$s is a reason phrase from ach_ls_* -->
    <string name="ach_link_unavailable">%1$s, па ID апликације за ову фасциклу није могуће утврдити. Ништа није промењено — покушајте поново када будете на мрежи.</string>
    <string name="ach_link_marker_failed">Прављење датотеке steam_appid.txt у тој фасцикли није успело — PFP можда има само приступ за читање.</string>
    <string name="ach_link_not_recorded">Изабрано повезивање није могуће сачувати.</string>
    <string name="ach_link_installer_off">Укључите „Инсталирај Goldberg и конвертуј игре“ у подешавањима достигнућа пре него што PFP почне да уписује у фасциклу игре.</string>
    <string name="ach_link_no_app_id">Та фасцикла више не наводи ID апликације — изаберите је поново.</string>
    <string name="ach_link_need_key">Додајте свој Steam Web API кључ у Подешавања ▸ Достигнућа ▸ Акредитиви добављача — листа достигнућа долази преко њега.</string>
    <!-- %1$s is a Steam app id -->
    <string name="ach_link_no_achievements">Steam не наводи достигнућа за ID апликације %1$s, па нема шта да се прати.</string>
    <!-- %1$s is a short technical reason -->
    <string name="ach_link_kit_failed">Уписивање пакета достигнућа није успело: %1$s</string>
    <string name="ach_link_read_back_failed">Ту фасциклу није могуће поново прочитати. Ако је на преносивој меморији, поново је монтирајте и изаберите.</string>
    <string name="ach_link_not_steam_build">Нигде у тој фасцикли нема Steam библиотеке (steam_api64.dll), па то није Steam верзија и емулатор нема шта да прати. Изаберите фасциклу у којој се налази .exe датотека игре.</string>

