    <!-- Auto-Match panel for a game that is not linked yet. -->
    <string name="shiba_link_not_linked_yet_game">這款遊戲尚未連結</string>
    <string name="shiba_link_not_linked_yet">尚未連結</string>
    <string name="shiba_link_steam_body">自動配對會先詢問這是否為正版 Steam 遊戲，然後透過 Steam 解析，或掃描你的遊戲資料夾以尋找 Steam 模擬器資料。</string>
    <string name="shiba_link_retro_body">RetroAchievements 透過 ROM 雜湊值辨識遊戲。自動配對會計算這個 ROM 的雜湊值並進行查詢，只有在 RetroAchievements 上登錄的已驗證傾印檔才能連結。</string>
    <string name="shiba_link_local_steam_body">選擇這款遊戲的資料夾，PFP 會讀取其 Steam App ID：若有 steam_appid.txt 就從中讀取，若沒有則比對標題。它會記住這個資料夾，之後就不必再搜尋。</string>
    <string name="shiba_link_vita_body">PS Vita 獎盃會從 Vita3K 自動連結。請在收藏庫中設定你的 Vita3K 資料資料夾並掃描，即可連結這款遊戲。</string>
    <string name="shiba_link_ps3_body">PS3 獎盃會從遊戲本身的光碟連結。請在收藏庫中設定你的 PS3 資料資料夾，然後執行自動配對。</string>
    <string name="shiba_link_x360_body">Xbox 360 成就會從遊戲本身的 Title ID 連結。請在收藏庫中設定 X360 Mobile 或 XenDroid 資料資料夾，然後執行自動配對。</string>
    <string name="shiba_link_auto_match">自動配對</string>
    <string name="shiba_link_matching">正在配對…</string>
    <string name="shiba_link_pick_game_folder">選擇遊戲資料夾</string>
    <string name="shiba_link_copy_title">這是正版 Steam 遊戲嗎？</string>
    <string name="shiba_link_copy_body">正版遊戲會與你的 Steam 帳戶配對。其他情況則會從遊戲本身的資料夾追蹤，PFP 會請你指定該資料夾。</string>
    <string name="shiba_link_folder_title">這款遊戲在哪個資料夾中？</string>
    <string name="shiba_link_folder_body">請選擇遊戲本身的資料夾，也就是 .exe 所在的資料夾。PFP 會從中讀取 Steam App ID，並追蹤模擬器寫入其中的解鎖記錄。你的 Windows 遊戲可以放在任何位置；PFP 會記住這款遊戲的位置，之後就不必再搜尋。</string>
    <string name="shiba_link_identify_title_steam">正在尋找 Steam 配對…</string>
    <string name="shiba_link_identify_title_appid">正在判斷 Steam App ID…</string>
    <string name="shiba_link_identify_body_steam">正在 Steam 上搜尋這款遊戲的標題。選擇正確的項目即可重新連結。</string>
    <string name="shiba_link_identify_body_appid">正在從資料夾讀取 steam_appid.txt；若尚無該檔案，則以遊戲標題比對 Steam。</string>
    <string name="shiba_link_kit_title">該資料夾還沒有成就清單</string>
    <string name="shiba_link_kit_body_generic">模擬器需要成就清單才能記錄解鎖。</string>
    <string name="shiba_link_kit_body">「%1$s」的 Steam App ID 為 %2$s，但模擬器沒有可用來記錄的成就清單。「安裝並連結」會在資料夾中寫入 achievements.json、stats.json 和 configs.user.ini，建立 saves 資料夾，並將 steam_api64.dll 重新命名為 steam_api64_o.dll，讓內附的模擬器透過它載入；請先備份這款遊戲的存檔。「僅連結」會以 0%% 開始追蹤，不會寫入任何其他內容。</string>
    <string name="shiba_link_kit_installer_off">「安裝並連結」需要在成就設定中開啟「安裝 Goldberg 並轉換遊戲」。</string>
    <string name="shiba_link_kit_install">安裝並連結</string>
    <string name="shiba_link_kit_link_only">僅連結</string>
    <string name="shiba_link_no_emu_title">該資料夾中沒有可追蹤的內容</string>
    <string name="shiba_link_no_emu_default">該資料夾中沒有 Steam 模擬器資料。</string>
    <string name="shiba_link_try_another_folder">嘗試其他資料夾</string>
    <string name="shiba_link_appid_title">找不到自動配對</string>
    <string name="shiba_link_appid_body">請輸入遊戲的 Steam App ID：</string>
    <string name="shiba_link_appid_field">Steam App ID</string>

