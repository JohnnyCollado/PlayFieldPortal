    <!-- Auto-Match panel for a game that is not linked yet. -->
    <string name="shiba_link_not_linked_yet_game">Questo gioco non è ancora collegato</string>
    <string name="shiba_link_not_linked_yet">Non ancora collegato</string>
    <string name="shiba_link_steam_body">L\'abbinamento automatico chiede se questa è una copia Steam legittima, poi la abbina su Steam oppure cerca nelle cartelle dei tuoi giochi i dati dell\'emulatore Steam.</string>
    <string name="shiba_link_retro_body">RetroAchievements identifica i giochi tramite l\'hash della ROM. L\'abbinamento automatico calcola l\'hash di questa ROM e lo cerca: si può collegare solo un dump verificato registrato su RetroAchievements.</string>
    <string name="shiba_link_local_steam_body">Scegli la cartella di questo gioco e PFP ne legge l\'app id Steam: da steam_appid.txt se c\'è, altrimenti abbinando il titolo. La cartella viene memorizzata, quindi non dovrà più essere cercata.</string>
    <string name="shiba_link_vita_body">I trofei PS Vita si collegano automaticamente da Vita3K. Imposta la cartella dati di Vita3K nella libreria ed esegui la scansione per collegare questo gioco.</string>
    <string name="shiba_link_ps3_body">I trofei PS3 si collegano dal disco del gioco: imposta la cartella dati PS3 nella libreria e usa Abbinamento automatico.</string>
    <string name="shiba_link_x360_body">Gli achievement Xbox 360 si collegano dal title ID del gioco: imposta la cartella dati di X360 Mobile o XenDroid nella libreria e usa Abbinamento automatico.</string>
    <string name="shiba_link_auto_match">Abbinamento automatico</string>
    <string name="shiba_link_matching">Abbinamento…</string>
    <string name="shiba_link_pick_game_folder">Scegli cartella gioco</string>

    <string name="shiba_link_copy_title">È una copia Steam legittima?</string>
    <string name="shiba_link_copy_body">Una copia legittima viene abbinata al tuo account Steam. Tutto il resto viene monitorato dalla cartella del gioco, che PFP ti chiederà di indicare.</string>

    <string name="shiba_link_folder_title">In quale cartella si trova questo gioco?</string>
    <string name="shiba_link_folder_body">Scegli la cartella del gioco, quella in cui si trova il suo .exe. PFP vi legge l\'app id Steam e monitora gli sblocchi che l\'emulatore scrive lì. I tuoi giochi Windows possono trovarsi ovunque; PFP ricorda dove si trova questo, così non dovrà mai cercarlo.</string>

    <string name="shiba_link_identify_title_steam">Ricerca della corrispondenza Steam…</string>
    <string name="shiba_link_identify_title_appid">Determinazione dell\'app id Steam…</string>
    <string name="shiba_link_identify_body_steam">Ricerca del titolo di questo gioco su Steam. Scegli quello giusto per collegarlo di nuovo.</string>
    <string name="shiba_link_identify_body_appid">Lettura di steam_appid.txt dalla cartella e, se non c\'è ancora, abbinamento del titolo del gioco su Steam.</string>

    <string name="shiba_link_kit_title">Quella cartella non ha ancora un elenco achievement</string>
    <string name="shiba_link_kit_body_generic">L\'emulatore ha bisogno di un elenco achievement prima di poter registrare gli sblocchi.</string>
    <string name="shiba_link_kit_body">\"%1$s\" ha l\'app id Steam %2$s, ma l\'emulatore non ha un elenco achievement su cui registrare. Installa e collega scrive achievements.json, stats.json e configs.user.ini nella cartella, crea una cartella saves e rinomina steam_api64.dll in steam_api64_o.dll così l\'emulatore incluso si carica attraverso di essa: prima fai un backup dei salvataggi di questo gioco. Solo collega lo monitora allo 0%% e non scrive nient\'altro.</string>
    <string name="shiba_link_kit_installer_off">Installa e collega richiede l\'opzione Installa Goldberg e converti giochi nelle impostazioni Achievement.</string>
    <string name="shiba_link_kit_install">Installa e collega</string>
    <string name="shiba_link_kit_link_only">Solo collega</string>

    <string name="shiba_link_no_emu_title">Niente da monitorare in quella cartella</string>
    <string name="shiba_link_no_emu_default">Quella cartella non contiene dati dell\'emulatore Steam.</string>
    <string name="shiba_link_try_another_folder">Prova un\'altra cartella</string>

    <string name="shiba_link_appid_title">Nessun abbinamento automatico trovato</string>
