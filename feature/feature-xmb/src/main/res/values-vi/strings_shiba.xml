    <!-- Auto-Match panel for a game that is not linked yet. -->
    <string name="shiba_link_not_linked_yet_game">Trò chơi này chưa được liên kết</string>
    <string name="shiba_link_not_linked_yet">Chưa liên kết</string>
    <string name="shiba_link_steam_body">Tự động khớp sẽ hỏi đây có phải bản Steam hợp lệ không, rồi đối chiếu với Steam hoặc quét các thư mục trò chơi để tìm dữ liệu Steam-emu.</string>
    <string name="shiba_link_retro_body">RetroAchievements nhận diện trò chơi bằng mã băm ROM. Tự động khớp sẽ băm ROM này rồi tra cứu — chỉ bản dump đã xác minh và được đăng ký trên RetroAchievements mới liên kết được.</string>
    <string name="shiba_link_local_steam_body">Chọn thư mục của trò chơi này và PFP sẽ đọc Steam app id — từ steam_appid.txt nếu có, hoặc bằng cách khớp tiêu đề nếu không. PFP ghi nhớ thư mục, nên không cần tìm lại.</string>
    <string name="shiba_link_vita_body">Cúp PS Vita tự động liên kết từ Vita3K. Hãy đặt thư mục dữ liệu Vita3K trong thư viện và quét để liên kết trò chơi này.</string>
    <string name="shiba_link_ps3_body">Cúp PS3 liên kết từ chính đĩa của trò chơi — hãy đặt Thư mục dữ liệu PS3 trong thư viện rồi dùng Tự động khớp.</string>
    <string name="shiba_link_x360_body">Thành tựu Xbox 360 liên kết từ title ID của trò chơi — hãy đặt Thư mục dữ liệu X360 Mobile hoặc XenDroid trong thư viện rồi dùng Tự động khớp.</string>
    <string name="shiba_link_auto_match">Tự động khớp</string>
    <string name="shiba_link_matching">Đang khớp…</string>
    <string name="shiba_link_pick_game_folder">Chọn thư mục trò chơi</string>

    <string name="shiba_link_copy_title">Đây có phải bản Steam hợp lệ không?</string>
    <string name="shiba_link_copy_body">Bản hợp lệ sẽ được đối chiếu với tài khoản Steam của bạn. Mọi bản khác được theo dõi từ thư mục của trò chơi, PFP sẽ yêu cầu bạn chỉ ra thư mục đó.</string>

    <string name="shiba_link_folder_title">Trò chơi này nằm trong thư mục nào?</string>
    <string name="shiba_link_folder_body">Hãy chọn thư mục của trò chơi — thư mục chứa tệp .exe. PFP đọc Steam app id từ đó và theo dõi các thành tựu mà trình giả lập ghi vào đó. Trò chơi Windows của bạn có thể nằm ở bất kỳ đâu; PFP ghi nhớ vị trí của trò chơi này để không bao giờ phải tìm lại.</string>

    <string name="shiba_link_identify_title_steam">Đang tìm kết quả khớp trên Steam…</string>
    <string name="shiba_link_identify_title_appid">Đang xác định Steam app id…</string>
    <string name="shiba_link_identify_body_steam">Đang tìm tiêu đề trò chơi này trên Steam. Hãy chọn đúng kết quả để liên kết lại.</string>
    <string name="shiba_link_identify_body_appid">Đang đọc steam_appid.txt từ thư mục và khớp tiêu đề trò chơi với Steam nếu chưa có.</string>

    <string name="shiba_link_kit_title">Thư mục đó chưa có danh sách thành tựu</string>
    <string name="shiba_link_kit_body_generic">Trình giả lập cần danh sách thành tựu trước khi có thể ghi nhận mở khóa.</string>
    <string name="shiba_link_kit_body">\"%1$s\" là Steam app id %2$s, nhưng trình giả lập chưa có danh sách thành tựu để ghi nhận. Cài &amp; liên kết sẽ ghi achievements.json, stats.json và configs.user.ini vào thư mục, tạo thư mục saves và đổi tên steam_api64.dll thành steam_api64_o.dll để trình giả lập đi kèm tải qua nó — hãy sao lưu dữ liệu lưu của trò chơi này trước. Chỉ liên kết sẽ theo dõi ở mức 0%% và không ghi thêm gì.</string>
    <string name="shiba_link_kit_installer_off">Cài &amp; liên kết cần bật Cài Goldberg &amp; chuyển đổi trò chơi trong cài đặt Thành tựu.</string>
    <string name="shiba_link_kit_install">Cài &amp; liên kết</string>
    <string name="shiba_link_kit_link_only">Chỉ liên kết</string>

