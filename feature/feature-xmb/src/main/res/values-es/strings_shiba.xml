    <!-- Auto-Match panel -->
    <string name="shiba_link_not_linked_yet_game">Este juego aún no está vinculado</string>
    <string name="shiba_link_not_linked_yet">Aún sin vincular</string>
    <string name="shiba_link_steam_body">Asociar automáticamente pregunta si es una copia legítima de Steam y luego la resuelve con Steam o busca en tus carpetas de juegos datos de emulación de Steam.</string>
    <string name="shiba_link_retro_body">RetroAchievements identifica los juegos por el hash de la ROM. Asociar automáticamente calcula el hash de esta ROM y lo busca: solo se puede vincular un volcado verificado registrado en RetroAchievements.</string>
    <string name="shiba_link_local_steam_body">Elige la carpeta de este juego y PFP leerá su app id de Steam: de steam_appid.txt si está, o asociando el título si no. Recuerda la carpeta, así que no hay que volver a buscarla.</string>
    <string name="shiba_link_vita_body">Los trofeos de PS Vita se vinculan automáticamente desde Vita3K. Establece tu carpeta de datos de Vita3K en la biblioteca y escanea para vincular este juego.</string>
    <string name="shiba_link_ps3_body">Los trofeos de PS3 se vinculan desde el propio disco del juego: establece tu carpeta de datos de PS3 en la biblioteca y usa Asociar automáticamente.</string>
    <string name="shiba_link_x360_body">Los logros de Xbox 360 se vinculan desde el propio ID de título del juego: establece la carpeta de datos de X360 Mobile o XenDroid en la biblioteca y usa Asociar automáticamente.</string>
    <string name="shiba_link_auto_match">Asociar automáticamente</string>
    <string name="shiba_link_matching">Asociando…</string>
    <string name="shiba_link_pick_game_folder">Elegir carpeta del juego</string>

    <string name="shiba_link_copy_title">¿Es una copia legítima de Steam?</string>
    <string name="shiba_link_copy_body">Una copia legítima se asocia con tu cuenta de Steam. Cualquier otra se sigue desde la propia carpeta del juego, que PFP te pedirá que indiques.</string>

    <string name="shiba_link_folder_title">¿En qué carpeta está este juego?</string>
    <string name="shiba_link_folder_body">Elige la carpeta del propio juego, la que contiene su .exe. PFP lee de ella el app id de Steam y sigue los desbloqueos que el emulador escribe allí. Tus juegos de Windows pueden estar en cualquier sitio; PFP recuerda dónde está este para no tener que buscarlo nunca.</string>

    <string name="shiba_link_identify_title_steam">Buscando la coincidencia en Steam…</string>
    <string name="shiba_link_identify_title_appid">Averiguando el app id de Steam…</string>
    <string name="shiba_link_identify_body_steam">Buscando en Steam el título de este juego. Elige el correcto para volver a vincularlo.</string>
    <string name="shiba_link_identify_body_appid">Leyendo steam_appid.txt de la carpeta y, si aún no lo tiene, asociando el título del juego con Steam.</string>

    <string name="shiba_link_kit_title">Esa carpeta aún no tiene lista de logros</string>
    <string name="shiba_link_kit_body_generic">El emulador necesita una lista de logros antes de poder registrar desbloqueos.</string>
    <string name="shiba_link_kit_body">\"%1$s\" es el app id de Steam %2$s, pero el emulador no tiene lista de logros con la que registrar. Instalar y vincular escribe achievements.json, stats.json y configs.user.ini en la carpeta, crea una carpeta saves y renombra steam_api64.dll a steam_api64_o.dll para que el emulador incluido se cargue a través de ella: haz antes una copia de las partidas de este juego. Solo vincular lo sigue al 0%% y no escribe nada más.</string>
    <string name="shiba_link_kit_installer_off">Instalar y vincular necesita Instalar Goldberg y convertir juegos en los ajustes de Logros.</string>
    <string name="shiba_link_kit_install">Instalar y vincular</string>
    <string name="shiba_link_kit_link_only">Solo vincular</string>

    <string name="shiba_link_no_emu_title">No hay nada que seguir en esa carpeta</string>
    <string name="shiba_link_no_emu_default">Esa carpeta no contiene datos de emulador de Steam.</string>
    <string name="shiba_link_try_another_folder">Probar otra carpeta</string>

    <string name="shiba_link_appid_title">No se encontró ninguna coincidencia automática</string>
    <string name="shiba_link_appid_body">Introduce el app id de Steam del juego:</string>
