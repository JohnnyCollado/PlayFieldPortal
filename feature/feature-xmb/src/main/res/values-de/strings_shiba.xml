    <!-- Auto-Match panel for a game that is not linked yet. -->
    <string name="shiba_link_not_linked_yet_game">Dieses Spiel ist noch nicht verknüpft</string>
    <string name="shiba_link_not_linked_yet">Noch nicht verknüpft</string>
    <string name="shiba_link_steam_body">Die Auto-Zuordnung fragt, ob dies eine legitime Steam-Kopie ist, und gleicht sie dann mit Steam ab oder durchsucht deine Spielordner nach Steam-Emu-Daten.</string>
    <string name="shiba_link_retro_body">RetroAchievements erkennt Spiele am ROM-Hash. Die Auto-Zuordnung berechnet den Hash dieses ROMs und schlägt ihn nach – nur ein verifizierter, bei RetroAchievements registrierter Dump kann verknüpft werden.</string>
    <string name="shiba_link_local_steam_body">Wähle den Ordner dieses Spiels, und PFP liest seine Steam-App-ID – aus steam_appid.txt, wenn vorhanden, sonst über den Titel. Der Ordner wird gemerkt, damit nichts erneut danach suchen muss.</string>
    <string name="shiba_link_vita_body">PS-Vita-Trophäen werden automatisch aus Vita3K verknüpft. Lege deinen Vita3K-Datenordner in der Bibliothek fest und scanne, um dieses Spiel zu verknüpfen.</string>
    <string name="shiba_link_ps3_body">PS3-Trophäen werden über die Disc des Spiels verknüpft – lege deinen PS3-Datenordner in der Bibliothek fest und starte die Auto-Zuordnung.</string>
    <string name="shiba_link_x360_body">Xbox-360-Errungenschaften werden über die Titel-ID des Spiels verknüpft – lege den Datenordner von X360 Mobile oder XenDroid in der Bibliothek fest und starte die Auto-Zuordnung.</string>
    <string name="shiba_link_auto_match">Auto-Zuordnung</string>
    <string name="shiba_link_matching">Wird zugeordnet…</string>
    <string name="shiba_link_pick_game_folder">Spielordner wählen</string>

    <string name="shiba_link_copy_title">Ist dies eine legitime Steam-Kopie?</string>
    <string name="shiba_link_copy_body">Eine legitime Kopie wird mit deinem Steam-Konto abgeglichen. Alles andere wird über den eigenen Ordner des Spiels verfolgt, den PFP dich auswählen lässt.</string>

    <string name="shiba_link_folder_title">In welchem Ordner liegt dieses Spiel?</string>
    <string name="shiba_link_folder_body">Wähle den eigenen Ordner des Spiels – den, in dem seine .exe liegt. PFP liest daraus die Steam-App-ID und verfolgt die Freischaltungen, die der Emulator dort schreibt. Deine Windows-Spiele können überall liegen; PFP merkt sich, wo dieses ist, und muss nie suchen.</string>

    <string name="shiba_link_identify_title_steam">Steam-Zuordnung wird gesucht…</string>
    <string name="shiba_link_identify_title_appid">Steam-App-ID wird ermittelt…</string>
    <string name="shiba_link_identify_body_steam">Steam wird nach dem Titel dieses Spiels durchsucht. Wähle das richtige, um es erneut zu verknüpfen.</string>
    <string name="shiba_link_identify_body_appid">steam_appid.txt wird aus dem Ordner gelesen, und falls keine vorhanden ist, wird der Titel des Spiels mit Steam abgeglichen.</string>

    <string name="shiba_link_kit_title">Dieser Ordner hat noch keine Errungenschaftsliste</string>
    <string name="shiba_link_kit_body_generic">Der Emulator braucht eine Errungenschaftsliste, bevor er Freischaltungen erfassen kann.</string>
    <string name="shiba_link_kit_body">\"%1$s\" hat die Steam-App-ID %2$s, aber der Emulator hat keine Errungenschaftsliste zum Erfassen. „Installieren &amp; verknüpfen“ schreibt achievements.json, stats.json und configs.user.ini in den Ordner, legt einen saves-Ordner an und benennt steam_api64.dll in steam_api64_o.dll um, damit der mitgelieferte Emulator darüber lädt – sichere zuerst die Spielstände dieses Spiels. „Nur verknüpfen“ verfolgt es mit 0%% und schreibt nichts weiter.</string>
    <string name="shiba_link_kit_installer_off">„Installieren &amp; verknüpfen“ erfordert „Goldberg installieren &amp; Spiele konvertieren“ in den Errungenschafts-Einstellungen.</string>
    <string name="shiba_link_kit_install">Installieren &amp; verknüpfen</string>
    <string name="shiba_link_kit_link_only">Nur verknüpfen</string>

    <string name="shiba_link_no_emu_title">In diesem Ordner gibt es nichts zu verfolgen</string>
    <string name="shiba_link_no_emu_default">Dieser Ordner enthält keine Steam-Emulator-Daten.</string>
    <string name="shiba_link_try_another_folder">Anderen Ordner versuchen</string>

    <string name="shiba_link_appid_title">Keine automatische Zuordnung gefunden</string>
    <string name="shiba_link_appid_body">Gib die Steam-App-ID des Spiels ein:</string>
    <string name="shiba_link_appid_field">Steam-App-ID</string>

