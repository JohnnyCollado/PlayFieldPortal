    <!-- Auto-Match panel for a game that is not linked yet. -->
    <string name="shiba_link_not_linked_yet_game">هذه اللعبة غير مرتبطة بعد</string>
    <string name="shiba_link_not_linked_yet">غير مرتبطة بعد</string>
    <string name="shiba_link_steam_body">تسأل المطابقة التلقائية ما إذا كانت هذه نسخة Steam أصلية، ثم تطابقها مع Steam أو تفحص مجلدات ألعابك بحثًا عن بيانات محاكي Steam.</string>
    <string name="shiba_link_retro_body">يتعرّف RetroAchievements على الألعاب ببصمة ROM. تحسب المطابقة التلقائية بصمة هذه ROM وتبحث عنها — ولا يمكن ربط سوى نسخة موثّقة مسجّلة على RetroAchievements.</string>
    <string name="shiba_link_local_steam_body">اختر مجلد هذه اللعبة وسيقرأ PFP معرّف تطبيق Steam الخاص بها — من steam_appid.txt إن وُجد، أو بمطابقة العنوان إن لم يوجد. ويتذكّر المجلد، فلا حاجة إلى البحث عنه مجددًا.</string>
    <string name="shiba_link_vita_body">تُربط جوائز PS Vita تلقائيًا من Vita3K. عيّن مجلد بيانات Vita3K في المكتبة وافحص لربط هذه اللعبة.</string>
    <string name="shiba_link_ps3_body">تُربط جوائز PS3 من قرص اللعبة نفسه — عيّن مجلد بيانات PS3 في المكتبة واستخدم المطابقة التلقائية.</string>
    <string name="shiba_link_x360_body">تُربط إنجازات Xbox 360 من معرّف عنوان اللعبة نفسها — عيّن مجلد بيانات X360 Mobile أو XenDroid في المكتبة واستخدم المطابقة التلقائية.</string>
    <string name="shiba_link_auto_match">مطابقة تلقائية</string>
    <string name="shiba_link_matching">جارٍ المطابقة…</string>
    <string name="shiba_link_pick_game_folder">اختيار مجلد اللعبة</string>

    <string name="shiba_link_copy_title">هل هذه نسخة Steam أصلية؟</string>
    <string name="shiba_link_copy_body">تُطابَق النسخة الأصلية مع حسابك على Steam. وأي نسخة أخرى تُتتبَّع من مجلد اللعبة نفسه، الذي سيطلب منك PFP الإشارة إليه.</string>

    <string name="shiba_link_folder_title">في أي مجلد توجد هذه اللعبة؟</string>
    <string name="shiba_link_folder_body">اختر مجلد اللعبة نفسه — الذي يوجد فيه ملف .exe. يقرأ PFP منه معرّف تطبيق Steam ويتتبّع ما يكتبه المحاكي من إنجازات مفتوحة. يمكن أن توجد ألعاب Windows في أي مكان؛ ويتذكّر PFP مكان هذه اللعبة فلا يحتاج إلى البحث عنها أبدًا.</string>

    <string name="shiba_link_identify_title_steam">جارٍ البحث عن المطابقة في Steam…</string>
    <string name="shiba_link_identify_title_appid">جارٍ تحديد معرّف تطبيق Steam…</string>
    <string name="shiba_link_identify_body_steam">جارٍ البحث في Steam عن عنوان هذه اللعبة. اختر اللعبة الصحيحة لربطها مجددًا.</string>
    <string name="shiba_link_identify_body_appid">جارٍ قراءة steam_appid.txt من المجلد، ومطابقة عنوان اللعبة مع Steam إن لم يكن موجودًا بعد.</string>

    <string name="shiba_link_kit_title">لا يحتوي ذلك المجلد على قائمة إنجازات بعد</string>
    <string name="shiba_link_kit_body_generic">يحتاج المحاكي إلى قائمة إنجازات قبل أن يتمكن من تسجيل ما يُفتح منها.</string>
    <string name="shiba_link_kit_body">\"%1$s\" هو تطبيق Steam بالمعرّف %2$s، لكن المحاكي ليس لديه قائمة إنجازات للتسجيل عليها. «التثبيت والربط» يكتب achievements.json وstats.json وconfigs.user.ini في المجلد، وينشئ مجلد saves، ويعيد تسمية steam_api64.dll إلى steam_api64_o.dll ليُحمَّل المحاكي المرفق من خلاله — انسخ ملفات حفظ هذه اللعبة احتياطيًا أولاً. «الربط فقط» يتتبّعها عند 0%% ولا يكتب أي شيء آخر.</string>
    <string name="shiba_link_kit_installer_off">يحتاج «التثبيت والربط» إلى تفعيل «تثبيت Goldberg وتحويل الألعاب» في إعدادات الإنجازات.</string>
    <string name="shiba_link_kit_install">التثبيت والربط</string>
    <string name="shiba_link_kit_link_only">الربط فقط</string>

