    <!-- Auto-Match panel -->
    <string name="shiba_link_not_linked_yet_game">Ta gra nie jest jeszcze połączona</string>
    <string name="shiba_link_not_linked_yet">Jeszcze niepołączona</string>
    <string name="shiba_link_steam_body">Automatyczne dopasowanie pyta, czy to legalna kopia ze Steam, a potem dopasowuje ją przez Steam lub skanuje foldery gier w poszukiwaniu danych emulatora Steam.</string>
    <string name="shiba_link_retro_body">RetroAchievements rozpoznaje gry po skrócie ROM-u. Automatyczne dopasowanie oblicza skrót tego ROM-u i go wyszukuje — połączyć można tylko zweryfikowany zrzut zarejestrowany w RetroAchievements.</string>
    <string name="shiba_link_local_steam_body">Wybierz folder tej gry, a PFP odczyta jej Steam app id — z steam_appid.txt, jeśli istnieje, lub przez dopasowanie tytułu, jeśli go nie ma. Folder zostanie zapamiętany, więc nie trzeba będzie go ponownie szukać.</string>
    <string name="shiba_link_vita_body">Trofea PS Vita łączą się automatycznie z Vita3K. Ustaw folder danych Vita3K w bibliotece i przeskanuj, aby połączyć tę grę.</string>
    <string name="shiba_link_ps3_body">Trofea PS3 łączą się z płyty samej gry — ustaw folder danych PS3 w bibliotece i użyj automatycznego dopasowania.</string>
    <string name="shiba_link_x360_body">Osiągnięcia Xbox 360 łączą się przez Title ID gry — ustaw folder danych X360 Mobile lub XenDroid w bibliotece i użyj automatycznego dopasowania.</string>
    <string name="shiba_link_auto_match">Dopasuj automatycznie</string>
    <string name="shiba_link_matching">Dopasowywanie…</string>
    <string name="shiba_link_pick_game_folder">Wybierz folder gry</string>

    <string name="shiba_link_copy_title">Czy to legalna kopia ze Steam?</string>
    <string name="shiba_link_copy_body">Legalna kopia jest dopasowywana do konta Steam. Każda inna jest śledzona z folderu gry, który PFP poprosi wskazać.</string>

    <string name="shiba_link_folder_title">W którym folderze jest ta gra?</string>
    <string name="shiba_link_folder_body">Wybierz folder samej gry — ten, w którym jest jej plik .exe. PFP odczyta z niego Steam app id i będzie śledzić odblokowania zapisywane tam przez emulator. Gry Windows mogą być w dowolnym miejscu; PFP zapamięta, gdzie jest ta gra, więc nie będzie musiał jej szukać.</string>

    <string name="shiba_link_identify_title_steam">Wyszukiwanie dopasowania na Steam…</string>
    <string name="shiba_link_identify_title_appid">Ustalanie Steam app id…</string>
    <string name="shiba_link_identify_body_steam">Wyszukiwanie tytułu tej gry na Steam. Wybierz właściwy, aby połączyć ją ponownie.</string>
    <string name="shiba_link_identify_body_appid">Odczytywanie steam_appid.txt z folderu i dopasowywanie tytułu gry na Steam, jeśli pliku jeszcze nie ma.</string>

    <string name="shiba_link_kit_title">Ten folder nie ma jeszcze listy osiągnięć</string>
    <string name="shiba_link_kit_body_generic">Emulator potrzebuje listy osiągnięć, zanim zacznie zapisywać odblokowania.</string>
    <string name="shiba_link_kit_body">„%1$s” ma Steam app id %2$s, ale emulator nie ma listy osiągnięć, według której mógłby zapisywać. „Instaluj i połącz” zapisuje w folderze achievements.json, stats.json i configs.user.ini, tworzy folder saves i zmienia nazwę steam_api64.dll na steam_api64_o.dll, aby dołączony emulator ładował się przez niego — najpierw zrób kopię zapisów tej gry. „Tylko połącz” śledzi grę od 0%% i niczego więcej nie zapisuje.</string>
    <string name="shiba_link_kit_installer_off">„Instaluj i połącz” wymaga włączenia opcji „Instaluj Goldberg i konwertuj gry” w ustawieniach osiągnięć.</string>
    <string name="shiba_link_kit_install">Instaluj i połącz</string>
    <string name="shiba_link_kit_link_only">Tylko połącz</string>

    <string name="shiba_link_no_emu_title">Nie ma czego śledzić w tym folderze</string>
    <string name="shiba_link_no_emu_default">Ten folder nie zawiera danych emulatora Steam.</string>
    <string name="shiba_link_try_another_folder">Spróbuj innego folderu</string>

    <string name="shiba_link_appid_title">Nie znaleziono automatycznego dopasowania</string>
    <string name="shiba_link_appid_body">Wpisz Steam app id gry:</string>
    <string name="shiba_link_appid_field">Steam app id</string>

