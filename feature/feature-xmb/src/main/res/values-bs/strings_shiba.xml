    <!-- Auto-Match panel for a game that is not linked yet. -->
    <string name="shiba_link_not_linked_yet_game">Ova igra još nije povezana</string>
    <string name="shiba_link_not_linked_yet">Još nije povezano</string>
    <string name="shiba_link_steam_body">Automatsko povezivanje pita je li ovo legitimna Steam kopija, a zatim je povezuje sa Steamom ili u folderima vaših igara traži podatke Steam emulatora.</string>
    <string name="shiba_link_retro_body">RetroAchievements prepoznaje igre po hashu ROM-a. Automatsko povezivanje izračunava hash ovog ROM-a i traži ga — povezati se može samo provjereni dump registriran na RetroAchievements.</string>
    <string name="shiba_link_local_steam_body">Odaberite folder ove igre i PFP će pročitati njezin Steam app ID — iz datoteke steam_appid.txt ako postoji, a ako ne, poređenjem naslova. Folder se pamti pa ga ništa više ne mora tražiti.</string>
    <string name="shiba_link_vita_body">PS Vita trofeji povezuju se automatski iz Vita3K. Postavite folder podataka Vita3K u biblioteci i skenirajte kako biste povezali ovu igru.</string>
    <string name="shiba_link_ps3_body">PS3 trofeji povezuju se s vlastitog diska igre — postavite folder podataka PS3 u biblioteci i pokrenite Automatsko povezivanje.</string>
    <string name="shiba_link_x360_body">Xbox 360 dostignuća povezuju se prema ID-u naslova igre — postavite folder podataka X360 Mobile ili XenDroid u biblioteci i pokrenite Automatsko povezivanje.</string>
    <string name="shiba_link_auto_match">Automatsko povezivanje</string>
    <string name="shiba_link_matching">Povezivanje…</string>
    <string name="shiba_link_pick_game_folder">Odaberi folder igre</string>

    <string name="shiba_link_copy_title">Je li ovo legitimna Steam kopija?</string>
    <string name="shiba_link_copy_body">Legitimna kopija povezuje se s vašim Steam računom. Sve ostalo prati se iz vlastitog foldera igre, koji će vas PFP zamoliti da odaberete.</string>

    <string name="shiba_link_folder_title">U kojem je folderu ova igra?</string>
    <string name="shiba_link_folder_body">Odaberite vlastiti folder igre — onaj u kojem je njezina .exe datoteka. PFP iz njega čita Steam app ID i prati otključavanja koja emulator ondje zapisuje. Vaše Windows igre mogu biti bilo gdje; PFP pamti gdje je ova pa je nikad ne mora tražiti.</string>

    <string name="shiba_link_identify_title_steam">Traženje podudaranja na Steamu…</string>
    <string name="shiba_link_identify_title_appid">Utvrđivanje Steam app ID-a…</string>
    <string name="shiba_link_identify_body_steam">Traženje naslova ove igre na Steamu. Odaberite pravi kako biste je ponovo povezali.</string>
    <string name="shiba_link_identify_body_appid">Čitanje datoteke steam_appid.txt iz foldera i, ako je nema, poređenje naslova igre sa Steamom.</string>

    <string name="shiba_link_kit_title">Taj folder još nema spisak dostignuća</string>
    <string name="shiba_link_kit_body_generic">Emulatoru je potreban spisak dostignuća prije nego što može bilježiti otključavanja.</string>
    <string name="shiba_link_kit_body">\"%1$s\" ima Steam app ID %2$s, ali emulator nema spisak dostignuća prema kojem bi bilježio. Instaliraj i poveži zapisuje achievements.json, stats.json i configs.user.ini u folder, stvara folder saves te preimenuje steam_api64.dll u steam_api64_o.dll kako bi se priloženi emulator učitavao kroz nju — najprije napravite sigurnosnu kopiju sačuvanih podataka ove igre. Samo poveži prati je na 0%% i ništa više ne zapisuje.</string>
    <string name="shiba_link_kit_installer_off">Za Instaliraj i poveži potrebna je opcija Instaliraj Goldberg i pretvori igre u postavkama dostignuća.</string>
    <string name="shiba_link_kit_install">Instaliraj i poveži</string>
    <string name="shiba_link_kit_link_only">Samo poveži</string>

    <string name="shiba_link_no_emu_title">U tom folderu nema ničega za praćenje</string>
    <string name="shiba_link_no_emu_default">Taj folder ne sadrži podatke Steam emulatora.</string>
    <string name="shiba_link_try_another_folder">Pokušaj s drugim folderom</string>

    <string name="shiba_link_appid_title">Nije pronađeno automatsko podudaranje</string>
    <string name="shiba_link_appid_body">Unesite Steam app ID igre:</string>
    <string name="shiba_link_appid_field">Steam app ID</string>

