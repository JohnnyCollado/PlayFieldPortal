    <!-- Auto-Match panel -->
    <string name="shiba_link_not_linked_yet_game">Acest joc nu este încă legat</string>
    <string name="shiba_link_not_linked_yet">Încă nelegat</string>
    <string name="shiba_link_steam_body">Potrivirea automată întreabă dacă aceasta este o copie Steam legitimă, apoi o identifică pe Steam sau îți scanează dosarele de jocuri pentru date de emulator Steam.</string>
    <string name="shiba_link_retro_body">RetroAchievements identifică jocurile după hash-ul ROM. Potrivirea automată calculează hash-ul acestui ROM și îl caută — doar o copie verificată, înregistrată pe RetroAchievements, poate fi legată.</string>
    <string name="shiba_link_local_steam_body">Alege dosarul acestui joc, iar PFP îi citește ID-ul de aplicație Steam — din steam_appid.txt când există sau prin potrivirea titlului când nu există. Dosarul este memorat, așa că nu mai trebuie căutat din nou.</string>
    <string name="shiba_link_vita_body">Trofeele PS Vita se leagă automat din Vita3K. Setează dosarul de date Vita3K în bibliotecă și scanează pentru a lega acest joc.</string>
    <string name="shiba_link_ps3_body">Trofeele PS3 se leagă de pe discul jocului — setează dosarul de date PS3 în bibliotecă și folosește Potrivire automată.</string>
    <string name="shiba_link_x360_body">Realizările Xbox 360 se leagă prin ID-ul de titlu al jocului — setează dosarul de date X360 Mobile sau XenDroid în bibliotecă și folosește Potrivire automată.</string>
    <string name="shiba_link_auto_match">Potrivire automată</string>
    <string name="shiba_link_matching">Se potrivește…</string>
    <string name="shiba_link_pick_game_folder">Alege dosarul jocului</string>

    <string name="shiba_link_copy_title">Este aceasta o copie Steam legitimă?</string>
    <string name="shiba_link_copy_body">O copie legitimă se potrivește cu contul tău Steam. Orice altceva este urmărit din dosarul propriu al jocului, pe care PFP îți va cere să-l indici.</string>

    <string name="shiba_link_folder_title">În ce dosar se află acest joc?</string>
    <string name="shiba_link_folder_body">Alege dosarul propriu al jocului — cel în care se află fișierul .exe. PFP citește din el ID-ul de aplicație Steam și urmărește deblocările pe care emulatorul le scrie acolo. Jocurile Windows pot fi oriunde; PFP memorează unde se află acesta, așa că nu trebuie să-l caute niciodată.</string>

    <string name="shiba_link_identify_title_steam">Se caută potrivirea Steam…</string>
    <string name="shiba_link_identify_title_appid">Se determină ID-ul de aplicație Steam…</string>
    <string name="shiba_link_identify_body_steam">Se caută pe Steam titlul acestui joc. Alege-l pe cel corect pentru a-l lega din nou.</string>
    <string name="shiba_link_identify_body_appid">Se citește steam_appid.txt din dosar și se potrivește titlul jocului cu Steam dacă fișierul nu există încă.</string>

    <string name="shiba_link_kit_title">Acel dosar nu are încă o listă de realizări</string>
    <string name="shiba_link_kit_body_generic">Emulatorul are nevoie de o listă de realizări înainte de a putea înregistra deblocări.</string>
    <string name="shiba_link_kit_body">„%1$s” are ID-ul de aplicație Steam %2$s, dar emulatorul nu are o listă de realizări față de care să înregistreze. Instalează și leagă scrie achievements.json, stats.json și configs.user.ini în dosar, creează un dosar saves și redenumește steam_api64.dll în steam_api64_o.dll, astfel încât emulatorul inclus să se încarce prin el — fă mai întâi backup la salvările acestui joc. Doar leagă îl urmărește la 0%% și nu mai scrie nimic.</string>
    <string name="shiba_link_kit_installer_off">Instalează și leagă necesită Instalează Goldberg și convertește jocurile în setările Realizări.</string>
    <string name="shiba_link_kit_install">Instalează și leagă</string>
    <string name="shiba_link_kit_link_only">Doar leagă</string>

    <string name="shiba_link_no_emu_title">Nimic de urmărit în acel dosar</string>
    <string name="shiba_link_no_emu_default">Acel dosar nu conține date de emulator Steam.</string>
    <string name="shiba_link_try_another_folder">Încearcă alt dosar</string>

    <string name="shiba_link_appid_title">Nu s-a găsit nicio potrivire automată</string>
    <string name="shiba_link_appid_body">Introdu ID-ul de aplicație Steam al jocului:</string>
    <string name="shiba_link_appid_field">ID aplicație Steam</string>

