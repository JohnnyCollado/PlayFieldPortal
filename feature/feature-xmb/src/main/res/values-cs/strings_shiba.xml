    <!-- Auto-Match panel -->
    <string name="shiba_link_not_linked_yet_game">Tato hra zatím není propojena</string>
    <string name="shiba_link_not_linked_yet">Zatím nepropojeno</string>
    <string name="shiba_link_steam_body">Automatické přiřazení se zeptá, zda jde o legitimní kopii ze Steamu, a poté ji přiřadí přes Steam nebo prohledá složky her kvůli datům emulace Steamu.</string>
    <string name="shiba_link_retro_body">RetroAchievements rozpoznává hry podle hashe ROM. Automatické přiřazení vypočítá hash této ROM a vyhledá jej — propojit lze jen ověřený dump registrovaný na RetroAchievements.</string>
    <string name="shiba_link_local_steam_body">Vyberte složku této hry a PFP přečte její Steam app id — ze souboru steam_appid.txt, pokud existuje, jinak podle názvu. Složku si zapamatuje, takže ji už nebude nutné hledat.</string>
    <string name="shiba_link_vita_body">Trofeje PS Vita se propojují automaticky z Vita3K. Nastavte v knihovně datovou složku Vita3K a prohledáním hru propojte.</string>
    <string name="shiba_link_ps3_body">Trofeje PS3 se propojují z vlastního disku hry — nastavte v knihovně datovou složku PS3 a použijte Automatické přiřazení.</string>
    <string name="shiba_link_x360_body">Achievementy Xbox 360 se propojují podle title ID hry — nastavte v knihovně datovou složku X360 Mobile nebo XenDroid a použijte Automatické přiřazení.</string>
    <string name="shiba_link_auto_match">Automaticky přiřadit</string>
    <string name="shiba_link_matching">Přiřazování…</string>
    <string name="shiba_link_pick_game_folder">Vybrat složku hry</string>

    <string name="shiba_link_copy_title">Je to legitimní kopie ze Steamu?</string>
    <string name="shiba_link_copy_body">Legitimní kopie se přiřadí k vašemu účtu Steam. Cokoli jiného se sleduje z vlastní složky hry, na kterou vás PFP požádá ukázat.</string>

    <string name="shiba_link_folder_title">Ve které složce je tato hra?</string>
    <string name="shiba_link_folder_body">Vyberte vlastní složku hry — tu, ve které je její .exe. PFP z ní přečte Steam app id a sleduje odemčení, která tam emulátor zapisuje. Vaše hry pro Windows mohou být kdekoli; PFP si pamatuje, kde je tato, takže ji nikdy nemusí hledat.</string>

    <string name="shiba_link_identify_title_steam">Hledání shody na Steamu…</string>
    <string name="shiba_link_identify_title_appid">Zjišťování Steam app id…</string>
    <string name="shiba_link_identify_body_steam">Hledání názvu této hry na Steamu. Vyberte správnou hru a znovu ji propojte.</string>
    <string name="shiba_link_identify_body_appid">Čtení steam_appid.txt ze složky a porovnání názvu hry se Steamem, pokud zatím žádný nemá.</string>

    <string name="shiba_link_kit_title">Tato složka zatím nemá seznam achievementů</string>
    <string name="shiba_link_kit_body_generic">Emulátor potřebuje seznam achievementů, aby mohl zaznamenávat odemčení.</string>
    <string name="shiba_link_kit_body">„%1$s“ má Steam app id %2$s, ale emulátor nemá seznam achievementů, podle kterého by zaznamenával. Instalovat a propojit zapíše do složky achievements.json, stats.json a configs.user.ini, vytvoří složku saves a přejmenuje steam_api64.dll na steam_api64_o.dll, aby se přes ni načítal přiložený emulátor — nejprve zálohujte uložené pozice této hry. Jen propojit ji sleduje na 0%% a nic dalšího nezapíše.</string>
    <string name="shiba_link_kit_installer_off">Instalovat a propojit vyžaduje zapnutou volbu Instalovat Goldberg a převést hry v nastavení achievementů.</string>
    <string name="shiba_link_kit_install">Instalovat a propojit</string>
    <string name="shiba_link_kit_link_only">Jen propojit</string>

    <string name="shiba_link_no_emu_title">V této složce není co sledovat</string>
    <string name="shiba_link_no_emu_default">Tato složka neobsahuje žádná data emulátoru Steamu.</string>
    <string name="shiba_link_try_another_folder">Zkusit jinou složku</string>

    <string name="shiba_link_appid_title">Nebyla nalezena automatická shoda</string>
