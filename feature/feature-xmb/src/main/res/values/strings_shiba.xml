    <!-- Auto-Match panel for a game that is not linked yet. -->
    <string name="shiba_link_not_linked_yet_game">This game isn\'t linked yet</string>
    <string name="shiba_link_not_linked_yet">Not linked yet</string>
    <string name="shiba_link_steam_body">Auto-Match asks whether this is a legitimate Steam copy, then resolves it against Steam or scans your game folders for Steam-emu data.</string>
    <string name="shiba_link_retro_body">RetroAchievements identifies games by ROM hash. Auto-Match hashes this ROM and looks it up — only a verified dump registered on RetroAchievements can link.</string>
    <string name="shiba_link_local_steam_body">Pick this game\'s folder and PFP reads its Steam app id — from steam_appid.txt when it is there, or by matching the title when it is not. It remembers the folder, so nothing has to search for it again.</string>
    <string name="shiba_link_vita_body">PS Vita trophies link automatically from Vita3K. Set your Vita3K data folder in the library and scan to link this game.</string>
    <string name="shiba_link_ps3_body">PS3 trophies link from the game\'s own disc — set your PS3 Data Folder in the library and Auto-Match.</string>
    <string name="shiba_link_x360_body">Xbox 360 achievements link from the game\'s own title ID — set the X360 Mobile or XenDroid Data Folder in the library and Auto-Match.</string>
    <!-- Buttons of the panel. Auto-Match = link the game automatically. -->
    <string name="shiba_link_auto_match">Auto-Match</string>
    <string name="shiba_link_matching">Matching…</string>
    <string name="shiba_link_pick_game_folder">Pick Game Folder</string>

    <string name="shiba_link_copy_title">Is this a legitimate Steam copy?</string>
    <string name="shiba_link_copy_body">A legit copy matches against your Steam account. Anything else is tracked from the game\'s own folder, which PFP will ask you to point at.</string>

    <string name="shiba_link_folder_title">Which folder is this game in?</string>
    <string name="shiba_link_folder_body">Pick the game\'s own folder — the one its .exe is in. PFP reads the Steam app id from it and tracks the unlocks the emulator writes there. Your Windows games can live anywhere; PFP remembers where this one is so it never has to search.</string>

    <string name="shiba_link_identify_title_steam">Finding the Steam match…</string>
    <string name="shiba_link_identify_title_appid">Working out the Steam app id…</string>
    <string name="shiba_link_identify_body_steam">Searching Steam for this game\'s title. Pick the right one to link it again.</string>
    <string name="shiba_link_identify_body_appid">Reading steam_appid.txt from the folder, and matching the game\'s title against Steam if it has none yet.</string>

    <string name="shiba_link_kit_title">That folder has no achievement list yet</string>
    <string name="shiba_link_kit_body_generic">The emulator needs an achievement list before it can record unlocks.</string>
    <!-- %1$s is the name of the game folder, %2$s its Steam app id. "Install &amp; Link" and "Link Only" are the names of the two buttons. -->
    <string name="shiba_link_kit_body">\"%1$s\" is Steam app id %2$s, but the emulator has no achievement list to record against. Install &amp; Link writes achievements.json, stats.json and configs.user.ini into the folder, creates a saves folder, and renames steam_api64.dll to steam_api64_o.dll so the bundled emulator loads through it — back up this game\'s saves first. Link Only tracks it at 0%% and writes nothing more.</string>
    <string name="shiba_link_kit_installer_off">Install &amp; Link needs Install Goldberg &amp; Convert Games in Achievement settings.</string>
    <string name="shiba_link_kit_install">Install &amp; Link</string>
    <string name="shiba_link_kit_link_only">Link Only</string>

    <string name="shiba_link_no_emu_title">Nothing to track in that folder</string>
    <string name="shiba_link_no_emu_default">That folder holds no Steam-emulator data.</string>
    <string name="shiba_link_try_another_folder">Try Another Folder</string>

